[Unit]
Description=Daily Pigglet database backup
Documentation=https://pigglet.ca

[Timer]
# 03:00 UTC daily. Persistent=true runs a missed backup on next boot if the
# box was off at the scheduled time. The random delay avoids hammering the DB
# and S3 at an exact round hour.
OnCalendar=*-*-* 03:00:00 UTC
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
