package views

import (
	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
)

// BillingData is the billing page view model, derived from the user's current
// Stripe subscription (a synced projection in the store).
type BillingData struct {
	Configured        bool   // billing is set up in this environment
	Collapsed         bool
	Standalone        bool   // render the sidebar-less paywall (locked-out states)
	State             string // "none" | "trialing" | "active" | "past_due" | "ended"
	TrialDaysLeft     int
	TrialEnd          string // formatted date, "" when not trialing
	RenewalDate       string // formatted date, "" when not active
	CancelAtPeriodEnd bool
}

// BillingPage is now only the locked-out paywall. A user who still has access
// manages their plan in Settings -> Billing (BillingSection); /billing redirects
// them there, so there is one place to look rather than two views of the same
// subscription.
templ BillingPage(d BillingData) {
	@billingStandalone(d)
}

// BillingSection is the subscription state as it appears in the Settings page's
// Billing tab.
templ BillingSection(d BillingData) {
	<div class="space-y-6">
		if !d.Configured {
			<div class="rounded-xl border bg-card p-6 text-sm text-muted-foreground">
				{ i18n.T(ctx, "billing.not_configured") }
			</div>
		} else if d.State == "exempt" {
			@billingExemptCard()
		} else {
			@billingCard(d)
		}
	</div>
}

// billingStandalone is the sidebar-less paywall a locked-out user sees (never
// subscribed, or trial ended). It reuses the auth pages' centered-card shell so
// it matches sign in / sign up, and offers a log-out escape.
templ billingStandalone(d BillingData) {
	if d.State == "ended" {
		@authLayout(i18n.T(ctx, "billing.trial_ended_title")) {
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "billing.subscribe_pitch") }</p>
			<div class="mt-6">
				<form method="post" action="/billing/checkout">
					@authButton(i18n.T(ctx, "billing.subscribe"))
				</form>
			</div>
			@billingLogoutFooter()
		}
	} else {
		@authLayout(i18n.T(ctx, "billing.start_trial_title")) {
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "billing.trial_pitch") }</p>
			<div class="mt-6">
				<form method="post" action="/billing/checkout">
					@authButton(i18n.T(ctx, "billing.start_trial"))
				</form>
			</div>
			@billingLogoutFooter()
		}
	}
}

// billingLogoutFooter is the escape hatch on the standalone paywall: a plain
// form POST to /logout (the standalone shell doesn't load htmx).
templ billingLogoutFooter() {
	<form method="post" action="/logout" class="mt-6 text-center">
		<button type="submit" class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground">{ i18n.T(ctx, "menu.log_out") }</button>
	</form>
}

// billingCard renders the status + the one call-to-action appropriate to the
// subscription state.
templ billingCard(d BillingData) {
	<section class="overflow-hidden rounded-xl border bg-card">
		<div class="space-y-4 p-6">
			<div class="flex items-start justify-between gap-4">
				<div class="space-y-1">
					<h2 class="text-sm font-semibold">Pigglet</h2>
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "billing.price_line") }</p>
				</div>
				@billingStatusBadge(d.State)
			</div>
			@billingStatusLine(d)
		</div>
		<div class="flex items-center gap-3 border-t bg-muted/30 px-6 py-4">
			@billingActions(d)
		</div>
	</section>
}

// billingExemptCard is shown for complimentary (billing_exempt) accounts: full
// access, no subscription, no call to action.
templ billingExemptCard() {
	<section class="overflow-hidden rounded-xl border bg-card p-6">
		<div class="flex items-start gap-3">
			@icon.BadgeCheck(icon.Props{Class: "size-5 shrink-0 text-primary"})
			<div class="space-y-1">
				<h2 class="text-sm font-semibold">{ i18n.T(ctx, "billing.comp_title") }</h2>
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "billing.comp_body") }</p>
			</div>
		</div>
	</section>
}

// billingStatusLine is the human sentence describing where the user stands.
// Each state is one whole sentence in the catalog, with the date (when there is
// one) interpolated into it. The English original built these by concatenation —
// "…set to cancel" + " on <date>" + ". You'll keep access until then." — which
// pins English clause order onto every translation and gives a translator three
// fragments none of which is a sentence. The trial line also lost its inner
// <span class="font-medium"> around the day count for the same reason: keeping
// it would mean either splitting the sentence again or letting catalog text
// carry markup.
templ billingStatusLine(d BillingData) {
	switch d.State {
		case "trialing":
			<p class="text-sm">
				if d.TrialEnd != "" {
					{ i18n.Tnf(ctx, "billing.trial_active_until", d.TrialDaysLeft, i18n.M{"Days": d.TrialDaysLeft, "Date": d.TrialEnd}) }
				} else {
					{ i18n.Tn(ctx, "billing.trial_active", d.TrialDaysLeft) }
				}
			</p>
		case "active":
			if d.CancelAtPeriodEnd && d.RenewalDate != "" {
				<p class="text-sm">{ i18n.Tf(ctx, "billing.cancelling_on", i18n.M{"Date": d.RenewalDate}) }</p>
			} else if d.CancelAtPeriodEnd {
				<p class="text-sm">{ i18n.T(ctx, "billing.cancelling") }</p>
			} else if d.RenewalDate != "" {
				<p class="text-sm">{ i18n.Tf(ctx, "billing.subscribed_renews", i18n.M{"Date": d.RenewalDate}) }</p>
			} else {
				<p class="text-sm">{ i18n.T(ctx, "billing.subscribed") }</p>
			}
		case "past_due":
			<p class="text-sm text-destructive">{ i18n.T(ctx, "billing.past_due") }</p>
		case "ended":
			<p class="text-sm">{ i18n.T(ctx, "billing.ended") }</p>
		default:
			<p class="text-sm">{ i18n.Tf(ctx, "billing.not_started", i18n.M{"Days": 35}) }</p>
	}
}

// billingActions renders the primary action button(s) for the state. Plain form
// POSTs (full navigation) so the redirect to Stripe works without JS.
templ billingActions(d BillingData) {
	switch d.State {
		case "none":
			<form method="post" action="/billing/checkout">
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ i18n.T(ctx, "billing.start_trial") }
				}
			</form>
		case "ended":
			<form method="post" action="/billing/checkout">
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ i18n.T(ctx, "billing.subscribe") }
				}
			</form>
			@manageButton(i18n.T(ctx, "billing.view_history"))
		default:
			// trialing / active / past_due — manage via the Stripe portal.
			<form method="post" action="/billing/portal">
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ i18n.T(ctx, "billing.manage") }
				}
			</form>
	}
}

// manageButton is a secondary link to the Stripe Customer Portal.
templ manageButton(label string) {
	<form method="post" action="/billing/portal">
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
			{ label }
		}
	</form>
}

// billingStatusBadge is a small colored pill for the subscription state.
templ billingStatusBadge(state string) {
	switch state {
		case "trialing":
			@billingBadge(i18n.T(ctx, "billing.badge_trial"), "border-primary/40 text-primary", icon.Clock(icon.Props{Class: "size-3"}))
		case "active":
			@billingBadge(i18n.T(ctx, "billing.badge_active"), "border-primary/40 text-primary", icon.Check(icon.Props{Class: "size-3"}))
		case "past_due":
			@billingBadge(i18n.T(ctx, "billing.badge_past_due"), "border-destructive/40 text-destructive", icon.TriangleAlert(icon.Props{Class: "size-3"}))
		case "ended":
			@billingBadge(i18n.T(ctx, "billing.badge_ended"), "border-border text-muted-foreground", icon.CircleX(icon.Props{Class: "size-3"}))
		default:
			@billingBadge(i18n.T(ctx, "billing.badge_not_started"), "border-border text-muted-foreground", icon.Circle(icon.Props{Class: "size-3"}))
	}
}

templ billingBadge(label, classes string, ic templ.Component) {
	<span class={ "inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium " + classes }>
		@ic
		{ label }
	</span>
}
