package views

import (
	"strings"
	"time"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/i18n"
)

// contactEmail is the address every legal page points at. Not translated — an
// address is an address.
const contactEmail = "contact@plainlysoftware.com"

// legalUpdated is the "last updated" date shown on the legal pages. Bump it when
// the copy materially changes. Stored as a date rather than a formatted string
// so it renders in the reader's language.
var legalUpdated = time.Date(2026, 7, 23, 0, 0, 0, 0, time.UTC)

// legalShell wraps a legal/informational page in the marketing chrome with a
// centered prose column. path is the page's canonical (English) path, which the
// layout needs for its hreflang alternates and the language switch. showUpdated
// renders the "last updated" line.
templ legalShell(titleKey, path string, showUpdated bool) {
	@marketingLayout(i18n.T(ctx, titleKey), path) {
		<article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
			<div class="space-y-2">
				<h1 class="font-heading text-4xl font-semibold tracking-tight">{ i18n.T(ctx, titleKey) }</h1>
				if showUpdated {
					<p class="text-sm text-muted-foreground">
						{ i18n.Tf(ctx, "legal.last_updated", i18n.M{"Date": format.DateLong(ctx, legalUpdated)}) }
					</p>
				}
			</div>
			<div class="mt-10 space-y-8 leading-relaxed text-muted-foreground">
				{ children... }
			</div>
		</article>
	}
}

// legalSection is one titled block within a legal page.
templ legalSection(headingKey string) {
	<section class="space-y-3">
		<h2 class="text-xl font-semibold text-foreground">{ i18n.T(ctx, headingKey) }</h2>
		{ children... }
	</section>
}

// legalP renders a translated paragraph.
templ legalP(key string) {
	<p>{ i18n.T(ctx, key) }</p>
}

// legalPLink renders a translated paragraph that contains one link, without
// splitting the sentence into fragments in the catalog and without letting
// catalog text carry markup.
//
// The message stays one whole sentence; the anchor is spliced in around the
// link text at render. A translation that words the link differently simply
// puts the link at the end instead of mid-sentence — degraded, never broken.
templ legalPLink(key, linkText, href string) {
	{{ before, after := splitAround(i18n.T(ctx, key), linkText) }}
	// All on one line: templ emits the whitespace between sibling nodes, so
	// splitting this across lines puts a space before the sentence's closing
	// period.
	<p>{ before }<a href={ templ.SafeURL(href) } class="font-medium text-foreground underline underline-offset-4">{ linkText }</a>{ after }</p>
}

// splitAround splits s around the first occurrence of mid. When mid is absent
// the whole string comes back as the leading part, so the caller renders the
// link after the text rather than losing it.
func splitAround(s, mid string) (before, after string) {
	i := strings.Index(s, mid)
	if i < 0 {
		return s, ""
	}
	return s[:i], s[i+len(mid):]
}

// legalBullets renders a list whose items are consecutive catalog keys. Each
// item is one whole sentence; the lead-in term is emphasised by the template,
// not by markup in the catalog.
templ legalBullets(keys ...string) {
	<ul class="list-disc space-y-2 pl-5">
		for _, k := range keys {
			<li>{ i18n.T(ctx, k) }</li>
		}
	</ul>
}

// ── Contact ─────────────────────────────────────────────────────────────────────

templ ContactPage() {
	@legalShell("legal.contact_title", "/contact", false) {
		@legalP("legal.contact_intro")
		@legalSection("legal.contact_email_heading") {
			@legalPLink("legal.contact_email_body", contactEmail, "mailto:"+contactEmail)
		}
		@legalSection("legal.contact_who_heading") {
			@legalP("legal.contact_who_body")
		}
	}
}

// ── Privacy Policy ──────────────────────────────────────────────────────────────

templ PrivacyPage() {
	@legalShell("legal.privacy_title", "/privacy", true) {
		@legalP("legal.privacy_intro")
		@legalSection("legal.privacy_collect_heading") {
			@legalBullets(
				"legal.privacy_collect_account",
				"legal.privacy_collect_budget",
				"legal.privacy_collect_payment",
				"legal.privacy_collect_technical",
			)
		}
		@legalSection("legal.privacy_dont_heading") {
			@legalBullets(
				"legal.privacy_dont_sell",
				"legal.privacy_dont_share",
				"legal.privacy_dont_ask",
			)
		}
		@legalSection("legal.privacy_cookies_heading") {
			@legalP("legal.privacy_cookies_body")
		}
		@legalSection("legal.privacy_providers_heading") {
			@legalP("legal.privacy_providers_body")
		}
		@legalSection("legal.privacy_retention_heading") {
			@legalPLink("legal.privacy_retention_body", contactEmail, "mailto:"+contactEmail)
		}
		@legalSection("legal.privacy_security_heading") {
			@legalP("legal.privacy_security_body")
		}
		@legalSection("legal.privacy_rights_heading") {
			@legalPLink("legal.privacy_rights_body", contactEmail, "mailto:"+contactEmail)
		}
		@legalSection("legal.privacy_children_heading") {
			@legalP("legal.privacy_children_body")
		}
		@legalSection("legal.privacy_changes_heading") {
			@legalPLink("legal.privacy_changes_body", contactEmail, "mailto:"+contactEmail)
		}
	}
}

// ── Refund Policy ───────────────────────────────────────────────────────────────

templ RefundPage() {
	@legalShell("legal.refund_title", "/refund", true) {
		@legalP("legal.refund_intro")
		@legalSection("legal.refund_trial_heading") {
			@legalP("legal.refund_trial_body")
		}
		@legalSection("legal.refund_billing_heading") {
			@legalP("legal.refund_billing_body")
		}
		@legalSection("legal.refund_none_heading") {
			@legalP("legal.refund_none_body")
		}
		@legalSection("legal.refund_cancel_heading") {
			@legalP("legal.refund_cancel_body")
		}
		@legalSection("legal.refund_exceptions_heading") {
			@legalPLink("legal.refund_exceptions_body", contactEmail, "mailto:"+contactEmail)
		}
	}
}

// ── Terms & Conditions ──────────────────────────────────────────────────────────

templ TermsPage() {
	@legalShell("legal.terms_title", "/terms", true) {
		@legalP("legal.terms_intro")
		@legalSection("legal.terms_service_heading") {
			@legalP("legal.terms_service_body")
		}
		@legalSection("legal.terms_account_heading") {
			@legalP("legal.terms_account_body")
		}
		@legalSection("legal.terms_billing_heading") {
			@legalPLink("legal.terms_billing_body", i18n.T(ctx, "legal.refund_title"), publicHref(ctx, "/refund"))
		}
		@legalSection("legal.terms_use_heading") {
			@legalP("legal.terms_use_body")
		}
		@legalSection("legal.terms_data_heading") {
			@legalPLink("legal.terms_data_body", i18n.T(ctx, "legal.privacy_title"), publicHref(ctx, "/privacy"))
		}
		@legalSection("legal.terms_advice_heading") {
			@legalP("legal.terms_advice_body")
		}
		@legalSection("legal.terms_liability_heading") {
			@legalP("legal.terms_liability_body")
		}
		@legalSection("legal.terms_termination_heading") {
			@legalP("legal.terms_termination_body")
		}
		@legalSection("legal.terms_law_heading") {
			@legalP("legal.terms_law_body")
		}
		@legalSection("legal.terms_changes_heading") {
			@legalPLink("legal.terms_changes_body", contactEmail, "mailto:"+contactEmail)
		}
	}
}
