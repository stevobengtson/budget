package views

import (
	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/templui/templui/components/icon"
)

// marketingLayout is the standalone shell for the public marketing + legal
// pages (no app sidebar, no HTMX). It mirrors authLayout's head — the theme
// bootstrap script, compiled Tailwind, favicon — and wraps the page in a shared
// header and footer. title is both the document title and drives nothing else.
templ marketingLayout(title, path string) {
	<!DOCTYPE html>
	<html lang={ string(i18n.LocaleFrom(ctx)) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Pigglet</title>
			// Each language declares the other so a crawler indexes both rather than
			// treating one as a duplicate. x-default points at English, which is what
			// the bare path serves.
			for _, l := range i18n.Supported {
				<link rel="alternate" hreflang={ string(l) } href={ PublicHref(l, path) }/>
			}
			<link rel="alternate" hreflang="x-default" href={ PublicHref(i18n.Default, path) }/>
			<link rel="canonical" href={ publicHref(ctx, path) }/>
			<script>
				(function () {
					var t = localStorage.getItem("theme") || "system";
					if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
						document.documentElement.classList.add("dark");
					}
				})();
			</script>
			<link rel="stylesheet" href={ Asset("/static/app.css") }/>
			<link rel="icon" type="image/svg+xml" href={ Asset("/static/favicon.svg") }/>
		</head>
		<body class="min-h-screen bg-background text-foreground antialiased">
			@marketingHeader(path)
			<main>
				{ children... }
			</main>
			@marketingFooter(path)
			@cookieNotice()
		</body>
	</html>
}

// marketingHeader is the sticky top bar: wordmark on the left, in-page nav and
// the sign-in / start-trial actions on the right.
templ marketingHeader(path string) {
	<header class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur">
		<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
			<a href={ templ.SafeURL(publicHref(ctx, "/")) } class="flex items-center gap-2">
				@icon.PiggyBank(icon.Props{Class: "size-6 text-primary"})
				<span class="font-heading text-xl font-semibold tracking-tight">Pigglet</span>
			</a>
			<nav class="hidden items-center gap-8 text-sm text-muted-foreground md:flex">
				<a href={ templ.SafeURL(publicHref(ctx, "/") + "#features") } class="transition-colors hover:text-foreground">{ i18n.T(ctx, "marketing.nav_features") }</a>
				<a href={ templ.SafeURL(publicHref(ctx, "/") + "#privacy") } class="transition-colors hover:text-foreground">{ i18n.T(ctx, "marketing.nav_privacy") }</a>
				<a href={ templ.SafeURL(publicHref(ctx, "/") + "#pricing") } class="transition-colors hover:text-foreground">{ i18n.T(ctx, "marketing.nav_pricing") }</a>
			</nav>
			<div class="flex items-center gap-2 sm:gap-3">
				@languageSwitch(path)
				<a href="/login" class="hidden h-9 items-center rounded-pill px-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline-flex">{ i18n.T(ctx, "auth.sign_in") }</a>
				<a href="/signup" class="inline-flex h-9 items-center justify-center rounded-pill bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover">{ i18n.T(ctx, "marketing.start_trial") }</a>
			</div>
		</div>
	</header>
}

// languageSwitch links to this same page in the other language. A link, not a
// cookie toggle: the whole point of /fr is that the address is what decides the
// language, so switching has to change the address the visitor can then share
// or bookmark.
//
// Each language is named in itself, never in the one on screen — someone who
// cannot read the current page still has to find their own.
templ languageSwitch(path string) {
	for _, l := range i18n.Supported {
		if l != i18n.LocaleFrom(ctx) {
			<a
				href={ templ.SafeURL(PublicHref(l, path)) }
				hreflang={ string(l) }
				lang={ string(l) }
				class="inline-flex h-9 items-center rounded-pill px-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
			>
				{ l.ShortName() }
			</a>
		}
	}
}

// marketingFooter carries the legal-page links and the operating-company notice.
// The legal routes (/privacy, /terms, /refund, /contact) are added in a later pass.
templ marketingFooter(path string) {
	<footer class="border-t border-border/60">
		<div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between">
			<div class="flex items-center gap-2">
				@icon.PiggyBank(icon.Props{Class: "size-5 text-primary"})
				<span class="font-heading text-lg font-semibold tracking-tight">Pigglet</span>
			</div>
			<nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
				<a href={ templ.SafeURL(publicHref(ctx, "/privacy")) } class="transition-colors hover:text-foreground">{ i18n.T(ctx, "legal.privacy_title") }</a>
				<a href={ templ.SafeURL(publicHref(ctx, "/terms")) } class="transition-colors hover:text-foreground">{ i18n.T(ctx, "legal.terms_title") }</a>
				<a href={ templ.SafeURL(publicHref(ctx, "/refund")) } class="transition-colors hover:text-foreground">{ i18n.T(ctx, "legal.refund_title") }</a>
				<a href={ templ.SafeURL(publicHref(ctx, "/contact")) } class="transition-colors hover:text-foreground">{ i18n.T(ctx, "legal.contact_title") }</a>
			</nav>
		</div>
		<div class="border-t border-border/60">
			<p class="mx-auto max-w-6xl px-4 py-6 text-xs text-muted-foreground sm:px-6">
				© 2026 Plainly Software. Pigglet is operated by Plainly Software. Built in Canada 🇨🇦
			</p>
		</div>
	</footer>
}

// ── page ──────────────────────────────────────────────────────────────────────

// LandingPage is the public home page shown to logged-out visitors (a valid
// session is redirected to /budget by the Home handler).
templ LandingPage() {
	@marketingLayout(i18n.T(ctx, "marketing.title"), "/") {
		@heroSection()
		@featuresSection()
		@addOnsSection()
		@privacySection()
		@pricingSection()
		@finalCTASection()
	}
}

templ heroSection() {
	<section class="relative overflow-hidden">
		<div class="mx-auto max-w-6xl px-4 pt-16 pb-12 text-center sm:px-6 sm:pt-24">
			<span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">
				@icon.MapPin(icon.Props{Class: "size-3.5 text-primary"})
				{ i18n.T(ctx, "marketing.badge") }
			</span>
			<h1 class="mx-auto mt-6 max-w-3xl font-heading text-4xl font-semibold tracking-tight sm:text-6xl">
				{ i18n.T(ctx, "marketing.hero_heading") }
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
				{ i18n.T(ctx, "marketing.hero_body") }
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a href="/signup" class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-pill bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover sm:w-auto">
					{ i18n.T(ctx, "marketing.cta_trial") }
					@icon.ArrowRight(icon.Props{Class: "size-4"})
				</a>
				<a href="/login" class="inline-flex h-11 w-full items-center justify-center rounded-pill border border-input bg-background px-6 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground sm:w-auto">
					{ i18n.T(ctx, "auth.sign_in") }
				</a>
			</div>
			<p class="mt-4 text-sm text-muted-foreground">
				{ i18n.T(ctx, "marketing.no_payment_info") }
			</p>
			<div class="mx-auto mt-14 max-w-5xl">
				@browserFrame(marketingShot(ctx, "budget"), i18n.T(ctx, "marketing.shot_budget_alt"))
			</div>
		</div>
	</section>
}

templ featuresSection() {
	<section id="features" class="border-t border-border/60 bg-muted/20">
		<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{ i18n.T(ctx, "marketing.features_heading") }</h2>
				<p class="mt-4 text-muted-foreground">
					{ i18n.T(ctx, "marketing.features_body") }
				</p>
			</div>
			<div class="mt-14 grid gap-6 sm:grid-cols-3">
				@featureCard(icon.Wallet(icon.Props{Class: "size-5"}), i18n.T(ctx, "marketing.feature_dollar_title"), i18n.T(ctx, "marketing.feature_dollar_body"))
				@featureCard(icon.Zap(icon.Props{Class: "size-5"}), i18n.T(ctx, "marketing.feature_fast_title"), i18n.T(ctx, "marketing.feature_fast_body"))
				@featureCard(icon.Target(icon.Props{Class: "size-5"}), i18n.T(ctx, "marketing.feature_goals_title"), i18n.T(ctx, "marketing.feature_goals_body"))
			</div>
			<div class="mx-auto mt-12 max-w-4xl">
				@browserFrame(marketingShot(ctx, "transactions"), i18n.T(ctx, "marketing.shot_tx_alt"))
			</div>
		</div>
	</section>
}

templ addOnsSection() {
	<section class="border-t border-border/60">
		<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2">
			<div>
				<span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">
					@icon.Blocks(icon.Props{Class: "size-3.5 text-primary"})
					{ i18n.T(ctx, "settings.tab_addons") }
				</span>
				<h2 class="mt-5 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
					{ i18n.T(ctx, "marketing.addons_heading") }
				</h2>
				<p class="mt-4 text-muted-foreground">
					{ i18n.T(ctx, "marketing.addons_body") }
				</p>
				<ul class="mt-6 space-y-3 text-sm">
					@addOnPoint(i18n.T(ctx, "marketing.addons_point_optin"))
					@addOnPoint(i18n.T(ctx, "marketing.addons_point_price"))
					@addOnPoint(i18n.T(ctx, "marketing.addons_point_toggle"))
				</ul>
			</div>
			<div>
				@browserFrame(marketingShot(ctx, "paydown"), i18n.T(ctx, "marketing.shot_paydown_alt"))
			</div>
		</div>
	</section>
}

templ privacySection() {
	<section id="privacy" class="border-t border-border/60 bg-muted/20">
		<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{ i18n.T(ctx, "marketing.privacy_heading") }</h2>
				<p class="mt-4 text-muted-foreground">
					{ i18n.T(ctx, "marketing.privacy_body") }
				</p>
			</div>
			<div class="mt-14 grid gap-6 sm:grid-cols-3">
				@trustItem(icon.ShieldCheck(icon.Props{Class: "size-5"}), i18n.T(ctx, "marketing.trust_minimal_title"), i18n.T(ctx, "marketing.trust_minimal_body"))
				@trustItem(icon.EyeOff(icon.Props{Class: "size-5"}), i18n.T(ctx, "marketing.trust_never_sold_title"), i18n.T(ctx, "marketing.trust_never_sold_body"))
				@trustItem(icon.Lock(icon.Props{Class: "size-5"}), i18n.T(ctx, "marketing.trust_safe_title"), i18n.T(ctx, "marketing.trust_safe_body"))
			</div>
		</div>
	</section>
}

templ pricingSection() {
	<section id="pricing" class="border-t border-border/60">
		<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{ i18n.T(ctx, "marketing.pricing_heading") }</h2>
				<p class="mt-4 text-muted-foreground">
					{ i18n.T(ctx, "marketing.pricing_body") }
				</p>
			</div>
			<div class="mx-auto mt-12 max-w-md">
				<div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
					<div class="border-b border-border p-8 text-center">
						<p class="text-sm font-medium text-muted-foreground">Pigglet</p>
						<p class="mt-3 font-heading text-5xl font-semibold tracking-tight">
							$4.99 <span class="text-lg font-normal text-muted-foreground">{ i18n.T(ctx, "marketing.pricing_period") }</span>
						</p>
						<p class="mt-3 inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
							@icon.Sparkles(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "marketing.pricing_trial_badge") }
						</p>
					</div>
					<div class="space-y-3 p-8">
						@pricingPoint(i18n.T(ctx, "marketing.pricing_point_core"))
						@pricingPoint(i18n.T(ctx, "marketing.pricing_point_free"))
						@pricingPoint(i18n.T(ctx, "marketing.pricing_point_nocard"))
						@pricingPoint(i18n.T(ctx, "marketing.pricing_point_addons"))
						@pricingPoint(i18n.T(ctx, "marketing.pricing_point_cancel"))
						<a href="/signup" class="mt-4 inline-flex h-11 w-full items-center justify-center gap-2 rounded-pill bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover">
							{ i18n.T(ctx, "billing.start_trial") }
							@icon.ArrowRight(icon.Props{Class: "size-4"})
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ finalCTASection() {
	<section class="border-t border-border/60 bg-muted/20">
		<div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6">
			<h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
				{ i18n.T(ctx, "marketing.final_heading") }
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-muted-foreground">
				{ i18n.T(ctx, "marketing.final_body") }
			</p>
			<div class="mt-8">
				<a href="/signup" class="inline-flex h-11 items-center justify-center gap-2 rounded-pill bg-primary px-8 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover">
					Start your 35-day free trial
					@icon.ArrowRight(icon.Props{Class: "size-4"})
				</a>
			</div>
		</div>
	</section>
}

// ── shared building blocks ─────────────────────────────────────────────────────

// browserFrame wraps a product screenshot in a faux browser chrome so it reads
// as a live app rather than a floating image.
templ browserFrame(src, alt string) {
	<div class="overflow-hidden rounded-xl border border-border bg-card shadow-2xl">
		<div class="flex items-center gap-1.5 border-b border-border bg-muted/40 px-4 py-2.5">
			// A traffic light in the app's own three hues. The stock red/amber/green
			// has no place in this palette, and destructive and primary are both
			// terracotta here — using them together would render two identical dots.
			<span class="size-3 rounded-full bg-money-negative/60"></span>
			<span class="size-3 rounded-full bg-warm-400"></span>
			<span class="size-3 rounded-full bg-money-positive/60"></span>
		</div>
		<img src={ Asset(src) } alt={ alt } loading="lazy" class="block w-full"/>
	</div>
}

templ featureCard(ic templ.Component, title, body string) {
	<div class="rounded-xl border border-border bg-card p-6">
		<div class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
			@ic
		</div>
		<h3 class="mt-4 font-medium">{ title }</h3>
		<p class="mt-2 text-sm text-muted-foreground">{ body }</p>
	</div>
}

templ trustItem(ic templ.Component, title, body string) {
	<div class="rounded-xl border border-border bg-card p-6">
		<div class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
			@ic
		</div>
		<h3 class="mt-4 font-medium">{ title }</h3>
		<p class="mt-2 text-sm text-muted-foreground">{ body }</p>
	</div>
}

templ addOnPoint(text string) {
	<li class="flex items-start gap-3">
		@icon.Check(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-primary"})
		<span class="text-muted-foreground">{ text }</span>
	</li>
}

templ pricingPoint(text string) {
	<div class="flex items-start gap-3">
		@icon.CircleCheck(icon.Props{Class: "mt-0.5 size-5 shrink-0 text-primary"})
		<span class="text-sm">{ text }</span>
	</div>
}

// cookieNotice is a dismissible banner explaining that Pigglet uses only
// essential cookies. It starts hidden and is revealed by the inline script only
// when the visitor hasn't dismissed it before (tracked in localStorage), so it
// never flashes for returning visitors and needs no server-side state.
templ cookieNotice() {
	<div id="cookie-notice" class="fixed inset-x-0 bottom-0 z-50 hidden p-4 sm:p-6">
		<div class="mx-auto flex max-w-3xl flex-col gap-3 rounded-xl border border-border bg-card p-4 shadow-lg sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-muted-foreground">
				{ i18n.T(ctx, "marketing.cookie_body") }
				<a href={ templ.SafeURL(publicHref(ctx, "/privacy")) } class="font-medium text-foreground underline underline-offset-4">{ i18n.T(ctx, "marketing.cookie_learn_more") }</a>.
			</p>
			<button type="button" onclick="dismissCookieNotice()" class="inline-flex h-9 shrink-0 items-center justify-center rounded-pill bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover">
				{ i18n.T(ctx, "marketing.cookie_dismiss") }
			</button>
		</div>
	</div>
	<script>
		(function () {
			try {
				if (!localStorage.getItem("cookie-notice-dismissed")) {
					var el = document.getElementById("cookie-notice");
					if (el) el.classList.remove("hidden");
				}
			} catch (e) {}
		})();
		function dismissCookieNotice() {
			try { localStorage.setItem("cookie-notice-dismissed", "1"); } catch (e) {}
			var el = document.getElementById("cookie-notice");
			if (el) el.classList.add("hidden");
		}
	</script>
}
