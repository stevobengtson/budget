package views

import (
	"context"
	"time"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/monthselector"
)

type BudgetData struct {
	Month              string // "YYYY-MM"
	PrevMonth          string
	NextMonth          string
	Estimated          int64
	Budgeted           int64
	Remain             int64
	CreditRows         []store.CreditActivity
	Groups             []BudgetGroup
	IncomeRows         []store.Income
	Accounts           []store.AccountWithBalance
	UncategorizedSpent int64
	// ArchivedCount gates the Archived control in the table header — it is the
	// only way back to an archived category, so it appears exactly when there is
	// something to go back to.
	ArchivedCount int
}

// BudgetGroup is one category group plus its month rows, for rendering a
// per-group <tbody>. Empty groups (Rows == nil) still render so the user can
// add the first category to them.
type BudgetGroup struct {
	ID   int64
	Name string
	Rows []store.CategoryBudget
	// Collapsed hides the group's category rows (header + available total only),
	// from the budget_groups_collapsed cookie.
	Collapsed bool
}

templ BudgetPage(d BudgetData, collapsed bool) {
	@Layout("Budget", "budget", collapsed) {
		@BudgetBody(d)
	}
}

templ BudgetMonthSelector(d BudgetData) {
	<div class="flex items-center justify-between gap-4 pb-2">
		<h1 class="text-2xl font-semibold tracking-tight">{ formatMonth(ctx, d.Month) }</h1>
		@monthselector.MonthSelector(bgMonthHref(d.PrevMonth), bgMonthHref(nowMonth()), bgMonthHref(d.NextMonth), d.Month == nowMonth())
	</div>
}

func bgMonthHref(month string) string {
	return "/budget?month=" + month
}

templ BudgetBody(d BudgetData) {
	@BudgetRegion(d)
}

// BudgetRegion is the initial-render container for the assignment-dependent
// sections: banner stats, the credit table, and the main budget table. On the
// full page load it renders everything; incremental assignment saves no longer
// swap this whole region — they replace just the edited row and refresh the
// banner + totals via out-of-band swaps (see BudgetAssignResult).
templ BudgetRegion(d BudgetData) {
	@budgetRegion(d, false)
}

// BudgetRegionOOB is the same region marked for an out-of-band swap, for
// responses whose primary target is elsewhere — the archived panel unarchives
// into its own list and refreshes the table behind the modal with this.
templ BudgetRegionOOB(d BudgetData) {
	@budgetRegion(d, true)
}

templ budgetRegion(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "budget-region"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div class="flex flex-col gap-s6" { attrs... }>
		<div class="flex flex-col gap-s6 lg:flex-row">
			@BudgetRail(d, false)
			@BudgetTable(d)
		</div>
		// Mobile only: the sidebar carries this list at >=768px but is hidden
		// below it, and the design puts the account summary under the Budget tab
		// on phones. Distinct mount id because both copies are server-rendered.
		<div class="border-t border-border pt-s4 md:hidden">
			@accountsPanel("mobile-overview")
		</div>
	</div>
}

func formatMonth(ctx context.Context, m string) string {
	t, err := time.Parse("2006-01", m)
	if err != nil {
		return m
	}
	return format.MonthYear(ctx, t)
}

func nowMonth() string { return time.Now().Format("2006-01") }
