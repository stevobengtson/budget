package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
)

// BudgetIncomePanel is the income source editor. Income used to be a collapsible
// section at the top of the budget table, competing for width with the category
// columns it shares nothing with. In the redesign the month's income total lives
// in the summary rail and the sources are edited here, opened from the Income
// button above the category list.
//
// Every mutation inside the panel refreshes the rail out of band, so the total
// behind the panel stays honest while it is open.
templ BudgetIncomePanel(d BudgetData) {
	@dialogPanel("max-w-xl") {
		<div class="flex items-center justify-between gap-s3">
			<h2 class="font-heading text-[22px] font-semibold">Income for { formatMonth(d.Month) }</h2>
			<button
				type="button"
				class="inline-flex size-9 items-center justify-center rounded-pill text-muted-foreground hover:bg-foreground/[0.07] hover:text-foreground"
				aria-label="Close"
				hx-on:click="document.getElementById('modal').innerHTML = ''"
			>
				@icon.X(icon.Props{Class: "size-[18px]"})
			</button>
		</div>
		<p class="text-[14px] text-muted-foreground">
			What you expect to earn this month. This is what Ready to assign is measured against.
		</p>
		<div id="income-rows" class="flex flex-col">
			for _, r := range d.IncomeRows {
				@IncomeRow(d.Month, r)
			}
		</div>
		@IncomeTotalsRow(d, false)
		<div class="flex items-center justify-end gap-s2">
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "rounded-pill",
				Attributes: templ.Attributes{
					"hx-post":    "/budget/income/copy-prev?month=" + d.Month,
					"hx-target":  "#modal",
					"hx-swap":    "innerHTML",
					"hx-confirm": "Copy all entries from the previous month into this one?",
					"title":      "Copy every entry from the previous month",
				},
			}) {
				Same as last month
			}
			@button.Button(button.Props{
				Type:    "button",
				Size:    button.SizeSm,
				Class:   "rounded-pill",
				Attributes: templ.Attributes{
					"hx-get":    "/budget/income/new?month=" + d.Month,
					"hx-target": "#income-rows",
					"hx-swap":   "beforeend",
					"title":     "Add income",
				},
			}) {
				Add a source
			}
		</div>
	}
}

// IncomeTotalsRow is the panel's total, with a stable id so an income mutation
// can refresh just this figure out of band (oob=true) rather than re-rendering
// the panel. A div needs no <template> wrapper to survive an OOB swap.
templ IncomeTotalsRow(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "income-totals"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div class="flex items-baseline justify-between gap-s2 border-t border-border pt-s3 text-[15px]" { attrs... }>
		<span class="font-semibold">Total income</span>
		<span class="js-income-total-value font-bold tabular-nums text-money-positive">
			{ money.Format(incomeTotal(d.IncomeRows)) }
		</span>
	</div>
}

func incomeTotal(rows []store.Income) (total int64) {
	for _, r := range rows {
		total += r.AmountCents
	}
	return
}

// IncomeRow is one income source: an inline-editable name and amount, plus
// delete. Both fields reuse the same js-name-* / js-assign-* click-to-edit
// behaviour as the category rows, so inline-edit.js and name-edit.js drive them
// unchanged.
templ IncomeRow(month string, r store.Income) {
	<div id={ fmt.Sprintf("income-%d", r.ID) } class="group flex items-center gap-s3 border-b border-border py-s2 last:border-b-0">
		<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="flex min-w-0 flex-1 items-center">
			<button type="button" class="js-name-display cursor-text truncate rounded-sm px-1 py-0.5 text-[15px] font-semibold ring-1 ring-transparent hover:ring-border" title="Click to rename">
				{ r.Name }
			</button>
			<input type="text" name="name" value={ r.Name } autocomplete="off" class="js-name-input hidden h-9 w-full rounded-pill border border-primary bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
		</form>
		<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="js-assign flex w-[140px] shrink-0 items-center justify-end">
			<button type="button" class="js-assign-display h-9 w-full cursor-text rounded-pill bg-surface-sunk px-s3 text-right text-[15px] font-semibold tabular-nums text-money-positive ring-1 ring-transparent hover:ring-border" title="Click to edit">
				{ money.Format(r.AmountCents) }
			</button>
			<input type="text" name="amount" value={ money.Format(r.AmountCents) } inputmode="decimal" autocomplete="off" class="js-assign-input hidden h-9 w-full rounded-pill border border-primary bg-surface-sunk px-s3 text-right text-[15px] font-semibold tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
		</form>
		@button.Button(button.Props{
			Type:    "button",
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Class:   "shrink-0 rounded-pill text-muted-foreground hover:text-money-negative",
			Attributes: templ.Attributes{
				"hx-delete":  fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month),
				"hx-target":  fmt.Sprintf("#income-%d", r.ID),
				"hx-swap":    "outerHTML",
				"hx-confirm": "Delete this income entry?",
				"title":      "Delete",
			},
		}) {
			@icon.X(icon.Props{Class: "size-4"})
		}
	</div>
}

// IncomeNewRow is the transient add-income row. Its two inputs belong to one
// form and it saves explicitly rather than on blur, because two fields have no
// obvious single commit point.
templ IncomeNewRow(month string) {
	<div data-newrow class="flex items-center gap-s3 border-b border-border py-s2 last:border-b-0">
		<form id="income-new-form" hx-post={ "/budget/income?month=" + month } hx-target="closest [data-newrow]" hx-swap="outerHTML" class="flex min-w-0 flex-1 items-center">
			<input type="text" name="name" autofocus placeholder="Source" autocomplete="off" class="h-9 w-full rounded-pill border border-primary bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
		</form>
		<input type="text" form="income-new-form" name="amount" placeholder="0.00" inputmode="decimal" autocomplete="off" class="h-9 w-[140px] shrink-0 rounded-pill border border-primary bg-surface-sunk px-s3 text-right text-[15px] tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
		<div class="flex shrink-0 items-center gap-s2">
			@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Class: "rounded-pill", Attributes: templ.Attributes{"form": "income-new-form"}}) {
				Save
			}
			@button.Button(button.Props{
				Type:       "button",
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Class:      "rounded-pill",
				Attributes: templ.Attributes{"hx-on:click": "this.closest('[data-newrow]').remove()"},
			}) {
				Cancel
			}
		</div>
	</div>
}

// BudgetIncomeRowResult refreshes one income row plus the panel total and the
// summary rail behind it (income moves Estimated and Ready to assign).
templ BudgetIncomeRowResult(month string, r store.Income, d BudgetData) {
	@IncomeRow(month, r)
	@IncomeTotalsRow(d, true)
	@BudgetRail(d, true)
}

// BudgetIncomeDeleteResult removes the income row (empty primary target) and
// refreshes the panel total and the rail out of band.
templ BudgetIncomeDeleteResult(d BudgetData) {
	@IncomeTotalsRow(d, true)
	@BudgetRail(d, true)
}

// BudgetIncomePanelResult re-renders the whole panel (for actions that change
// several rows at once, like copy-from-last-month) and refreshes the rail.
templ BudgetIncomePanelResult(d BudgetData) {
	@BudgetIncomePanel(d)
	@BudgetRail(d, true)
}
