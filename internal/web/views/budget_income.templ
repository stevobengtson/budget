package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/collapsiblecard"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/table"
)

templ BudgetIncomeSection(d BudgetData) {
	@collapsiblecard.Card(collapsiblecard.Props{Title: "Income", ID: "income-collapsible", PersistKey: "income", Open: d.IncomeOpen}) {
		@card.Content(card.ContentProps{Class: "pt-0"}) {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Source
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Amount
						}
						@table.Head(table.HeadProps{Class: "w-10"})
					}
				}
				<tbody id="income-rows">
					for _, r := range d.IncomeRows {
						@IncomeRow(d.Month, r)
					}
				</tbody>
				<tfoot>
					@IncomeTotalsRow(d, false)
				</tfoot>
			}
		}
		@card.Footer(card.FooterProps{Class: "flex justify-between"}) {
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "text-muted-foreground hover:text-foreground",
				Attributes: templ.Attributes{
					"hx-post":    "/budget/income/copy-prev?month=" + d.Month,
					"hx-target":  "#budget-region",
					"hx-swap":    "outerHTML",
					"hx-confirm": "Copy all entries from the previous month into this one?",
					"title":      "Copy every entry from the previous month",
				},
			}) {
				← copy from prev
			}
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"hx-get":    "/budget/income/new?month=" + d.Month,
					"hx-target": "#income-rows",
					"hx-swap":   "beforeend",
					"title":     "Add income",
				},
			}) {
				Add Income
			}
		}
	}
}

// IncomeTotalsRow is the income table footer, with a stable #income-totals id so
// an income mutation can refresh just the total via an out-of-band swap
// (oob=true) instead of re-rendering the section. When swapped OOB it must be
// wrapped in a <template> by the caller, because the browser strips a bare <tr>
// that isn't already inside a table.
templ IncomeTotalsRow(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "income-totals"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "font-semibold"}) {
			Total
		}
		@table.Cell(table.CellProps{Class: "text-right font-semibold tabular-nums text-emerald-500"}) {
			{ money.Format(incomeTotal(d.IncomeRows)) }
		}
		@table.Cell()
	}
}

func incomeTotal(rows []store.Income) (total int64) {
	for _, r := range rows {
		total += r.AmountCents
	}
	return
}

templ IncomeRow(month string, r store.Income) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"id": fmt.Sprintf("income-%d", r.ID), "class": "group"}}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="flex items-center">
				<button type="button" class="js-name-display cursor-text rounded-md px-1 py-0.5 text-sm ring-1 ring-transparent hover:ring-border" title="Click to rename">
					{ r.Name }
				</button>
				<input type="text" name="name" value={ r.Name } autocomplete="off" class="js-name-input hidden h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</form>
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="js-assign flex items-center justify-end">
				<button type="button" class="js-assign-display cursor-text rounded-md px-2 py-1 text-right text-sm tabular-nums text-emerald-500 ring-1 ring-transparent hover:ring-border" title="Click to edit">
					{ money.Format(r.AmountCents) }
				</button>
				<input type="text" name="amount" value={ money.Format(r.AmountCents) } inputmode="decimal" autocomplete="off" class="js-assign-input hidden h-8 w-28 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</form>
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "text-muted-foreground hover:text-destructive",
				Attributes: templ.Attributes{
					"hx-delete":  fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month),
					"hx-target":  fmt.Sprintf("#income-%d", r.ID),
					"hx-swap":    "outerHTML",
					"hx-confirm": "Delete this income entry?",
					"title":      "Delete",
				},
			}) {
				×
			}
		}
	}
}

// IncomeNewRow is the transient add-income row (multi-field -> explicit Save,
// like the goal editor, not blur-save).
templ IncomeNewRow(month string) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-newrow": ""}}) {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "3", "class": "p-2"}}) {
			<form hx-post={ "/budget/income?month=" + month } hx-target="closest tr" hx-swap="outerHTML" class="flex flex-wrap items-end gap-3">
				<input type="text" name="name" autofocus placeholder="Source" autocomplete="off" class="h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				<input type="text" name="amount" placeholder="0.00" inputmode="decimal" autocomplete="off" class="h-8 w-32 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm}) {
					save
				}
				@button.Button(button.Props{
					Type:       "button",
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"hx-on:click": "this.closest('tr').remove()"},
				}) {
					cancel
				}
			</form>
		}
	}
}

// BudgetIncomeRowResult refreshes one income row plus the OOB banner and income
// total (income changes move Estimated / Remain and the footer sum).
templ BudgetIncomeRowResult(month string, r store.Income, d BudgetData) {
	@IncomeRow(month, r)
	@budgetBanner(d, true)
	<template>
		@IncomeTotalsRow(d, true)
	</template>
}

// BudgetIncomeDeleteResult removes the income row (empty primary target) and
// refreshes the banner + income total out of band.
templ BudgetIncomeDeleteResult(d BudgetData) {
	@budgetBanner(d, true)
	<template>
		@IncomeTotalsRow(d, true)
	</template>
}
