package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/table"
)

// BudgetIncomeSection renders income as top-of-table sections that share the
// main budget table's 6-column grid: a muted "Income" header row (with the
// copy-from-prev + add controls inline), the income rows, and a totals row.
// Amounts live in the Assigned column so they align with the expense rows
// below. It is emitted from BudgetTable, above the Expenses divider.
templ BudgetIncomeSection(d BudgetData) {
	<tbody id="income-rows">
		@incomeHeaderRow(d)
		@subHeaderRow("Source", "Amount")
		for _, r := range d.IncomeRows {
			@IncomeRow(d.Month, r)
		}
	</tbody>
	<tbody id="income-totals-body">
		@IncomeTotalsRow(d, false)
	</tbody>
}

// incomeHeaderRow is the muted "Income" section header, mirroring a category
// group header. It carries the section's copy-from-prev and add-income controls.
templ incomeHeaderRow(d BudgetData) {
	@table.Row(table.RowProps{Class: "bg-muted hover:bg-muted", Attributes: templ.Attributes{"id": "income-header"}}) {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2 align-middle"}}) {
			<div class="flex items-center gap-2">
				<button
					type="button"
					class="flex items-center gap-1.5 rounded-md px-1 py-0.5 hover:text-foreground"
					data-collapse="income"
					title="Collapse or expand income"
					aria-label="Toggle income section"
				>
					@icon.ChevronRight(icon.Props{Class: "js-income-caret size-3.5 text-muted-foreground transition-transform"})
					<span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Income</span>
				</button>
				<div class="ml-auto flex items-center gap-2">
					<span class="js-income-total-header text-sm font-semibold tabular-nums text-emerald-500">
						{ money.Format(incomeTotal(d.IncomeRows)) }
					</span>
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantGhost,
						Size:    button.SizeSm,
						Class:   "text-muted-foreground hover:text-foreground",
						Attributes: templ.Attributes{
							"hx-post":    "/budget/income/copy-prev?month=" + d.Month,
							"hx-target":  "#budget-region",
							"hx-swap":    "outerHTML",
							"hx-confirm": "Copy all entries from the previous month into this one?",
							"title":      "Copy every entry from the previous month",
						},
					}) {
						← copy from prev
					}
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "text-muted-foreground hover:text-foreground",
						Attributes: templ.Attributes{
							"hx-get":     "/budget/income/new?month=" + d.Month,
							"hx-target":  "#income-rows",
							"hx-swap":    "beforeend",
							"title":      "Add income",
							"hx-on:click": "document.getElementById('budget-table').classList.remove('income-collapsed')",
						},
					}) {
						Add Income
					}
				</div>
			</div>
		}
	}
}

// IncomeTotalsRow is the income section's totals row, with a stable
// #income-totals id so an income mutation can refresh just the total via an
// out-of-band swap (oob=true) instead of re-rendering the section. When swapped
// OOB it must be wrapped in a <template> by the caller, because the browser
// strips a bare <tr> that isn't already inside a table.
templ IncomeTotalsRow(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "income-totals"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "pl-6 font-semibold"}) {
			Total income
		}
		@table.Cell() {
			<div class="js-income-total-value flex items-center justify-end px-2 py-1 text-sm font-semibold tabular-nums text-emerald-500">
				{ money.Format(incomeTotal(d.IncomeRows)) }
			</div>
		}
		@table.Cell()
		@table.Cell()
		@table.Cell()
		@table.Cell()
	}
}

func incomeTotal(rows []store.Income) (total int64) {
	for _, r := range rows {
		total += r.AmountCents
	}
	return
}

// IncomeRow renders one income entry as a main-table row: source in the
// category column, amount in the Assigned column, the remaining expense columns
// blank, and the delete control in the trailing actions column.
templ IncomeRow(month string, r store.Income) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"id": fmt.Sprintf("income-%d", r.ID), "class": "group"}}) {
		@table.Cell(table.CellProps{Class: "pl-6 font-medium"}) {
			<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="flex items-center">
				<button type="button" class="js-name-display cursor-text rounded-md px-1 py-0.5 text-sm ring-1 ring-transparent hover:ring-border" title="Click to rename">
					{ r.Name }
				</button>
				<input type="text" name="name" value={ r.Name } autocomplete="off" class="js-name-input hidden h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</form>
		}
		@table.Cell() {
			<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="js-assign flex items-center justify-end">
				<button type="button" class="js-assign-display cursor-text rounded-md px-2 py-1 text-right text-sm tabular-nums text-emerald-500 ring-1 ring-transparent hover:ring-border" title="Click to edit">
					{ money.Format(r.AmountCents) }
				</button>
				<input type="text" name="amount" value={ money.Format(r.AmountCents) } inputmode="decimal" autocomplete="off" class="js-assign-input hidden h-8 w-28 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</form>
		}
		@table.Cell()
		@table.Cell()
		@table.Cell()
		@table.Cell(table.CellProps{Class: "text-right"}) {
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "text-muted-foreground hover:text-destructive",
				Attributes: templ.Attributes{
					"hx-delete":  fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month),
					"hx-target":  fmt.Sprintf("#income-%d", r.ID),
					"hx-swap":    "outerHTML",
					"hx-confirm": "Delete this income entry?",
					"title":      "Delete",
				},
			}) {
				×
			}
		}
	}
}

// IncomeNewRow is the transient add-income row. Its fields sit in the same
// columns as a saved IncomeRow (source, amount, then the actions column) so the
// editor lines up with existing rows. The controls live in separate cells but
// belong to one form via the HTML5 form="" attribute — a single <form> can't
// legally wrap multiple <td>s. Multi-field -> explicit Save (like the goal
// editor, not blur-save).
templ IncomeNewRow(month string) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-newrow": ""}}) {
		@table.Cell(table.CellProps{Class: "pl-6 font-medium"}) {
			<form id="income-new-form" hx-post={ "/budget/income?month=" + month } hx-target="closest tr" hx-swap="outerHTML" class="flex items-center">
				<input type="text" name="name" autofocus placeholder="Source" autocomplete="off" class="h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</form>
		}
		@table.Cell() {
			<div class="flex items-center justify-end">
				<input type="text" form="income-new-form" name="amount" placeholder="0.00" inputmode="decimal" autocomplete="off" class="h-8 w-28 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</div>
		}
		@table.Cell()
		@table.Cell()
		@table.Cell()
		@table.Cell(table.CellProps{Class: "text-right"}) {
			<div class="flex items-center justify-end gap-2">
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Attributes: templ.Attributes{"form": "income-new-form"}}) {
					save
				}
				@button.Button(button.Props{
					Type:       "button",
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"hx-on:click": "this.closest('tr').remove()"},
				}) {
					cancel
				}
			</div>
		}
	}
}

// BudgetIncomeRowResult refreshes one income row plus the OOB banner and income
// total (income changes move Estimated / Remain and the footer sum).
templ BudgetIncomeRowResult(month string, r store.Income, d BudgetData) {
	@IncomeRow(month, r)
	@BudgetSummary(d, true)
	<template>
		@IncomeTotalsRow(d, true)
	</template>
}

// BudgetIncomeDeleteResult removes the income row (empty primary target) and
// refreshes the banner + income total out of band.
templ BudgetIncomeDeleteResult(d BudgetData) {
	@BudgetSummary(d, true)
	<template>
		@IncomeTotalsRow(d, true)
	</template>
}
