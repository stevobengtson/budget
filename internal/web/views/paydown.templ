package views

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/paydown"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/input"
)

// PaydownPageSize is the number of schedule rows shown per paginated
// section on the paydown page. Exported so the handler can use the same
// value when rendering an htmx fragment.
const PaydownPageSize = 5

// pdGridCols is the schedule's shared column track, declared once so the head
// row and the data rows cannot drift apart. The source column is the first to
// go on narrow screens.
const pdGridCols = "grid grid-cols-[1fr_110px_110px] md:grid-cols-[1fr_130px_130px_150px_150px] items-center gap-s4"

type PaydownData struct {
	Plans         []paydown.Plan
	Accounts      []store.AccountWithBalance
	AllAccounts   []store.AccountWithBalance
	Categories    []store.Category
	Horizon       int
	TotalMonthly  int64
	TotalInterest int64
	PageSize      int
}

templ PaydownPage(d PaydownData, collapsed bool) {
	@Layout(i18n.T(ctx, "nav.paydown"), "paydown", collapsed) {
		<div class="flex flex-col gap-s4">
			<div class="flex flex-wrap items-center justify-between gap-s3">
				<h1 class="font-heading text-[28px] font-semibold">{ i18n.T(ctx, "paydown.heading") }</h1>
				<form method="get" action="/paydown" class="flex items-center gap-s2">
					<label for="pd-horizon" class="text-[14px] text-muted-foreground">{ i18n.T(ctx, "paydown.project_label") }</label>
					<input
						id="pd-horizon"
						type="number"
						name="horizon"
						value={ strconv.Itoa(d.Horizon) }
						min="12"
						max="360"
						step="12"
						class="h-9 w-[76px] rounded-pill border border-input bg-surface-sunk px-s3 text-right text-[15px] tabular-nums outline-none focus-visible:border-primary"
					/>
					<span class="text-[14px] text-muted-foreground">{ i18n.T(ctx, "paydown.months_label") }</span>
					@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Variant: button.VariantOutline, Class: "rounded-pill"}) {
						{ i18n.T(ctx, "paydown.apply") }
					}
				</form>
			</div>
			<div class="grid grid-cols-1 gap-s3 sm:grid-cols-3">
				@pdStat(i18n.T(ctx, "paydown.stat_monthly"), money.Format(ctx, d.TotalMonthly), "bg-surface-ready", "text-surface-ready-fg")
				@pdStat(i18n.Tnf(ctx, "paydown.stat_interest", d.Horizon, i18n.M{"Months": d.Horizon}), money.Format(ctx, d.TotalInterest), "bg-surface-attention", "text-surface-attention-fg")
				@pdStat(i18n.T(ctx, "paydown.stat_debt_free"), debtFreeLabel(ctx, d.Plans), "bg-card", "text-foreground")
			</div>
			if len(d.Plans) == 0 {
				<p class="text-[15px] text-muted-foreground">
					{ i18n.T(ctx, "paydown.empty") }
				</p>
			}
			for i, p := range d.Plans {
				@PaydownSection(p, d.Accounts[i], d.Horizon, d.PageSize, PaymentCategoryName(d.Categories, d.Accounts[i]))
			}
		</div>
	}
}

// debtFreeLabel is the month the last debt clears. "Not within the horizon"
// when any plan never pays off — a date would be a lie there.
func debtFreeLabel(ctx context.Context, plans []paydown.Plan) string {
	if len(plans) == 0 {
		return "—"
	}
	var latest time.Time
	for _, p := range plans {
		if p.PayoffMonth.IsZero() {
				return i18n.T(ctx, "paydown.not_yet")
		}
		if p.PayoffMonth.After(latest) {
			latest = p.PayoffMonth
		}
	}
	return format.MonthYear(ctx, latest)
}

// PaymentCategoryName resolves the budget category feeding an account's
// payment, so the schedule can name it in words. Exported because the schedule
// fragment handler needs it too.
func PaymentCategoryName(cats []store.Category, acct store.AccountWithBalance) string {
	if acct.PaymentCategoryID == nil {
		return ""
	}
	for _, c := range cats {
		if c.ID == *acct.PaymentCategoryID {
			return c.Name
		}
	}
	return ""
}

templ pdStat(label, value, bgClass, textClass string) {
	<div class={ "flex flex-col gap-s2 rounded-xl p-s3 shadow-organic-sm", bgClass, textClass }>
		<span class="text-[12px] font-bold uppercase tracking-[0.08em]">{ label }</span>
		<span class="font-heading text-[34px] font-semibold leading-[1.1] tabular-nums">{ value }</span>
	</div>
}

templ PaydownSection(p paydown.Plan, acct store.AccountWithBalance, horizon, pageSize int, catName string) {
	<section class="flex flex-col gap-s3 rounded-xl border border-border bg-background p-s3">
		<div class="flex flex-wrap items-center gap-x-s3 gap-y-s2">
			<h2 class="font-heading text-[20px] font-semibold">{ acct.Name }</h2>
			<span class="rounded-pill bg-tag-neutral-bg px-2 py-0.5 text-[12px] font-semibold text-tag-neutral-fg tabular-nums">
				{ i18n.Tf(ctx, "paydown.apr_tag", i18n.M{"Rate": format.Decimal(ctx, float64(p.AprBps)/100.0, 2)}) }
			</span>
			<span class="text-[14px] text-muted-foreground">
				{ i18n.T(ctx, "paydown.payment_label") } <span class="font-bold tabular-nums text-money-positive">{ money.Format(ctx, p.PaymentCents) }{ i18n.T(ctx, "budget.per_month_suffix") }</span>
			</span>
			<span class="text-[14px] text-muted-foreground">
				{ i18n.T(ctx, "paydown.start_label") } <span class="font-bold tabular-nums text-foreground">{ money.Format(ctx, p.StartCents) }</span>
			</span>
			if !p.PayoffMonth.IsZero() {
				<span class="text-[14px] text-muted-foreground">
					{ i18n.T(ctx, "paydown.clears_label") } <span class="font-bold text-foreground">{ format.MonthYear(ctx, p.PayoffMonth) }</span>
				</span>
			}
			if p.Diverging {
				<span class="rounded-pill bg-surface-attention px-2 py-0.5 text-[12px] font-semibold text-surface-attention-fg">
					{ i18n.T(ctx, "paydown.diverging") }
				</span>
			}
			<div class="ml-auto">
				@pdSectionMenu(acct)
			</div>
		</div>
		<div id={ fmt.Sprintf("pd-rows-%d", acct.ID) } class="relative">
			@PaydownScheduleBody(p, horizon, 1, pageSize, catName)
		</div>
	</section>
}

// pdSectionMenu renders the per-account three-dot actions menu (Edit Payment /
// Link Category / Remove), matching the transactions and budget rows' menu
// system.
templ pdSectionMenu(acct store.AccountWithBalance) {
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class:      "inline-flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground",
			Attributes: templ.Attributes{"title": i18n.T(ctx, "paydown.account_actions")},
		}) {
			⋮
		}
		@dropdown.Content() {
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-get":    fmt.Sprintf("/paydown/%d/payment-form", acct.ID),
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
				},
			}) {
				{ i18n.T(ctx, "paydown.menu_edit_payment") }
			}
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-get":    fmt.Sprintf("/paydown/%d/category-form", acct.ID),
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
				},
			}) {
				{ i18n.T(ctx, "paydown.menu_link_category") }
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class: "text-destructive",
				Attributes: templ.Attributes{
					"hx-post":    fmt.Sprintf("/paydown/%d/exclude", acct.ID),
					"hx-confirm": i18n.T(ctx, "paydown.remove_confirm"),
				},
			}) {
				{ i18n.T(ctx, "paydown.menu_remove") }
			}
		}
	}
}

// PaydownScheduleBody is one slice of a plan's monthly projection plus its
// pager. Used both for the initial render (inside PaydownSection) and the
// htmx fragment swap.
templ PaydownScheduleBody(p paydown.Plan, horizon, page, pageSize int, catName string) {
	{{
		if pageSize <= 0 {
			pageSize = PaydownPageSize
		}
		total := len(p.Rows)
		pages := (total + pageSize - 1) / pageSize
		if pages < 1 {
			pages = 1
		}
		if page < 1 {
			page = 1
		}
		if page > pages {
			page = pages
		}
		start := (page - 1) * pageSize
		end := start + pageSize
		if end > total {
			end = total
		}
		rows := p.Rows[start:end]
	}}
	@paydownSpinner(p.AccountID)
	<div class="flex flex-col">
		<div class={ pdGridCols, "px-s3 pb-s2 text-[12px] font-bold uppercase tracking-[0.08em] text-muted-foreground" }>
			<span>{ i18n.T(ctx, "paydown.col_month") }</span>
			<span class="text-right">{ i18n.T(ctx, "paydown.col_interest") }</span>
			<span class="text-right">{ i18n.T(ctx, "paydown.col_payment") }</span>
			<span class="hidden md:block">{ i18n.T(ctx, "paydown.col_source") }</span>
			<span class="text-right">{ i18n.T(ctx, "paydown.col_balance") }</span>
		</div>
		for _, r := range rows {
			<div class={ pdGridCols, "border-t border-border px-s3 py-2 text-[15px]" }>
				<span class="whitespace-nowrap">{ format.MonthYear(ctx, r.Month) }</span>
				<span class="text-right tabular-nums text-money-negative">{ money.Format(ctx, r.InterestCents) }</span>
				<span class="text-right tabular-nums">{ money.Format(ctx, r.PaymentCents) }</span>
				<span class="hidden truncate text-[14px] text-muted-foreground md:block">
					@PaydownSource(r.PaymentSource, catName)
				</span>
				<span class="text-right font-bold tabular-nums">{ money.Format(ctx, r.BalanceCents) }</span>
			</div>
		}
	</div>
	<div class="flex items-center gap-s3 pt-s3 text-[13px] text-muted-foreground">
		@button.Button(button.Props{
			Type:     "button",
			Variant:  button.VariantOutline,
			Size:     button.SizeSm,
			Class:    "rounded-pill",
			Disabled: page <= 1,
			Attributes: templ.Attributes{
				"hx-get":       fmt.Sprintf("/paydown/%d/rows?horizon=%d&page=%d", p.AccountID, horizon, page-1),
				"hx-target":    fmt.Sprintf("#pd-rows-%d", p.AccountID),
				"hx-swap":      "innerHTML",
				"hx-indicator": fmt.Sprintf("#pd-spin-%d", p.AccountID),
			},
		}) {
			{ i18n.T(ctx, "common.prev_page") }
		}
		<span>
			{ i18n.Tf(ctx, "paydown.pager", i18n.M{"Page": page, "Pages": pages, "Months": total}) }
		</span>
		@button.Button(button.Props{
			Type:     "button",
			Variant:  button.VariantOutline,
			Size:     button.SizeSm,
			Class:    "rounded-pill",
			Disabled: page >= pages,
			Attributes: templ.Attributes{
				"hx-get":       fmt.Sprintf("/paydown/%d/rows?horizon=%d&page=%d", p.AccountID, horizon, page+1),
				"hx-target":    fmt.Sprintf("#pd-rows-%d", p.AccountID),
				"hx-swap":      "innerHTML",
				"hx-indicator": fmt.Sprintf("#pd-spin-%d", p.AccountID),
			},
		}) {
			{ i18n.T(ctx, "common.next_page") }
		}
	</div>
}

// PaydownSource says in words where a projected payment came from. It replaces
// the old ✓ spent / → assigned / · default colour glyphs, which carried the
// meaning entirely in a symbol and a hue. Naming the category makes the sentence
// answer the question the column actually asks.
templ PaydownSource(s paydown.PaymentSource, catName string) {
	if s == paydown.SourceSpent && catName != "" {
		<span>{ i18n.Tf(ctx, "paydown.source_spent_in", i18n.M{"Name": catName}) }</span>
	} else if s == paydown.SourceSpent {
		<span>{ i18n.T(ctx, "paydown.source_spent") }</span>
	} else if s == paydown.SourceAssigned && catName != "" {
		<span>{ i18n.Tf(ctx, "paydown.source_assigned_in", i18n.M{"Name": catName}) }</span>
	} else if s == paydown.SourceAssigned {
		<span>{ i18n.T(ctx, "paydown.source_assigned") }</span>
	} else {
		<span>{ i18n.T(ctx, "paydown.source_default") }</span>
	}
}

// paydownSpinner is the overlay shown while a schedule page is fetched. It sits
// inside the per-account rows wrapper (which is position:relative) and is driven
// by htmx's .htmx-indicator fade.
templ paydownSpinner(acctID int64) {
	<div id={ fmt.Sprintf("pd-spin-%d", acctID) } class="htmx-indicator pointer-events-none absolute inset-0 z-10 flex items-start justify-center bg-background/60">
		<svg class="mt-6 h-6 w-6 animate-spin text-muted-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
			<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
			<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
		</svg>
	</div>
}

// PaymentModal renders a centered card with a single-input form for
// updating the fallback monthly payment on an account.
templ PaymentModal(acct store.AccountWithBalance) {
	@dialogPanel("") {
		@dialog.Header() {
			@dialog.Title() {
				{ i18n.Tf(ctx, "paydown.payment_modal_title", i18n.M{"Name": acct.Name}) }
			}
		}
		<form hx-post={ fmt.Sprintf("/paydown/%d/payment", acct.ID) } hx-target="body" hx-swap="outerHTML" class="grid gap-4">
			@formRow("pd-payment", i18n.T(ctx, "accounts.monthly_payment_field")) {
				if acct.MonthlyPaymentCents != nil {
					@input.Input(input.Props{
						ID:          "pd-payment",
						Name:        "amount",
						Value:       money.Format(ctx, *acct.MonthlyPaymentCents),
						Placeholder: "200.00",
						Class:       "tabular-nums",
						Attributes:  templ.Attributes{"autofocus": ""},
					})
				} else {
					@input.Input(input.Props{
						ID:          "pd-payment",
						Name:        "amount",
						Placeholder: "200.00",
						Class:       "tabular-nums",
						Attributes:  templ.Attributes{"autofocus": ""},
					})
				}
			}
			<p class="text-[14px] text-muted-foreground">
				{ i18n.T(ctx, "paydown.payment_modal_note") }
			</p>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Type:       "button",
					Attributes: templ.Attributes{"hx-on:click": "document.getElementById('modal').replaceChildren()"},
				}) {
					{ i18n.T(ctx, "common.cancel") }
				}
				@button.Button(button.Props{Type: "submit"}) {
					{ i18n.T(ctx, "common.save") }
				}
			}
		</form>
	}
}

// CategoryModal renders the modal for linking / unlinking a budget
// category that drives this account's per-month payment override. The picker
// groups categories by category group, via SelectFieldGrouped — this used to be
// a hand-written native <select> with <optgroup>, on the assumption that
// templUI's selectbox had no grouping. It does (Group + Label).
templ CategoryModal(acct store.AccountWithBalance, cats []store.Category, groups []store.CategoryGroup) {
	@dialogPanel("") {
		@dialog.Header() {
			@dialog.Title() {
				{ i18n.Tf(ctx, "paydown.category_modal_title", i18n.M{"Name": acct.Name}) }
			}
		}
		<form hx-post={ fmt.Sprintf("/paydown/%d/category", acct.ID) } hx-target="body" hx-swap="outerHTML" class="grid gap-4">
			@formRow("pd-category", i18n.T(ctx, "tx.field_category")) {
				@SelectFieldGrouped(SelectFieldProps{
					ID:    "pd-category",
					Name:  "category_id",
					Class: "w-full",
				}, []Opt{
					{Value: "", Label: i18n.T(ctx, "paydown.category_none"), Selected: acct.PaymentCategoryID == nil},
				}, categoryOptGroups(cats, groups, acct.PaymentCategoryID))
			}
			<p class="text-sm text-muted-foreground">
				{ i18n.T(ctx, "paydown.category_modal_note") }
			</p>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Type:       "button",
					Attributes: templ.Attributes{"hx-on:click": "document.getElementById('modal').replaceChildren()"},
				}) {
					{ i18n.T(ctx, "common.cancel") }
				}
				@button.Button(button.Props{Type: "submit"}) {
					{ i18n.T(ctx, "common.save") }
				}
			}
		</form>
	}
}

// categoryOptGroups buckets categories under their category group, dropping any
// group that ended up empty so the dropdown shows no bare headings.
func categoryOptGroups(cats []store.Category, groups []store.CategoryGroup, selected *int64) []OptGroup {
	out := make([]OptGroup, 0, len(groups))
	for _, g := range groups {
		og := OptGroup{Label: g.Name}
		for _, c := range cats {
			if c.GroupID != g.ID {
				continue
			}
			og.Opts = append(og.Opts, Opt{
				Value:    strconv.FormatInt(c.ID, 10),
				Label:    c.Name,
				Selected: selected != nil && *selected == c.ID,
			})
		}
		if len(og.Opts) > 0 {
			out = append(out, og)
		}
	}
	return out
}
