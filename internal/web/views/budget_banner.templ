package views

import (
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/web/components/signedmoney"
	"github.com/templui/templui/components/card"
)

// BudgetBanner renders the summary stat cards inside a stable #budget-banner
// container so a single assignment save can refresh it via an out-of-band swap
// (pass oob=true) without touching the rest of the page.
templ BudgetBanner(d BudgetData) {
	@budgetBanner(d, false)
}

templ budgetBanner(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "budget-banner", "class": "sticky top-16 z-10"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div { attrs... }>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
			@bannerStat("Income", money.Format(d.Estimated), "text-foreground")
			@bannerStat("Budgeted", money.Format(d.Budgeted), "text-foreground")
			@bannerStatSigned("Remain", d.Remain)
		</div>
	</div>
}

templ bannerStat(label, value, valueClass string) {
	@card.Card(card.Props{Class: "p-4"}) {
		<div class="text-xs uppercase tracking-wide text-muted-foreground">{ label }</div>
		<div class={ "mt-1 text-lg font-semibold tabular-nums " + valueClass }>{ value }</div>
	}
}

templ bannerStatSigned(label string, cents int64) {
	@card.Card(card.Props{Class: "p-4"}) {
		<div class="text-xs uppercase tracking-wide text-muted-foreground">{ label }</div>
		<div class="mt-1 text-lg font-semibold tabular-nums">
			@signedmoney.Money(cents)
		</div>
	}
}
