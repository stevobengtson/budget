package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
)

// budgetGridCols is the shared column track for the column heads and every
// category row. Declared once so a head and its rows can never drift apart.
// Children place themselves explicitly (col-start/row-start) so one DOM order
// serves all three layouts.
//
// The tiers are container queries against #budget-table's own width, not the
// viewport, because the viewport does not determine how much room this table
// gets. Two things move it independently: the summary rail claims a fixed 300px
// beside the table from 1024px up, and the app sidebar collapses to a 72px icon
// rail on demand, handing the table ~256px with no viewport change at all. A
// media query cannot see either, which is how the 5-column track came to be
// applied at 768px where it needs ~950px: its fixed tracks total 670px and
// cannot shrink, so the name track absorbed the entire shortfall (52px of usable
// text at 1440px, 17 of 28 names clipped) and the page grew a horizontal
// scrollbar. inline-size containment also stops the grid forcing the table wider
// than its parent allows, so overflow can no longer escape into the document.
//
// The thresholds are the widths at which each layout actually fits, leaving the
// category name a readable 180px (the longest seeded name, "Credit Card
// Payment", wants 161px):
//
//	tier 2   180 name + 400 tracks + 52.8 gaps + 26.4 row padding = 659.2
//	tier 3   180 name + 670 tracks + 70.4 gaps + 26.4 row padding = 946.8
//
// Tier 2's name and goal tracks are minmax rather than fixed so the tier engages
// as early as it can and then degrades within itself. Sized rigidly at
// 1fr_190px_140px_140px it needed 730px, which a 1366px laptop misses by 62px —
// and missing it dropped the whole row to tier 1, losing Goal and Assigned
// outright. With a floor of 120px the goal column simply gives up its caption
// width first, and both columns survive down to 660px.
const budgetGridCols = "grid grid-cols-[1fr_auto] items-center gap-x-s3 gap-y-1 " +
	"@min-[660px]:grid-cols-[minmax(180px,1fr)_minmax(120px,190px)_140px_140px] @min-[660px]:gap-s4 " +
	"@min-[950px]:grid-cols-[1fr_190px_140px_200px_140px]"

// BudgetTable is the category list. It is a div grid rather than a <table>: the
// redesign shows two numbers per row (Assigned as an editable field, Available
// as the headline) with a progress bar between them, and every total has moved
// out to BudgetRail.
//
// Income and Credit are no longer sections here — income's total lands in the
// rail and its sources are edited in a panel; credit owing lands in "Needs
// attention". Only per-group collapse survives.
templ BudgetTable(d BudgetData) {
	<div
		id="budget-table"
		class="js-group-sort @container flex min-w-0 flex-1 flex-col"
		data-month={ d.Month }
	>
		<div class="flex items-center justify-between gap-s2 pb-s2">
			<span class="text-[12px] font-bold uppercase tracking-[0.08em] text-muted-foreground">{ i18n.T(ctx, "budget.categories_heading") }</span>
			<div class="flex items-center gap-s2">
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "rounded-pill",
					Attributes: templ.Attributes{
						"hx-get":    "/budget/income/panel?month=" + d.Month,
						"hx-target": "#modal",
						"hx-swap":   "innerHTML",
						"title":     i18n.T(ctx, "budget.income_button_title"),
					},
				}) {
					{ i18n.T(ctx, "budget.income_button") }
				}
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "rounded-pill",
					Attributes: templ.Attributes{
						"hx-get":    "/budget/credit/panel?month=" + d.Month,
						"hx-target": "#modal",
						"hx-swap":   "innerHTML",
						"title":     i18n.T(ctx, "budget.cards_button_title"),
					},
				}) {
					{ i18n.T(ctx, "budget.cards_button") }
				}
				// Only when there is something archived: this is the sole route back
				// from archiving, so it must be present whenever it can do anything —
				// and absent otherwise, rather than sitting in the header as a dead
				// control on a budget nobody has archived from.
				if d.ArchivedCount > 0 {
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "rounded-pill",
						Attributes: templ.Attributes{
							"hx-get":    "/budget/archived/panel?month=" + d.Month,
							"hx-target": "#modal",
							"hx-swap":   "innerHTML",
							"title":     i18n.T(ctx, "budget.archived_button_title"),
						},
					}) {
						{ i18n.T(ctx, "budget.archived_button") }
					}
				}
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "rounded-pill",
					Attributes: templ.Attributes{
						"hx-get":    "/budget/group/new",
						"hx-target": "#budget-groups",
						"hx-swap":   "afterbegin",
						"title":     i18n.T(ctx, "budget.add_group_title"),
					},
				}) {
					{ i18n.T(ctx, "budget.add_group") }
				}
			</div>
		</div>
		@budgetColumnHeads()
		<div id="budget-groups" class="flex flex-col">
			for _, g := range d.Groups {
				@BudgetGroupTbody(d.Month, g)
			}
		</div>
		if d.UncategorizedSpent != 0 {
			<div class="flex items-center justify-between gap-s3 px-s3 py-2 text-muted-foreground">
				<span class="truncate text-[15px]">{ i18n.T(ctx, "budget.uncategorized") }</span>
				<span class="text-[13px] tabular-nums">{ i18n.Tf(ctx, "budget.uncategorized_spent", i18n.M{"Amount": money.Format(ctx, d.UncategorizedSpent)}) }</span>
			</div>
		}
	</div>
}

// budgetColumnHeads labels the tracks. Assigned and Available are right-aligned
// so the labels sit over their figures.
//
// Progress has no column of its own below tier 3 — the bar stacks under the
// category name — so its label is dropped there. display:none takes it out of
// grid flow entirely, which lets Available auto-place into the 4th track at tier
// 2 and the 5th at tier 3 without either being positioned by hand.
templ budgetColumnHeads() {
	<div class={ budgetGridCols, "hidden px-s3 pb-s2 text-[12px] font-bold uppercase tracking-[0.08em] text-muted-foreground @min-[660px]:grid" }>
		<span>{ i18n.T(ctx, "budget.col_category") }</span>
		<span>{ i18n.T(ctx, "budget.col_goal") }</span>
		<span class="text-right">{ i18n.T(ctx, "budget.col_assigned") }</span>
		<span class="hidden @min-[950px]:block">{ i18n.T(ctx, "budget.col_progress") }</span>
		<span class="text-right">{ i18n.T(ctx, "budget.col_available") }</span>
	</div>
}

// BudgetGroupTbody renders one group: its header plus its category rows. The
// name is historical — it is a div now, not a <tbody> — but it stays because the
// handlers and the drag-sort JS both address groups by it.
templ BudgetGroupTbody(month string, g BudgetGroup) {
	{{ groupClass := "flex flex-col" }}
	if g.Collapsed {
		{{ groupClass += " group-collapsed" }}
	}
	<div id={ fmt.Sprintf("group-%d", g.ID) } class={ groupClass } data-group data-group-id={ fmt.Sprintf("%d", g.ID) }>
		@BudgetGroupHeader(month, g)
		for _, r := range g.Rows {
			@BudgetRow(month, r)
		}
	</div>
}

templ BudgetGroupHeader(month string, g BudgetGroup) {
	@budgetGroupHeader(month, g, false)
}

// budgetGroupHeader renders a group's header. When oob is true it carries
// hx-swap-oob so a response can refresh it out of band (used after adding the
// first category to a group, to drop the "delete empty group" control). Unlike
// the old <tr> version this needs no <template> wrapper — a div swaps in
// directly.
templ budgetGroupHeader(month string, g BudgetGroup, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("group-head-%d", g.ID), "data-group-head": ""} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div class="flex items-center gap-s2 px-s3 pb-s1 pt-s3" { attrs... }>
		<span
			class="js-group-handle inline-flex cursor-grab touch-none items-center text-warm-400 hover:text-foreground"
			title={ i18n.T(ctx, "budget.drag_group") }
			aria-hidden="true"
		>
			@icon.GripVertical(icon.Props{Class: "size-4"})
		</span>
		<button
			type="button"
			class="inline-flex items-center rounded-sm hover:text-foreground"
			data-collapse-group={ fmt.Sprintf("%d", g.ID) }
			title={ i18n.T(ctx, "budget.collapse_group") }
			aria-label={ i18n.T(ctx, "budget.toggle_group") }
		>
			@icon.ChevronRight(icon.Props{Class: "js-group-caret size-4 text-muted-foreground transition-transform"})
		</button>
		<form
			hx-put={ fmt.Sprintf("/budget/group/%d?month=%s", g.ID, month) }
			hx-target={ fmt.Sprintf("#group-head-%d", g.ID) }
			hx-swap="outerHTML"
			class="flex min-w-0 items-center"
		>
			<button
				type="button"
				class="js-name-display cursor-text truncate rounded-sm px-1 py-0.5 font-heading text-[17px] font-semibold ring-1 ring-transparent hover:ring-border"
				title={ i18n.T(ctx, "common.click_to_rename") }
			>
				{ g.Name }
			</button>
			<input
				type="text"
				name="name"
				value={ g.Name }
				autocomplete="off"
				class="js-name-input hidden h-9 w-[220px] rounded-pill border border-primary bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-ring"
			/>
		</form>
		<div class="ml-auto flex shrink-0 items-center gap-s2">
			{{ avail := groupAvailableTotal(g.Rows) }}
			<span class="js-group-total-header">
				<span class={ "js-group-total-value text-[13px] font-bold tabular-nums", availColorClass(avail) }>
					{ money.Format(ctx, avail) }
				</span>
			</span>
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "rounded-pill text-muted-foreground hover:text-foreground",
				Attributes: templ.Attributes{
					"hx-get":      fmt.Sprintf("/budget/group/%d/category/new?month=%s", g.ID, month),
					"hx-target":   fmt.Sprintf("#group-%d", g.ID),
					"hx-swap":     "beforeend",
					"title":       i18n.T(ctx, "budget.add_category"),
					"hx-on:click": fmt.Sprintf("document.getElementById('group-%d').classList.remove('group-collapsed')", g.ID),
				},
			}) {
				{ i18n.T(ctx, "budget.add_category") }
			}
			if len(g.Rows) == 0 {
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Class:   "rounded-pill text-muted-foreground hover:text-money-negative",
					Attributes: templ.Attributes{
						"hx-post":    fmt.Sprintf("/budget/group/%d/delete?month=%s", g.ID, month),
						"hx-target":  "#budget-region",
						"hx-swap":    "outerHTML",
						"hx-confirm": i18n.T(ctx, "budget.delete_empty_group_confirm"),
						"title":      i18n.T(ctx, "budget.delete_empty_group"),
					},
				}) {
					@icon.X(icon.Props{Class: "size-4"})
				}
			}
		</div>
	</div>
}

// BudgetGroupNewRow is the transient editable group inserted by "Add group".
// name-edit.js submits it on Enter/blur or removes it if left empty.
templ BudgetGroupNewRow() {
	<div data-newrow class="px-s3 py-s2">
		<form hx-post="/budget/group" hx-target="closest [data-newrow]" hx-swap="outerHTML" class="flex items-center">
			<input
				type="text"
				name="name"
				autocomplete="off"
				autofocus
				placeholder={ i18n.T(ctx, "budget.new_group_placeholder") }
				class="js-name-new h-9 w-[220px] rounded-pill border border-primary bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-ring"
			/>
		</form>
	</div>
}

func budgetTotals(groups []BudgetGroup) (assigned, spent, available int64) {
	for _, g := range groups {
		for _, r := range g.Rows {
			assigned += r.AssignedCents
			spent += r.SpentCents
			available += r.AvailableCents
		}
	}
	return
}

// groupAvailableTotal sums a group's category Available so a collapsed group
// header can show one figure.
func groupAvailableTotal(rows []store.CategoryBudget) (total int64) {
	for _, r := range rows {
		total += r.AvailableCents
	}
	return
}

// availColorClass tints an Available figure the same way the signedmoney
// component does, using the same money-* tokens: positive sage, negative
// terracotta, zero warm neutral. The tokens flip in .dark, so no dark: variant
// is needed. section-collapse.js mirrors this when it re-sums on collapse —
// keep the two in step.
func availColorClass(cents int64) string {
	switch {
	case cents > 0:
		return "text-money-positive"
	case cents < 0:
		return "text-money-negative"
	default:
		return "text-money-zero"
	}
}
