package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/web/components/signedmoney"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/table"
)

templ BudgetTable(d BudgetData) {
	<div class="overflow-hidden rounded-xl border bg-card shadow-xs">
		@table.Table() {
		@BudgetIncomeSection(d)
		@BudgetCreditSection(d)
		<tbody id="budget-expenses-head">
			@table.Row(table.RowProps{Class: "bg-muted hover:bg-muted"}) {
				@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2 align-middle"}}) {
					<div class="flex items-center gap-2">
						<span class="px-1 py-0.5 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Expenses</span>
						@button.Button(button.Props{
							Type:    "button",
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Class:   "ml-auto text-muted-foreground hover:text-foreground",
							Attributes: templ.Attributes{
								"hx-get":    "/budget/group/new",
								"hx-target": "#budget-totals-body",
								"hx-swap":   "beforebegin",
								"title":     "Add category group",
							},
						}) {
							Add Group
						}
					</div>
				}
			}
			@subHeaderRow("Category", "Assigned", "Spent", "Available", "Goal")
		</tbody>
		<tbody id="budget-uncategorized-body">
			@table.Row() {
				@table.Cell(table.CellProps{Class: "pl-6 text-muted-foreground"}) { Uncategorized }
				@table.Cell() {}
				@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums"}) { { money.Format(d.UncategorizedSpent) } }
				@table.Cell() {}
				@table.Cell() {}
				@table.Cell() {}
			}
		</tbody>
		for _, g := range d.Groups {
			@BudgetGroupTbody(d.Month, g)
		}
		@BudgetSummary(d, false)
		}
	</div>
}

// subHeaderRow renders a section's column-label row (Income / Credit / Expenses
// each get their own instead of one shared table header). The first column (the
// name) carries the 34% width the old table header used and stays left-aligned;
// the money columns (indexes 1–3: Amount/Assigned/Spent/Available, Purchases/
// Payments/Owing) are right-aligned with a pr-4 inset so they line up with the
// right-aligned figures below; any trailing text column (Goal) stays left.
// Remaining columns are padded to the table's 6-column grid.
templ subHeaderRow(labels ...string) {
	@table.Row() {
		for i, l := range labels {
			if i == 0 {
				@table.Cell(table.CellProps{Class: "w-[34%] pl-6 text-xs font-medium uppercase tracking-wide text-muted-foreground"}) {
					{ l }
				}
			} else if i <= 3 {
				@table.Cell(table.CellProps{Class: "text-right pr-4 text-xs font-medium uppercase tracking-wide text-muted-foreground"}) {
					{ l }
				}
			} else {
				@table.Cell(table.CellProps{Class: "text-xs font-medium uppercase tracking-wide text-muted-foreground"}) {
					{ l }
				}
			}
		}
		for i := len(labels); i < 6; i++ {
			@table.Cell()
		}
	}
}

templ BudgetGroupTbody(month string, g BudgetGroup) {
	<tbody id={ fmt.Sprintf("group-%d", g.ID) }>
		@BudgetGroupHeader(month, g)
		for _, r := range g.Rows {
			@BudgetRow(month, r)
		}
	</tbody>
}

templ BudgetGroupHeader(month string, g BudgetGroup) {
	@budgetGroupHeader(month, g, false)
}

// budgetGroupHeader renders a group's header row. When oob is true the <tr>
// carries hx-swap-oob so a response can refresh it out of band (used after
// adding the first category to a group, to drop the "delete empty group"
// control). An OOB bare <tr> must be wrapped in a <template> by the caller.
templ budgetGroupHeader(month string, g BudgetGroup, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("group-head-%d", g.ID)} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Class: "bg-muted/20 hover:bg-muted/20", Attributes: attrs}) {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2 align-middle"}}) {
			<div class="flex items-center gap-2">
				<form
					hx-put={ fmt.Sprintf("/budget/group/%d?month=%s", g.ID, month) }
					hx-target={ fmt.Sprintf("#group-head-%d", g.ID) }
					hx-swap="outerHTML"
					class="flex items-center"
				>
					<button
						type="button"
						class="js-name-display cursor-text rounded-md px-1 py-0.5 text-xs font-semibold uppercase tracking-wide text-muted-foreground ring-1 ring-transparent hover:ring-border"
						title="Click to rename"
					>
						{ g.Name }
					</button>
					<input
						type="text"
						name="name"
						value={ g.Name }
						autocomplete="off"
						class="js-name-input hidden h-7 w-56 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "ml-auto text-muted-foreground hover:text-foreground",
					Attributes: templ.Attributes{
						"hx-get":    fmt.Sprintf("/budget/group/%d/category/new?month=%s", g.ID, month),
						"hx-target": fmt.Sprintf("#group-%d", g.ID),
						"hx-swap":   "beforeend",
						"title":     "Add category",
					},
				}) {
					Add Category
				}
				if len(g.Rows) == 0 {
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantGhost,
						Size:    button.SizeSm,
						Class:   "text-muted-foreground hover:text-destructive",
						Attributes: templ.Attributes{
							"hx-post":    fmt.Sprintf("/budget/group/%d/delete?month=%s", g.ID, month),
							"hx-target":  "#budget-region",
							"hx-swap":    "outerHTML",
							"hx-confirm": "Delete this empty group?",
							"title":      "Delete empty group",
						},
					}) {
						@icon.X(icon.Props{Class: "size-4"})
					}
				}
			</div>
		}
	}
}

// BudgetGroupNewRow is the transient editable <tbody> inserted by "+ group".
// name-edit.js submits it on Enter/blur or removes it if left empty.
templ BudgetGroupNewRow() {
	<tbody data-newrow>
		@table.Row() {
			@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2"}}) {
				<form hx-post="/budget/group" hx-target="closest tbody" hx-swap="outerHTML" class="flex items-center">
					<input
						type="text"
						name="name"
						autocomplete="off"
						autofocus
						placeholder="New group name"
						class="js-name-new h-7 w-56 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
			}
		}
	</tbody>
}

// BudgetSummary is the footer "where you are" block, living inside the table's
// #budget-totals-body tbody so it stays in the column grid and Add Group can
// still insert new groups before it. An assignment or income change refreshes it
// via an out-of-band swap of the whole tbody (oob=true); the tbody is wrapped in
// a <template> so htmx's OOB swap survives the browser's table-parsing rules.
templ BudgetSummary(d BudgetData, oob bool) {
	if oob {
		<template>
			<tbody id="budget-totals-body" hx-swap-oob="true">
				@budgetSummaryRows(d)
			</tbody>
		</template>
	} else {
		<tbody id="budget-totals-body">
			@budgetSummaryRows(d)
		</tbody>
	}
}

// budgetSummaryRows lays out the totals and the "where you are" difference in
// the table's columns: the Assigned/Spent/Available totals, then Income and
// Left to assign (= income − budgeted) stacked under the Assigned column.
templ budgetSummaryRows(d BudgetData) {
	{{ assigned, spent, available := budgetTotals(d.Groups) }}
	@table.Row(table.RowProps{Class: "border-t-4 border-double border-muted-foreground/40"}) {
		@table.Cell(table.CellProps{Class: "font-semibold"}) {
			Totals
		}
		@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums font-semibold"}) {
			{ money.Format(assigned) }
		}
		@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums font-semibold"}) {
			{ money.Format(spent) }
		}
		@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums font-semibold"}) {
			@signedmoney.Money(available)
		}
		@table.Cell()
		@table.Cell()
	}
	@table.Row() {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			Income
		}
		@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums font-medium text-emerald-600 dark:text-emerald-400"}) {
			{ money.Format(d.Estimated) }
		}
		@table.Cell()
		@table.Cell()
		@table.Cell()
		@table.Cell()
	}
	@table.Row() {
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
			Left to assign
		}
		@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums"}) {
			@signedmoney.Money(d.Remain)
		}
		@table.Cell()
		@table.Cell()
		@table.Cell()
		@table.Cell()
	}
}

func budgetTotals(groups []BudgetGroup) (assigned, spent, available int64) {
	for _, g := range groups {
		for _, r := range g.Rows {
			assigned += r.AssignedCents
			spent += r.SpentCents
			available += r.AvailableCents
		}
	}
	return
}
