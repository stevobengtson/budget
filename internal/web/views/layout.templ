package views

import (
	"fmt"
	"strings"

	"github.com/templui/templui/components/checkbox"
	"github.com/templui/templui/components/collapsible"
	"github.com/templui/templui/components/datepicker"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	"github.com/templui/templui/components/selectbox"
	"github.com/templui/templui/components/sheet"
	"github.com/templui/templui/components/sidebar"
	"github.com/templui/templui/components/skeleton"
	"github.com/templui/templui/components/tabs"
	"github.com/templui/templui/components/tooltip"
)

// Layout is the outer HTML shell. Pages embed their content via children.
templ Layout(title string, active string, collapsed bool) {
	<!DOCTYPE html>
	<html lang="en">
		@headTag(title)
		<body class="min-h-screen bg-background text-foreground">
			@appShell(active, collapsed) {
				{ children... }
			}
		</body>
	</html>
}

// headTag is the shared <head> for every signed-in shell — the theme bootstrap,
// stylesheet, and the templUI component scripts. Extracted so the admin console
// (AdminLayout) gets exactly the same assets without a second copy of this list
// that would quietly fall behind.
templ headTag(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } · Pigglet</title>
		<script>
				(function () {
					var t = localStorage.getItem("theme") || "system";
					if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
						document.documentElement.classList.add("dark");
					}
				})();
			</script>
		<link rel="stylesheet" href={ Asset("/static/app.css") }/>
		<link rel="icon" type="image/svg+xml" href={ Asset("/static/favicon.svg") }/>
		<script src={ Asset("/static/htmx.min.js") }></script>
		<script src={ Asset("/static/sortable.min.js") }></script>
		<script src={ Asset("/static/inline-edit.js") }></script>
		<script src={ Asset("/static/name-edit.js") }></script>
		<script src={ Asset("/static/group-sort.js") }></script>
		<script src={ Asset("/static/category-sort.js") }></script>
		<script src={ Asset("/static/quick-add.js") } defer></script>
		@input.Script()
		@checkbox.Script()
		@dialog.Script()
		@datepicker.Script()
		@dropdown.Script()
		@selectbox.Script()
		@label.Script()
		@collapsible.Script()
		@sidebar.Script()
		@sheet.Script()
		@tooltip.Script()
		@tabs.Script()
		<script src={ Asset("/static/collapsible-persist.js") }></script>
		<script src={ Asset("/static/section-collapse.js") }></script>
		<script src={ Asset("/static/theme-toggle.js") }></script>
		<script src={ Asset("/static/error-flash.js") } defer></script>
	</head>
}

// appShell is the signed-in chrome. At >=768px it is the full sidebar — brand,
// primary nav, account summary, user menu — collapsing to a 72px icon rail whose
// state persists in the templUI-written sidebar_state cookie. Below 768px the
// sidebar is hidden entirely and a bottom tab bar takes over; the account
// summary reappears inside the Budget page there (see BudgetRegion).
//
// The design presents each screen as a rounded, shadowed card on a canvas. That
// framing belongs to the canvas, not the product — a real full-viewport app has
// nothing to float above — so the shell fills the window.
templ appShell(active string, collapsed bool) {
	// The id MUST be given to Layout as well as Sidebar, not just Sidebar.
	// Layout is what publishes the sidebar id into the context, and Trigger reads
	// it from there to build its data-tui-sidebar-target. Setting the id on only
	// Sidebar renames the wrapper but leaves Layout's generated random id in the
	// context, so the trigger points at an element that no longer exists and the
	// collapse button silently does nothing.
	@sidebar.Layout(sidebar.LayoutProps{ID: "app-rail"}) {
		@sidebar.Sidebar(sidebar.Props{
			ID:          "app-rail",
			Collapsible: sidebar.CollapsibleIcon,
			Collapsed:   collapsed,
			// templUI hardcodes the icon-mode collapsed width to w-12 (48px).
			// The design calls for 72px, so override it at the same variant
			// specificity — TwMerge keeps the later class on a conflict.
			Class: "group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:w-[72px] border-r-0",
			Attributes: templ.Attributes{
				"style": "--sidebar-width:19rem",
			},
		}) {
			@sidebar.Header() {
				<div class="flex items-center gap-s2 px-s2 py-s1 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:px-0 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:justify-center">
					@sidebar.Trigger()
					<span class="font-heading text-[22px] font-semibold text-brand group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden">
						Pigglet
					</span>
				</div>
			}
			@sidebar.Content() {
				@sidebar.Group() {
					@PrimaryNav(active, false)
				}
				@sidebar.Group(sidebar.GroupProps{Class: "group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden"}) {
					@sidebar.GroupLabel() {
						Accounts
					}
					@accountsPanel("sidebar-overview")
				}
			}
			@sidebar.Footer() {
				@sidebar.Menu() {
					@sidebar.MenuItem() {
						@userMenu()
					}
				}
			}
		}
		@sidebar.Inset() {
			// The sidebar is hidden below 768px, so the user menu needs a home on
			// mobile or Settings, Billing, Theme and Log out become unreachable.
			// The design specifies only three tabs, so it goes here rather than
			// becoming a fourth. Not designed — confirm the placement.
			<div class="flex items-center justify-between px-s3 pt-s3 md:hidden">
				<span class="font-heading text-[22px] font-semibold text-brand">Pigglet</span>
				@userMenu()
			</div>
			<main id="main" class="min-w-0 p-s3 pb-[96px] sm:p-s6 md:pb-s6">
				{ children... }
			</main>
			<div id="modal" class="modal-mount"></div>
			<div id="flash"></div>
		}
	}
	@tabBar(active)
}

// PrimaryNav is the sidebar's nav menu. It is a component with a stable id
// because its contents depend on which add-ons are enabled: toggling one only
// swaps the Add-ons section of the settings page, so the nav is refreshed out of
// band from there (oob=true) rather than waiting for the next full page load.
templ PrimaryNav(active string, oob bool) {
	{{ attrs := templ.Attributes{"id": "primary-nav"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div { attrs... }>
		@sidebar.Menu() {
			@navItem("budget", "Budget", icon.Wallet(icon.Props{Class: "size-[18px]"}), active)
			// Transactions is reached through the account list below — "All
			// Accounts" heads it — rather than as its own nav entry, so the sidebar
			// names places to be, not a second route to the same screen. That list
			// is hidden in the collapsed icon rail though, so the rail keeps its own
			// way in.
			@collapsedOnlyNavItem("transactions", "All Accounts", icon.List(icon.Props{Class: "size-[18px]"}), active)
			if AddOnEnabled(ctx, "paydown") {
				@navItem("paydown", "Paydown", icon.TrendingDown(icon.Props{Class: "size-[18px]"}), active)
			}
		}
	</div>
}

// navItem is one primary-nav entry. Active is a solid terracotta pill with a
// light label; inactive is plain text. The icon stays visible when the sidebar
// collapses to the icon rail; the label truncates away and returns as a tooltip.
templ navItem(slug string, label string, ic templ.Component, active string) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Href:     "/" + slug,
			IsActive: slug == active,
			Tooltip:  label,
			Class:    navItemClass(slug == active),
			Attributes: templ.Attributes{
				"aria-current": templ.KV("page", slug == active),
			},
		}) {
			@ic
			<span>{ label }</span>
		}
	}
}

// collapsedOnlyNavItem appears solely in the collapsed icon rail. Expanded, the
// account list carries "All Accounts" and this would be a duplicate; collapsed,
// that list is hidden and this is the only route to the transactions screen.
templ collapsedOnlyNavItem(slug string, label string, ic templ.Component, active string) {
	@sidebar.MenuItem(sidebar.MenuItemProps{
		Class: "hidden group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:block",
	}) {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Href:     "/" + slug,
			IsActive: slug == active,
			Tooltip:  label,
			Class:    navItemClass(slug == active),
			Attributes: templ.Attributes{
				"aria-current": templ.KV("page", slug == active),
			},
		}) {
			@ic
			<span>{ label }</span>
		}
	}
}

// navItemClass styles the nav pill. templUI's active state paints
// sidebar-accent, which on the cream ground is nearly invisible, so the active
// entry takes the accent fill outright.
func navItemClass(isActive bool) string {
	base := "rounded-pill h-10 gap-s2 px-s3 font-medium"
	if isActive {
		return base + " bg-primary text-primary-foreground hover:bg-primary-hover hover:text-primary-foreground active:bg-primary-active"
	}
	return base + " text-foreground hover:bg-primary/10"
}

// tabBar is the <768px counterpart to the rail. Three tabs only, per the design;
// each meets the 48px minimum touch target. "Transactions" reads as "Activity"
// here because the label sits under a 22px icon at 11px.
templ tabBar(active string) {
	@tabBarNav(active, false)
}

// tabBarNav is the <768px nav, separated out for the same reason as PrimaryNav:
// an add-on toggle changes which tabs exist and refreshes it out of band.
templ tabBarNav(active string, oob bool) {
	{{ attrs := templ.Attributes{"id": "tab-bar"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<nav
		{ attrs... }
		aria-label="Primary"
		class="fixed inset-x-0 bottom-0 z-40 flex justify-around rounded-t-[30px] bg-card px-s3 pt-s2 pb-s4 shadow-organic-lg md:hidden"
	>
		@tabItem("budget", "Budget", icon.Wallet(icon.Props{Class: "size-[22px]"}), active)
		@tabItem("transactions", "Activity", icon.List(icon.Props{Class: "size-[22px]"}), active)
		if AddOnEnabled(ctx, "paydown") {
			@tabItem("paydown", "Paydown", icon.TrendingDown(icon.Props{Class: "size-[22px]"}), active)
		}
	</nav>
}

templ tabItem(slug string, label string, ic templ.Component, active string) {
	<a
		href={ templ.SafeURL("/" + slug) }
		if slug == active {
			aria-current="page"
			class="flex min-h-[48px] min-w-[72px] flex-col items-center justify-center gap-1 rounded-sm text-brand"
		} else {
			class="flex min-h-[48px] min-w-[72px] flex-col items-center justify-center gap-1 rounded-sm text-foreground"
		}
	>
		@ic
		<span class="text-[11px] font-bold">{ label }</span>
	</a>
}

// accountsPanel mounts the account list. It renders twice — in the desktop
// sidebar and, because the sidebar is hidden below 768px, on the Budget page for
// mobile — so the mount id is a parameter. Both fetch the same fragment and both
// refresh on accountsChanged; the fragment itself carries no id (see
// data-accounts-overview) so the duplication stays valid.
templ accountsPanel(mountID string) {
	<div
		id={ mountID }
		hx-get="/accounts/overview"
		hx-trigger="load, accountsChanged from:body"
		hx-swap="innerHTML"
	>
		<div class="w-full space-y-2">
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-2/3"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/3"})
		</div>
	</div>
}

// userMenu is the account control in the sidebar footer: the signed-in name and
// email opening a popover with a Theme submenu, Settings, Billing and Log out.
// The name and email come from the request context (set by requireAuth). When
// the sidebar collapses to the icon rail the text drops away and only the avatar
// remains; the same component also serves the mobile top bar, where there is no
// collapsed sidebar ancestor so the text always shows.
templ userMenu() {
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class: "flex h-12 w-full items-center gap-s2 rounded-pill px-1.5 text-sm hover:bg-primary/10 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:w-auto group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:justify-center",
		}) {
			@userAvatar(UserNameFromContext(ctx), UserAvatarVersionFromContext(ctx), "size-8 rounded-pill text-xs")
			<div class="grid min-w-0 flex-1 text-left leading-tight group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden">
				<span class="truncate font-medium">{ UserNameFromContext(ctx) }</span>
				<span class="truncate text-xs text-muted-foreground">{ UserEmailFromContext(ctx) }</span>
			</div>
			@icon.ChevronsUpDown(icon.Props{Class: "size-4 shrink-0 text-muted-foreground group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden"})
		}
		@dropdown.Content(dropdown.ContentProps{Class: "w-64", Placement: dropdown.PlacementTopStart}) {
			<div class="flex items-center gap-2 px-2 py-1.5 text-sm">
				@userAvatar(UserNameFromContext(ctx), UserAvatarVersionFromContext(ctx), "size-8 rounded-lg text-xs")
				<div class="grid min-w-0 flex-1 text-left leading-tight">
					<span class="truncate font-medium">{ UserNameFromContext(ctx) }</span>
					<span class="truncate text-xs text-muted-foreground">{ UserEmailFromContext(ctx) }</span>
				</div>
			</div>
			@dropdown.Separator()
			@dropdown.Sub() {
				@dropdown.SubTrigger() {
					<span class="flex items-center gap-2">
						@icon.Sun(icon.Props{Class: "size-4"})
						Theme
					</span>
				}
				@dropdown.SubContent() {
					@themeOption("system", "System", icon.Monitor(icon.Props{Class: "size-4"}))
					@themeOption("light", "Light", icon.Sun(icon.Props{Class: "size-4"}))
					@themeOption("dark", "Dark", icon.Moon(icon.Props{Class: "size-4"}))
				}
			}
			@dropdown.Item(dropdown.ItemProps{Href: "/account"}) {
				<span class="flex items-center gap-2">
					@icon.Settings(icon.Props{Class: "size-4"})
					Settings
				</span>
			}
			@dropdown.Item(dropdown.ItemProps{Href: "/account?tab=billing"}) {
				<span class="flex items-center gap-2">
					@icon.CreditCard(icon.Props{Class: "size-4"})
					Billing
				</span>
			}
			if IsAdmin(ctx) {
				@dropdown.Separator()
				@dropdown.Item(dropdown.ItemProps{Href: "/admin"}) {
					<span class="flex items-center gap-2">
						@icon.Shield(icon.Props{Class: "size-4"})
						Admin
					</span>
				}
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class:      "text-destructive",
				Attributes: templ.Attributes{"hx-post": "/logout"},
			}) {
				<span class="flex items-center gap-2">
					@icon.LogOut(icon.Props{Class: "size-4"})
					Log out
				</span>
			}
		}
	}
}

// userAvatar renders the user's profile picture: the stored image when
// avatarVersion > 0 (cache-busted by the version), otherwise a monogram of their
// initials on a muted rounded square. class sets the size and radius/text-size.
templ userAvatar(name string, avatarVersion int64, class string) {
	if avatarVersion > 0 {
		<img
			src={ fmt.Sprintf("/account/avatar?v=%d", avatarVersion) }
			alt="Avatar"
			class={ "shrink-0 overflow-hidden rounded-lg object-cover " + class }
		/>
	} else {
		<span class={ "inline-flex shrink-0 select-none items-center justify-center overflow-hidden rounded-lg bg-muted font-medium text-foreground " + class }>
			{ userInitials(name) }
		</span>
	}
}

// userInitials derives up to two uppercase initials from a display name (first
// letter of the first and last words), falling back to "U".
func userInitials(name string) string {
	fields := strings.Fields(name)
	if len(fields) == 0 {
		return "U"
	}
	first := []rune(fields[0])
	if len(fields) == 1 {
		return strings.ToUpper(string(first[0]))
	}
	last := []rune(fields[len(fields)-1])
	return strings.ToUpper(string(first[0]) + string(last[0]))
}

// themeOption is one row of the Theme submenu. It stays open on click
// (PreventClose) so the active check updates in place; theme-toggle.js persists
// the choice and toggles the check.
templ themeOption(value string, label string, ic templ.Component) {
	@dropdown.Item(dropdown.ItemProps{
		PreventClose: true,
		Attributes: templ.Attributes{
			"onclick":           "setTheme('" + value + "')",
			"data-theme-option": value,
		},
	}) {
		<span class="flex items-center gap-2">
			@ic
			{ label }
		</span>
		<span data-theme-check class="invisible">
			@icon.Check(icon.Props{Class: "size-4"})
		</span>
	}
}

// dialogPanel renders the inner modal card that htmx swaps into #modal.
// It stands in for templUI's dialog.Content, which renders a native <dialog>
// with its own backdrop, fixed positioning and a
// JS-driven close button, which is incompatible with this app's
// htmx-swap-into-#modal open/close flow (the .modal-mount wrapper supplies the
// backdrop; closing empties #modal). This keeps the same card markup and lets
// #modal own the overlay.
templ dialogPanel(class string) {
	<div
		role="dialog"
		aria-modal="true"
		class={ "relative grid w-full max-w-lg gap-4 rounded-lg border bg-background p-6 shadow-lg sm:rounded-lg", class }
	>
		{ children... }
	</div>
}

// sheetPanel is the sheet counterpart to dialogPanel: a right-anchored,
// full-height panel that slides in from the right. It positions itself fixed so
// it escapes the .modal-mount flex centering, letting sheet and centered-dialog
// modals share the same #modal backdrop. Same htmx flow: htmx swaps the rendered
// fragment into #modal; closing empties #modal.
templ sheetPanel(class string) {
	<div
		role="dialog"
		aria-modal="true"
		class={ "animate-sheet-in fixed inset-y-0 right-0 flex h-full w-full max-w-md flex-col gap-4 overflow-y-auto border-l bg-background p-6 shadow-lg", class }
	>
		{ children... }
	</div>
}

templ FlashOK(msg string) {
	<div id="flash" class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full bg-primary px-4 py-2 font-medium text-primary-foreground shadow" hx-swap-oob="true">
		@icon.Check(icon.Props{Class: "size-4"})
		{ msg }
	</div>
}

templ FlashErr(msg string) {
	<div id="flash" class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full bg-destructive px-4 py-2 font-medium text-destructive-foreground shadow" hx-swap-oob="true">
		@icon.TriangleAlert(icon.Props{Class: "size-4"})
		{ msg }
	</div>
}
