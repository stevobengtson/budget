package views

import (
	"strings"

	"github.com/templui/templui/components/checkbox"
	"github.com/templui/templui/components/collapsible"
	"github.com/templui/templui/components/datepicker"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	"github.com/templui/templui/components/selectbox"
	"github.com/templui/templui/components/sheet"
  "github.com/templui/templui/components/skeleton"
	"github.com/templui/templui/components/sidebar"
	"github.com/templui/templui/components/tabs"
	"github.com/templui/templui/components/tooltip"
)

// Layout is the outer HTML shell. Pages embed their content via children.
templ Layout(title string, active string, collapsed bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Pigglet</title>
			<script>
				(function () {
					var t = localStorage.getItem("theme") || "system";
					if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
						document.documentElement.classList.add("dark");
					}
				})();
			</script>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/sortable.min.js"></script>
			<script src="/static/inline-edit.js"></script>
			<script src="/static/name-edit.js"></script>
			<script src="/static/group-sort.js"></script>
			<script src="/static/category-sort.js"></script>
			@input.Script()
			@checkbox.Script()
			@dialog.Script()
			@datepicker.Script()
			@dropdown.Script()
			@selectbox.Script()
			@label.Script()
			@collapsible.Script()
			@sidebar.Script()
			@sheet.Script()
			@tooltip.Script()
			@tabs.Script()
			<script src="/static/collapsible-persist.js"></script>
			<script src="/static/section-collapse.js"></script>
			<script src="/static/theme-toggle.js"></script>
		</head>
		<body class="min-h-screen bg-background text-foreground">
      @appSidebar(collapsed, active) { { children... } }
		</body>
	</html>
}

templ appSidebar(collapsed bool, active string) {
  @sidebar.Layout() {
    @sidebar.Sidebar(sidebar.Props{
      Variant: sidebar.VariantInset,
      Collapsible: sidebar.CollapsibleIcon,
      Collapsed: collapsed,
      Attributes: templ.Attributes{
        "style": "--sidebar-width:20rem", // Any CSS unit works: px, %, vw, etc.
      },
    }) {
      @sidebar.Header() {
        <div class="flex items-center gap-2 px-1">
          @sidebar.Trigger()
          <span class="text-lg font-semibold group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden">Pigglet</span>
        </div>
      }
      @sidebar.Content() {
        @sidebar.Group() {
          @sidebar.Menu() {
            @navItem("budget", "Budget", icon.Wallet(icon.Props{Class: "size-4"}), active)
            @navItem("paydown", "Paydown", icon.TrendingDown(icon.Props{Class: "size-4"}), active)
          }
        }
        @sidebar.Separator(sidebar.SeparatorProps{Class: "group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden"})
        @sidebar.Group(sidebar.GroupProps{Class: "group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden"}) {
          <div
            id="sidebar-overview"
            hx-get="/accounts/overview"
            hx-trigger="load, accountsChanged from:body"
            hx-swap="innerHTML"
          >
            <div class="space-y-2 w-full max-w-sm">
              @skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full"})
              @skeleton.Skeleton(skeleton.Props{Class: "h-4 w-2/3"})
              @skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/3"})
              @skeleton.Skeleton(skeleton.Props{Class: "h-4 w-2/3"})
              @skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/3"})
              @skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/3"})
            </div>
          </div>
        }
      }
      @sidebar.Footer() {
        @sidebar.Menu() {
          @sidebar.MenuItem() {
            @userMenu()
          }
        }
      }
    }
    @sidebar.Inset() {
      <div id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-4 sm:px-6 sm:py-6">
        { children... }
      </div>
      <div id="modal" class="modal-mount"></div>
      <div id="flash"></div>
    }
  }
}


// navItem renders one primary-nav entry as a sidebar menu button. The icon stays
// visible in the collapsed icon rail; the label truncates away and reappears as a
// tooltip.
templ navItem(slug string, label string, ic templ.Component, active string) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Href:     "/" + slug,
			IsActive: slug == active,
			Tooltip:  label,
		}) {
			@ic
			<span>{ label }</span>
		}
	}
}

// userMenu renders the sidebar footer account control: a trigger showing the
// signed-in email that opens a popover with a Theme submenu, Settings, and Log
// out. The email comes from the request context (set by requireAuth).
templ userMenu() {
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class: "flex h-12 w-full items-center gap-2 rounded-md px-1.5 text-sm hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
		}) {
			@userAvatar(UserNameFromContext(ctx), "size-8 rounded-lg text-xs")
			<div class="grid min-w-0 flex-1 text-left leading-tight group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden">
				<span class="truncate font-medium">{ UserNameFromContext(ctx) }</span>
				<span class="truncate text-xs text-muted-foreground">{ UserEmailFromContext(ctx) }</span>
			</div>
			@icon.ChevronsUpDown(icon.Props{Class: "size-4 shrink-0 text-muted-foreground group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden"})
		}
		@dropdown.Content(dropdown.ContentProps{Class: "w-64", Placement: dropdown.PlacementTopStart}) {
			<div class="flex items-center gap-2 px-2 py-1.5 text-sm">
				@userAvatar(UserNameFromContext(ctx), "size-8 rounded-lg text-xs")
				<div class="grid min-w-0 flex-1 text-left leading-tight">
					<span class="truncate font-medium">{ UserNameFromContext(ctx) }</span>
					<span class="truncate text-xs text-muted-foreground">{ UserEmailFromContext(ctx) }</span>
				</div>
			</div>
			@dropdown.Separator()
			@dropdown.Sub() {
				@dropdown.SubTrigger() {
					<span class="flex items-center gap-2">
						@icon.Sun(icon.Props{Class: "size-4"})
						Theme
					</span>
				}
				@dropdown.SubContent() {
					@themeOption("system", "System", icon.Monitor(icon.Props{Class: "size-4"}))
					@themeOption("light", "Light", icon.Sun(icon.Props{Class: "size-4"}))
					@themeOption("dark", "Dark", icon.Moon(icon.Props{Class: "size-4"}))
				}
			}
			@dropdown.Item(dropdown.ItemProps{Href: "/account"}) {
				<span class="flex items-center gap-2">
					@icon.Settings(icon.Props{Class: "size-4"})
					Settings
				</span>
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class:      "text-destructive",
				Attributes: templ.Attributes{"hx-post": "/logout"},
			}) {
				<span class="flex items-center gap-2">
					@icon.LogOut(icon.Props{Class: "size-4"})
					Log out
				</span>
			}
		}
	}
}

// userAvatar renders a simple monogram avatar (the user's initials on a muted
// rounded square) as the default until stored avatars exist. class sets the size
// and any radius/text-size overrides.
templ userAvatar(name string, class string) {
	<span class={ "inline-flex shrink-0 select-none items-center justify-center overflow-hidden rounded-lg bg-muted font-medium text-foreground " + class }>
		{ userInitials(name) }
	</span>
}

// userInitials derives up to two uppercase initials from a display name (first
// letter of the first and last words), falling back to "U".
func userInitials(name string) string {
	fields := strings.Fields(name)
	if len(fields) == 0 {
		return "U"
	}
	first := []rune(fields[0])
	if len(fields) == 1 {
		return strings.ToUpper(string(first[0]))
	}
	last := []rune(fields[len(fields)-1])
	return strings.ToUpper(string(first[0]) + string(last[0]))
}

// themeOption is one row of the Theme submenu. It stays open on click
// (PreventClose) so the active check updates in place; theme-toggle.js persists
// the choice and toggles the check.
templ themeOption(value string, label string, ic templ.Component) {
	@dropdown.Item(dropdown.ItemProps{
		PreventClose: true,
		Attributes: templ.Attributes{
			"onclick":           "setTheme('" + value + "')",
			"data-theme-option": value,
		},
	}) {
		<span class="flex items-center gap-2">
			@ic
			{ label }
		</span>
		<span data-theme-check class="invisible">
			@icon.Check(icon.Props{Class: "size-4"})
		</span>
	}
}

// dialogPanel renders the inner modal card that htmx swaps into #modal.
// It stands in for templUI's dialog.Content, which renders a native <dialog>
// with its own backdrop, fixed positioning and a
// JS-driven close button, which is incompatible with this app's
// htmx-swap-into-#modal open/close flow (the .modal-mount wrapper supplies the
// backdrop; closing empties #modal). This keeps the same card markup and lets
// #modal own the overlay.
templ dialogPanel(class string) {
	<div
		role="dialog"
		aria-modal="true"
		class={ "relative grid w-full max-w-lg gap-4 rounded-lg border bg-background p-6 shadow-lg sm:rounded-lg", class }
	>
		{ children... }
	</div>
}

// sheetPanel is the sheet counterpart to dialogPanel: a right-anchored,
// full-height panel that slides in from the right. It positions itself fixed so
// it escapes the .modal-mount flex centering, letting sheet and centered-dialog
// modals share the same #modal backdrop. Same htmx flow: htmx swaps the rendered
// fragment into #modal; closing empties #modal.
templ sheetPanel(class string) {
	<div
		role="dialog"
		aria-modal="true"
		class={ "animate-sheet-in fixed inset-y-0 right-0 flex h-full w-full max-w-md flex-col gap-4 overflow-y-auto border-l bg-background p-6 shadow-lg", class }
	>
		{ children... }
	</div>
}

templ FlashOK(msg string) {
	<div id="flash" class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full bg-primary px-4 py-2 font-medium text-primary-foreground shadow" hx-swap-oob="true">
		@icon.Check(icon.Props{Class: "size-4"})
		{ msg }
	</div>
}

templ FlashErr(msg string) {
	<div id="flash" class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full bg-destructive px-4 py-2 font-medium text-destructive-foreground shadow" hx-swap-oob="true">
		@icon.TriangleAlert(icon.Props{Class: "size-4"})
		{ msg }
	</div>
}
