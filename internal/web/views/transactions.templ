package views

import (
	"fmt"
	"strconv"
	"time"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/monthselector"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/sbengtson/budget/internal/web/components/ui/buttongroup"
	"github.com/templui/templui/components/datepicker"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	switchcomp "github.com/templui/templui/components/switch"
	"github.com/templui/templui/components/table"
)

type TransactionsData struct {
	Rows          []store.Transaction
	Accounts      []store.AccountWithBalance
	Categories    []store.Category
	Groups        []store.CategoryGroup
	FilterAccount *int64

	// FilterCategory narrows the view to one category, set either by the filter
	// bar or by the budget page's "View Transactions" action.
	FilterCategory *int64
	FilterMonth    string // "YYYY-MM" or "" when viewing all months
	PrevMonth      string
	NextMonth          string
	Today              string // current month key, for the "today" jump button
	Page               int    // 1-based
	PageSize           int
	Total              int
}

templ TransactionsPage(d TransactionsData, collapsed bool) {
	@Layout("Transactions", "transactions", collapsed) {
		@TransactionsBody(d)
	}
}

templ TransactionsBody(d TransactionsData) {
	<div class="grid grid-cols-3 items-center gap-4 pb-2">
		<h1 class="text-2xl font-semibold tracking-tight">{ txMonthLabel(d.FilterMonth) }</h1>
		<div class="flex justify-center">
			@monthselector.MonthSelector(txMonthHref(d, d.PrevMonth), txMonthHref(d, d.Today), txMonthHref(d, d.NextMonth), d.FilterMonth == d.Today)
		</div>
		<div class="flex justify-end">
			@button.Button(button.Props{
				Href: "/transactions/new",
        Type: "button",
        Variant: button.VariantOutline,
				Size: button.SizeSm,
				Attributes: templ.Attributes{
					"hx-get":    "/transactions/new",
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
          "title": "Add transaction",
				},
			}) {
				Add transaction
			}
		</div>
	</div>
	@TxFilterBar(d)
	@table.Table(table.Props{Class: "mt-4"}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Date
				}
				@table.Head() {
					Category / Transfer 
				}
				@table.Head() {
					Payee 
				}
				@table.Head(table.HeadProps{Class: "text-right"}) {
					Outflow 
				}
				@table.Head(table.HeadProps{Class: "text-right"}) {
					Inflow 
				}
				@table.Head(table.HeadProps{Class: "text-center"}) {
					@icon.Check(icon.Props{Class: "size-4 inline text-muted-foreground"})
				}
				@table.Head()
			}
		}
		<tbody id="tx-rows" class="[&_tr:last-child]:border-0">
			@TxRows(d.Rows, d.Accounts, d.Categories)
		</tbody>
	}
	if d.Total > d.PageSize {
		<div class="mt-4 flex items-center gap-3 text-sm text-muted-foreground">
			if d.Page > 1 {
				@button.Button(button.Props{Href: transactionsPageHref(d, d.Page-1), Variant: button.VariantOutline, Size: button.SizeSm}) {
					‹ prev
				}
			}
			<span>page { strconv.Itoa(d.Page) } of { strconv.Itoa((d.Total + d.PageSize - 1) / d.PageSize) }</span>
			if d.Page * d.PageSize < d.Total {
				@button.Button(button.Props{Href: transactionsPageHref(d, d.Page+1), Variant: button.VariantOutline, Size: button.SizeSm}) {
					next ›
				}
			}
		</div>
	}
}

// TxFilterBar renders the category filter under the page header. It is a plain
// GET form to /transactions: picking a category re-requests the page with the
// active month and account carried in hidden fields, so the filter narrows the
// current view rather than replacing it.
//
// The auto-submit hangs off the hidden input templUI posts from (see
// SelectField) — templUI dispatches `change` there only on a user pick or the
// built-in clear button, never on init, so this can't loop on page load.
templ TxFilterBar(d TransactionsData) {
	<form method="get" action="/transactions" class="flex flex-wrap items-center gap-2 border-b border-border pb-3">
		if d.FilterMonth != "" {
			<input type="hidden" name="month" value={ d.FilterMonth }/>
		} else {
			<input type="hidden" name="all" value="1"/>
		}
		if d.FilterAccount != nil {
			<input type="hidden" name="account" value={ strconv.FormatInt(*d.FilterAccount, 10) }/>
		}
		@label.Label(label.Props{For: "filter-category", Class: "text-sm text-muted-foreground"}) {
			Category
		}
		@SelectField(SelectFieldProps{
			ID:         "filter-category",
			Name:       "category",
			Class:      "w-56",
			Attributes: templ.Attributes{"onchange": "this.form.requestSubmit()"},
		}, categoryFilterOptions(d.Categories, d.FilterCategory))
	</form>
}

// categoryFilterOptions lists the categories for the filter bar, led by an
// empty-valued "All categories" entry that clears the filter. Archived
// categories are included: they still label historical transactions, so a
// filter arriving from the budget stays correctly labelled after the category
// is archived.
func categoryFilterOptions(cats []store.Category, selected *int64) []Opt {
	out := make([]Opt, 0, len(cats)+1)
	out = append(out, Opt{Value: "", Label: "All categories", Selected: selected == nil})
	for _, c := range cats {
		out = append(out, Opt{
			Value:    strconv.FormatInt(c.ID, 10),
			Label:    c.Name,
			Selected: selected != nil && *selected == c.ID,
		})
	}
	return out
}

// TxRows renders the sorted transaction rows with day-change separators. Shared
// by the initial page render and the htmx refresh after a create/update so both
// produce identical, correctly ordered markup.
templ TxRows(rows []store.Transaction, accts []store.AccountWithBalance, cats []store.Category) {
	for i, t := range rows {
		if i > 0 && !sameDay(rows[i-1].Date, t.Date) {
			<tr><td colspan="7" class="h-2 bg-muted/30 p-0"></td></tr>
		}
		@TransactionRow(t, accts, cats, false)
	}
}

templ TransactionRow(t store.Transaction, accts []store.AccountWithBalance, cats []store.Category, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("tx-%d", t.ID)} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "whitespace-nowrap"}) {
			{ t.Date.Format("Jan 2, 2006") }
		}
		@table.Cell() {
			@TxCategoryCell(t, accts, cats)
		}
		@table.Cell() {
			if t.Payee != nil {
				{ *t.Payee }
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			if t.OutflowCents > 0 {
				<span class="text-destructive">{ money.Format(t.OutflowCents) }</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			if t.InflowCents > 0 {
				<span class="text-emerald-600 dark:text-emerald-400">{ money.Format(t.InflowCents) }</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-center"}) {
			@txClearCell(t)
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			@txRowMenu(t)
		}
	}
}

// txRowMenu renders the per-row three-dot actions menu (Edit / Delete),
// matching the budget page's rowMenu pattern.
templ txRowMenu(t store.Transaction) {
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class:      "inline-flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground",
			Attributes: templ.Attributes{"title": "Transaction actions"},
		}) {
			@icon.EllipsisVertical(icon.Props{Class: "size-4"})
		}
		@dropdown.Content() {
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-get":    fmt.Sprintf("/transactions/%d/edit", t.ID),
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
				},
			}) {
				Edit Transaction
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class: "text-destructive",
				Attributes: templ.Attributes{
					"hx-delete":  fmt.Sprintf("/transactions/%d", t.ID),
					"hx-target":  fmt.Sprintf("#tx-%d", t.ID),
					"hx-swap":    "outerHTML",
					"hx-confirm": "Delete Transaction?",
				},
			}) {
				Delete Transaction
			}
		}
	}
}

templ txClearCell(t store.Transaction) {
	{{ title := "Not cleared — click to clear" }}
	if t.Cleared {
		{{ title = "Cleared — click to unclear" }}
	}
	<span title={ title } class="inline-flex">
		@switchcomp.Switch(switchcomp.Props{
			Checked: t.Cleared,
			Attributes: templ.Attributes{
				"hx-post":    fmt.Sprintf("/transactions/%d/cleared", t.ID),
				"hx-target":  fmt.Sprintf("#tx-%d", t.ID),
				"hx-swap":    "outerHTML",
				"hx-trigger": "change",
			},
		})
	</span>
}

templ TxCategoryCell(t store.Transaction, accts []store.AccountWithBalance, cats []store.Category) {
	if t.TransferAccountID != nil {
		<span class="text-muted-foreground">
			if t.OutflowCents > 0 {
				→
			} else {
				←
			}
			{ accountName(accts, *t.TransferAccountID) }
		</span>
		if t.CategoryID != nil {
			<span class="text-muted-foreground">· </span>
			{ categoryName(cats, *t.CategoryID) }
		}
	} else if t.CategoryID != nil {
		{ categoryName(cats, *t.CategoryID) }
	} else {
		<span class="text-muted-foreground">(uncategorized)</span>
	}
}

templ TransactionForm(d TxFormData) {
	@sheetPanel("") {
		<form
			id="tx-form-inner"
			if d.Editing {
				hx-put={ fmt.Sprintf("/transactions/%d", d.ID) }
			} else {
				hx-post="/transactions"
			}
			hx-target="#tx-rows"
			hx-swap="innerHTML"
			class="grid gap-4"
		>
			@dialog.Header() {
				@dialog.Title() {
					if d.Editing {
						Edit transaction
					} else {
						New transaction
					}
				}
			}
			<div class="grid gap-3">
				@buttongroup.ButtonGroup(buttongroup.Props{
					ID:      "tx-type",
					Name:    "tx_type",
					Value:   txTypeOrDefault(d.TxType),
					Class:   "w-full",
					Options: txTypeOptions(d),
				})
				@formRow("tx-date", "Date") {
					@datepicker.DatePicker(datepicker.Props{
						ID:          "tx-date",
						Name:        "date",
						Value:       txDate(d.Date),
						Placeholder: "Select a date",
					})
				}
				@formRow("tx-account", "Account") {
					@SelectField(SelectFieldProps{ID: "tx-account", Name: "account_id", Required: true}, accountOptions(d.Accounts, d.AccountID))
				}
				<div class="tx-transfer-field">
					@formRow("tx-transfer", "Transfer to") {
						@SelectField(SelectFieldProps{ID: "tx-transfer", Name: "transfer_to", Placeholder: "(none)"}, transferOptions(d.Accounts, d.TransferAccountID))
					}
				</div>
				<div class="grid gap-1.5">
					@label.Label(label.Props{For: "tx-amount"}) {
						<span class="tx-amount-outflow">Outflow</span>
						<span class="tx-amount-inflow">Inflow</span>
					}
					<div class="[&>input]:w-full">
						@input.Input(input.Props{ID: "tx-amount", Name: "amount", Value: d.Amount, Placeholder: "0.00", Class: "tabular-nums"})
					</div>
				</div>
				@formRow("tx-category", "Category") {
					@SelectField(SelectFieldProps{ID: "tx-category", Name: "category_id", Placeholder: "(none)"}, categoryOptions(d.Categories, d.CategoryID))
				}
				@formRow("tx-payee", "Payee") {
					@input.Input(input.Props{ID: "tx-payee", Name: "payee", Value: d.Payee})
				}
				@formRow("tx-notes", "Notes") {
					@input.Input(input.Props{ID: "tx-notes", Name: "notes", Value: d.Notes})
				}
			</div>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Type:       "button",
					Attributes: templ.Attributes{"hx-on:click": "document.getElementById('modal').replaceChildren()"},
				}) {
					cancel
				}
				@button.Button(button.Props{Type: "submit"}) {
					save
				}
			}
		</form>
	}
}

templ formRow(id, text string) {
	<div class="grid gap-1.5">
		@label.Label(label.Props{For: id}) {
			{ text }
		}
		<div class="[&>input]:w-full [&>select]:w-full">
			{ children... }
		</div>
	</div>
}

type TxFormData struct {
	Editing           bool
	ID                int64
	TxType            string // "expense" | "income" | "transfer" (default expense)
	Date              string // YYYY-MM-DD
	AccountID         int64
	CategoryID        *int64
	TransferAccountID *int64
	Payee             string
	Notes             string
	Amount            string
	Accounts          []store.AccountWithBalance
	Categories        []store.Category
}

func accountOptions(accts []store.AccountWithBalance, selectedID int64) []Opt {
	out := make([]Opt, 0, len(accts))
	for _, a := range accts {
		out = append(out, Opt{
			Value:    strconv.FormatInt(a.ID, 10),
			Label:    a.Name,
			Selected: a.ID == selectedID,
		})
	}
	return out
}

func categoryOptions(cats []store.Category, selected *int64) []Opt {
	out := make([]Opt, 0, len(cats))
	for _, c := range cats {
		out = append(out, Opt{
			Value:    strconv.FormatInt(c.ID, 10),
			Label:    c.Name,
			Selected: selected != nil && *selected == c.ID,
		})
	}
	return out
}

func transferOptions(accts []store.AccountWithBalance, selected *int64) []Opt {
	out := make([]Opt, 0, len(accts))
	for _, a := range accts {
		out = append(out, Opt{
			Value:    strconv.FormatInt(a.ID, 10),
			Label:    a.Name,
			Selected: selected != nil && *selected == a.ID,
		})
	}
	return out
}

func accountName(accts []store.AccountWithBalance, id int64) string {
	for _, a := range accts {
		if a.ID == id {
			return a.Name
		}
	}
	return ""
}

func categoryName(cats []store.Category, id int64) string {
	for _, c := range cats {
		if c.ID == id {
			return c.Name
		}
	}
	return ""
}

func transactionsPageHref(d TransactionsData, page int) string {
	q := fmt.Sprintf("/transactions?page=%d", page)
	if d.FilterMonth != "" {
		q += "&month=" + d.FilterMonth
	} else {
		q += "&all=1"
	}
	return q + txFilterQuery(d)
}

// txMonthHref builds a /transactions URL pointing at the given month
// (or "all months" when month is empty), preserving the active account
// and category filters.
func txMonthHref(d TransactionsData, month string) string {
	q := "/transactions"
	if month != "" {
		q += "?month=" + month
	} else {
		q += "?all=1"
	}
	return q + txFilterQuery(d)
}

// txFilterQuery renders the active account/category filters as query params to
// append to a /transactions URL, so month navigation and paging stay scoped.
func txFilterQuery(d TransactionsData) string {
	q := ""
	if d.FilterAccount != nil {
		q += fmt.Sprintf("&account=%d", *d.FilterAccount)
	}
	if d.FilterCategory != nil {
		q += fmt.Sprintf("&category=%d", *d.FilterCategory)
	}
	return q
}

// txTypeOrDefault returns the transaction type for the form, defaulting to
// "expense" (the most common entry) when unset.
func txTypeOrDefault(t string) string {
	if t == "" {
		return "expense"
	}
	return t
}

// txTypeOptions builds the type selector. New transactions allow any type, but
// editing can't convert between a transfer and a regular transaction (the user
// deletes and recreates instead), so the invalid types are disabled: editing a
// transfer locks out Expense/Income; editing a regular transaction locks out
// Transfer. Expense↔Income stays allowed either way.
func txTypeOptions(d TxFormData) []buttongroup.Option {
	lockPlain := d.Editing && d.TxType == "transfer"
	lockTransfer := d.Editing && d.TxType != "transfer"
	return []buttongroup.Option{
		{Value: "expense", Label: "Expense", Disabled: lockPlain},
		{Value: "income", Label: "Income", Disabled: lockPlain},
		{Value: "transfer", Label: "Transfer", Disabled: lockTransfer},
	}
}

// txDate parses a "YYYY-MM-DD" form value into a time.Time for the date picker.
// Returns the zero time (picker shows its placeholder) when empty or malformed.
func txDate(s string) time.Time {
	t, _ := time.Parse("2006-01-02", s)
	return t
}

func sameDay(a, b time.Time) bool {
	ay, am, ad := a.Date()
	by, bm, bd := b.Date()
	return ay == by && am == bm && ad == bd
}

func txMonthLabel(month string) string {
	if month == "" {
		return "All months"
	}
	t, err := time.Parse("2006-01", month)
	if err != nil {
		return month
	}
	return t.Format("January 2006")
}
