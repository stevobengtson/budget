package views

import (
	"context"
	"fmt"
	"net/url"
	"strconv"
	"time"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/monthselector"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/datepicker"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/label"
)

type TransactionsData struct {
	Rows          []store.Transaction
	Accounts      []store.AccountWithBalance
	Categories    []store.Category
	Groups        []store.CategoryGroup
	FilterAccount *int64

	// FilterCategory narrows the view to one category, set either by the filter
	// bar or by the budget page's "View Transactions" action.
	FilterCategory *int64
	FilterMonth    string // "YYYY-MM" or "" when viewing all months
	// FilterReview narrows the view to unreviewed bank-sync imports;
	// ReviewCount is the user's total for the chip label (0 hides the chip).
	FilterReview bool
	ReviewCount  int64
	PrevMonth    string
	NextMonth    string
	Today        string // current month key, for the "today" jump button
	Page         int    // 1-based
	PageSize     int
	Total        int
}

templ TransactionsPage(d TransactionsData, collapsed bool) {
	@Layout(i18n.T(ctx, "tx.title"), "transactions", collapsed) {
		@TransactionsBody(d)
	}
}

templ TransactionsBody(d TransactionsData) {
	// Ordered by how the page is used, widest scope first: which month, then
	// which slice of it, then entry, then the result. The add form sits directly
	// above the list so a new entry appears right where you were looking.
	<div class="flex flex-col gap-s3">
		<div class="flex flex-wrap items-center justify-between gap-s3">
			<h1 class="font-heading text-[22px] font-semibold">{ txMonthLabel(ctx, d.FilterMonth) }</h1>
			@monthselector.MonthSelector(txMonthHref(d, d.PrevMonth), txMonthHref(d, d.Today), txMonthHref(d, d.NextMonth), d.FilterMonth == d.Today)
		</div>
		@TxFilterBar(d)
		@TxQuickAdd(d, false)
		<div id="tx-rows" class="flex flex-col">
			@TxRows(d.Rows, d.Accounts, d.Categories, d.FilterAccount)
		</div>
		if d.Total > d.PageSize {
			<div class="flex items-center gap-s3 pt-s3 text-[13px] text-muted-foreground">
				if d.Page > 1 {
					@button.Button(button.Props{Href: transactionsPageHref(d, d.Page-1), Variant: button.VariantOutline, Size: button.SizeSm, Class: "rounded-pill"}) {
						{ i18n.T(ctx, "common.prev_page") }
					}
				}
				<span>{ i18n.Tf(ctx, "common.page_of", i18n.M{"Page": d.Page, "Total": (d.Total + d.PageSize - 1) / d.PageSize}) }</span>
				if d.Page * d.PageSize < d.Total {
					@button.Button(button.Props{Href: transactionsPageHref(d, d.Page+1), Variant: button.VariantOutline, Size: button.SizeSm, Class: "rounded-pill"}) {
						{ i18n.T(ctx, "common.next_page") }
					}
				}
			</div>
		}
	</div>
}

// TxQuickAdd is the always-open entry row — the redesign's centrepiece. It
// replaces the Add transaction -> sheet -> form -> save round trip: the row is
// never behind a button, focus opens on Amount, and Enter saves and starts the
// next entry with Date and Account retained.
//
// Field swapping between expense/income/transfer is pure CSS, driven by the
// radio group's :checked state (see input.css) — the same approach the old sheet
// form used, extended to the From -> To pair.
//
// The selects are native rather than templUI's SelectField: this row is built
// for a keyboard run (tab through, Enter, repeat), and a native select tabs and
// type-aheads correctly and can be reassigned by the swap button without driving
// a custom popover widget.
//
// oob renders the row as an out-of-band swap, which is how a successful save
// resets it: the create handler sends this markup back alongside the new row
// list, so every field returns to the same defaults it had on page load. Doing
// the reset by re-rendering keeps those defaults defined once, in Go — the
// pickers are templUI widgets whose value lives in a hidden input with no value
// attribute, so there is nothing in the DOM for JS to restore them from.
templ TxQuickAdd(d TransactionsData, oob bool) {
	{{ attrs := templ.Attributes{} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<form
		id="tx-quickadd"
		data-tx-form
		hx-post="/transactions"
		hx-target="#tx-rows"
		hx-swap="innerHTML"
		class="flex flex-col gap-s3 rounded-xl bg-surface-quickadd p-s3 shadow-organic-sm"
		{ attrs... }
	>
		// Below 768px the fields stack full-width with touch-sized targets and Add
		// becomes a full-width primary action at the foot of the card. The design
		// pairs Amount beside Add on one line; that would need Add moved next to
		// Amount in the DOM, which reorders the desktop row, so the phone layout
		// keeps the stack and gives Add the full width instead.
		<div class="flex flex-wrap items-end gap-s2">
			// Type leads: it decides which of the fields after it exist at all, so it
			// is the first thing read and the first thing changed. The accounts
			// follow as a block — From, To and the swap between them — then the
			// when/how-much pair every type shares.
			@quickField("qa-type", i18n.T(ctx, "tx.field_type"), "w-full md:w-[140px]") {
				@SelectField(SelectFieldProps{
					ID:           "qa-type",
					Name:         "tx_type",
					Class:        "tx-type-select w-full",
					TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
					NoSearch:     true,
				}, []Opt{
					{Value: "expense", Label: i18n.T(ctx, "tx.type_expense"), Selected: true},
					{Value: "income", Label: i18n.T(ctx, "tx.type_income")},
					{Value: "transfer", Label: i18n.T(ctx, "tx.type_transfer")},
				})
			}
			// When the list is already scoped to one account, the Account field is
			// redundant in expense/income mode — the answer is the account you are
			// looking at. It stays in the DOM (a display:none select still posts its
			// value) and reappears as "From" in transfer mode, where both ends of the
			// movement have to be visible.
			<div
				id="qa-account-field"
				if d.FilterAccount != nil {
					class="tx-transfer-only w-full md:w-[180px]"
				} else {
					class="w-full md:w-[180px]"
				}
			>
				@quickField("qa-account", accountFieldLabel, "w-full") {
					@SelectField(SelectFieldProps{
						ID:           "qa-account",
						Name:         "account_id",
						Class:        "w-full",
						TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
					}, accountOptions(d.Accounts, txDefaultAccount(d)))
				}
			</div>
			<div class="tx-transfer-only w-full md:w-[180px]">
				@quickField("qa-transfer", i18n.T(ctx, "tx.field_to"), "w-full") {
					@SelectField(SelectFieldProps{
						ID:           "qa-transfer",
						Name:         "transfer_to",
						Placeholder:  i18n.T(ctx, "common.none_placeholder"),
						Class:        "tx-to-select w-full",
						TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
					}, transferOptions(d.Accounts, nil))
				}
			</div>
			<button
				type="button"
				id="qa-swap"
				data-tx-swap
				aria-label={ i18n.T(ctx, "tx.swap_from_to") }
				title={ i18n.T(ctx, "tx.swap_from_to") }
				class="tx-transfer-only h-9 w-9 shrink-0 items-center justify-center rounded-pill border border-border text-foreground hover:bg-foreground/[0.07]"
			>
				@icon.ArrowLeftRight(icon.Props{Class: "size-[18px]"})
			</button>
			@quickField("qa-date", i18n.T(ctx, "tx.field_date"), "w-full md:w-[170px]") {
				@datepicker.DatePicker(datepicker.Props{
								// The calendar's month and weekday names come from the browser's
								// Intl via this tag, so it has to follow the request locale or the
								// popover stays English inside a French page.
								LocaleTag: datepicker.LocaleTag(i18n.LocaleFrom(ctx)),
					ID:          "qa-date",
					Name:        "date",
					Value:       time.Now(),
					Placeholder: i18n.T(ctx, "tx.pick_a_date"),
					Class:       "w-full",
				})
			}
			@quickField("qa-amount", i18n.T(ctx, "tx.field_amount"), "flex-1 md:w-[124px] md:flex-none") {
				<input
					id="qa-amount"
					type="text"
					name="amount"
					inputmode="decimal"
					autocomplete="off"
					placeholder="0.00"
					class="h-[52px] w-full rounded-pill border border-primary bg-surface-sunk px-s3 text-right text-[22px] font-bold tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring md:h-9 md:text-[15px]"
				/>
			}
			// Paying down a card or loan is spending, so it can be tagged to an
			// envelope; moving cash between your own accounts cannot. The field
			// therefore appears only when the destination is a debt account —
			// read straight from the selected option's type in CSS.
			<div class="tx-transfer-category w-full md:w-[210px]">
				@quickField("qa-transfer-category", i18n.T(ctx, "tx.field_budget_category"), "w-full") {
					@SelectFieldGrouped(SelectFieldProps{
						ID:           "qa-transfer-category",
						Name:         "transfer_category_id",
						Placeholder:  i18n.T(ctx, "common.none_placeholder"),
						Class:        "w-full",
						TriggerClass: "h-9 rounded-pill border-primary bg-surface-sunk text-[15px]",
					}, nil, categoryOptGroups(d.Categories, d.Groups, nil))
				}
			</div>
			// Category, Payee and Notes close the row, in that order. Payee holds a
			// short name and is sized for one; Notes is the field that runs long, so
			// it takes the flexible remainder rather than Payee.
			<div class="tx-plain-only w-full md:w-[170px]">
				@quickField("qa-category", i18n.T(ctx, "tx.field_category"), "w-full") {
					@SelectFieldGrouped(SelectFieldProps{
						ID:           "qa-category",
						Name:         "category_id",
						Placeholder:  i18n.T(ctx, "common.none_placeholder"),
						Class:        "w-full",
						TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
					}, nil, categoryOptGroups(d.Categories, d.Groups, d.FilterCategory))
				}
			</div>
			<div class="tx-plain-only w-full md:w-[200px]">
				@quickField("qa-payee", i18n.T(ctx, "tx.field_payee"), "w-full") {
					<input
						id="qa-payee"
						type="text"
						name="payee"
						autocomplete="off"
						class="h-12 w-full rounded-pill border border-input bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:border-primary md:h-9"
					/>
				}
			</div>
			// Shown for every type: a transfer leg stores notes too.
			@quickField("qa-notes", i18n.T(ctx, "tx.field_notes"), "w-full min-w-[150px] md:flex-1") {
				<input
					id="qa-notes"
					type="text"
					name="notes"
					autocomplete="off"
					class="h-12 w-full rounded-pill border border-input bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:border-primary md:h-9"
				/>
			}
			@button.Button(button.Props{Type: "submit", Class: "h-[52px] w-full shrink-0 rounded-pill text-[16px] md:h-9 md:w-auto md:px-s3 md:text-[14px]"}) {
				{ i18n.T(ctx, "tx.add") }
			}
		</div>
		<p class="tx-transfer-category text-[13px] text-muted-foreground">
			{ i18n.T(ctx, "tx.transfer_category_note") }
		</p>
	</form>
}

// accountFieldLabel marks the account field, whose label is not one string but
// two spans — "Account" and "From" — that CSS swaps by transaction type. It is a
// sentinel rather than a real label because quickField has to recognise the
// field, and comparing against a translated string would stop matching the
// moment the translation changed.
const accountFieldLabel = "\x00account"

// quickField is one labelled field in the quick-add row: a micro label above a
// pill control.
templ quickField(id, label, class string) {
	<div class={ "flex flex-col gap-1", class }>
		<label for={ id } class="text-[12px] font-semibold text-muted-foreground">
			if label == accountFieldLabel {
				<span class="tx-label-account">{ i18n.T(ctx, "tx.field_account") }</span>
				<span class="tx-label-from">{ i18n.T(ctx, "tx.field_from") }</span>
			} else {
				{ label }
			}
		</label>
		{ children... }
	</div>
}

// TxFilterBar renders the category filter under the quick-add row. It is a plain
// GET form to /transactions: picking a category re-requests the page with the
// active month and account carried in hidden fields, so the filter narrows the
// current view rather than replacing it.
//
// The auto-submit hangs off the hidden input templUI posts from (see
// SelectField) — templUI dispatches `change` there only on a user pick or the
// built-in clear button, never on init, so this can't loop on page load.
templ TxFilterBar(d TransactionsData) {
	// Both filters live in one GET form so changing either carries the other,
	// rather than the account being links that have to rebuild the query string
	// by hand. The month rides along hidden.
	<form method="get" action="/transactions" class="flex flex-wrap items-center gap-x-s4 gap-y-s2 border-b border-border pb-s3">
		if d.FilterMonth != "" {
			<input type="hidden" name="month" value={ d.FilterMonth }/>
		} else {
			<input type="hidden" name="all" value="1"/>
		}
		<div class="flex items-center gap-s2">
			@label.Label(label.Props{For: "filter-account", Class: "text-[13px] text-muted-foreground"}) {
				{ i18n.T(ctx, "tx.filter_account") }
			}
			@SelectField(SelectFieldProps{
				ID:           "filter-account",
				Name:         "account",
				Class:        "w-56",
				TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
				Attributes:   templ.Attributes{"onchange": "this.form.requestSubmit()"},
			}, accountFilterOptions(ctx, d.Accounts, d.FilterAccount))
		</div>
		// Led by an empty-valued "All categories" entry that clears the filter, then
		// the categories under their group headings so the list reads like the budget
		// page. Archived categories are included: they still label historical
		// transactions, so a filter arriving from the budget stays correctly
		// labelled after the category is archived.
		<div class="flex items-center gap-s2">
			@label.Label(label.Props{For: "filter-category", Class: "text-[13px] text-muted-foreground"}) {
				{ i18n.T(ctx, "tx.filter_category") }
			}
			@SelectFieldGrouped(SelectFieldProps{
				ID:           "filter-category",
				Name:         "category",
				Class:        "w-56",
				TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
				Attributes:   templ.Attributes{"onchange": "this.form.requestSubmit()"},
			}, []Opt{
				{Value: "", Label: i18n.T(ctx, "tx.all_categories"), Selected: d.FilterCategory == nil},
			}, categoryOptGroups(d.Categories, d.Groups, d.FilterCategory))
		</div>
		// The needs-review chip appears only while there is something to review
		// (or the filter is already on, so it can be turned off). A link, not a
		// submit: it re-requests the page with review toggled and the rest of the
		// form's state carried in the URL it builds.
		if d.ReviewCount > 0 || d.FilterReview {
			<a
				href={ templ.URL(txReviewHref(d)) }
				class={ reviewChipClass(d.FilterReview) }
				if d.FilterReview {
					aria-pressed="true"
				} else {
					aria-pressed="false"
				}
			>
				{ i18n.Tnf(ctx, "tx.filter_needs_review", int(d.ReviewCount), i18n.M{"Count": d.ReviewCount}) }
			</a>
			if d.FilterReview {
				<button
					type="button"
					class="rounded-pill border border-border px-3 py-1 text-[13px] font-semibold text-muted-foreground hover:bg-muted"
					hx-post="/transactions/review-all"
					hx-swap="none"
					hx-confirm={ i18n.T(ctx, "tx.review_all_confirm") }
				>
					{ i18n.T(ctx, "tx.review_all") }
				</button>
			}
		}
	</form>
}

// txReviewHref toggles the needs-review filter while preserving the rest of
// the current view (month/all, account, category).
func txReviewHref(d TransactionsData) string {
	q := url.Values{}
	if d.FilterMonth != "" {
		q.Set("month", d.FilterMonth)
	} else {
		q.Set("all", "1")
	}
	if d.FilterAccount != nil {
		q.Set("account", strconv.FormatInt(*d.FilterAccount, 10))
	}
	if d.FilterCategory != nil {
		q.Set("category", strconv.FormatInt(*d.FilterCategory, 10))
	}
	if !d.FilterReview {
		q.Set("review", "1")
	}
	return "/transactions?" + q.Encode()
}

// reviewChipClass styles the needs-review toggle: amber when armed, quiet
// outline otherwise.
func reviewChipClass(active bool) string {
	base := "rounded-pill px-3 py-1 text-[13px] font-semibold transition-colors"
	if active {
		return base + " bg-tag-amber-bg text-tag-amber-fg"
	}
	return base + " border border-border text-muted-foreground hover:bg-muted"
}

// accountFilterOptions lists the accounts for the filter, led by an
// empty-valued "All Accounts" entry that clears the filter — the same zero-state
// the sidebar's account list is headed by.
func accountFilterOptions(ctx context.Context, accts []store.AccountWithBalance, selected *int64) []Opt {
	out := make([]Opt, 0, len(accts)+1)
	out = append(out, Opt{Value: "", Label: i18n.T(ctx, "nav.all_accounts"), Selected: selected == nil})
	for _, a := range accts {
		out = append(out, Opt{
			Value:    strconv.FormatInt(a.ID, 10),
			Label:    a.Name,
			Selected: selected != nil && *selected == a.ID,
		})
	}
	return out
}


// TxRows renders the rows grouped by day, each group under a date header
// carrying that day's net. Shared by the initial page render and the htmx
// refresh after a create/update so both produce identical markup.
templ TxRows(rows []store.Transaction, accts []store.AccountWithBalance, cats []store.Category, filterAccount *int64) {
	{{ days := groupTxByDay(VisibleTxRows(rows, filterAccount)) }}
	if len(days) == 0 {
		<p class="px-s3 py-s6 text-[15px] text-muted-foreground">
			{ i18n.T(ctx, "tx.empty") }
		</p>
	}
	for _, day := range days {
		<div class="flex items-baseline justify-between px-s3 pb-s1 pt-s4">
			<span class="text-[12px] font-bold uppercase tracking-[0.08em] text-muted-foreground">
				{ format.WeekdayDate(ctx, day.Date) }
			</span>
			<span class="text-[13px] tabular-nums text-muted-foreground">
				{ money.Format(ctx, day.Net) }
			</span>
		</div>
		// Left-only inset: the rows hang under their date header while their
		// right edge — and so the amount column — stays aligned with the day net.
		<div class="pl-s4">
			for _, t := range day.Rows {
				@TransactionRow(t, accts, cats, false)
			}
		</div>
	}
}

// txDay is one day's transactions plus that day's net movement.
type txDay struct {
	Date time.Time
	Rows []store.Transaction
	Net  int64
}

// groupTxByDay buckets already-sorted rows into consecutive day groups.
func groupTxByDay(rows []store.Transaction) []txDay {
	var days []txDay
	for _, t := range rows {
		if len(days) == 0 || !sameDay(days[len(days)-1].Date, t.Date) {
			days = append(days, txDay{Date: t.Date})
		}
		d := &days[len(days)-1]
		d.Rows = append(d.Rows, t)
		d.Net += t.InflowCents - t.OutflowCents
	}
	return days
}

// VisibleTxRows collapses a transfer's two stored legs into the one row that
// makes sense for the current view. The pair is still stored and still edited as
// two legs — only the rendering changes.
//
// Scoped to a single account, the query already returned just that account's
// leg, so everything passes through and the transfer reads from that account's
// point of view. Unscoped, the arriving leg is dropped so money always reads as
// leaving and a transfer never appears twice in one list.
//
// Exported because pagination has to count what will actually be rendered: the
// index handler filters before slicing, or the pager counts hidden legs and a
// page of 50 stored rows renders however many of them survive.
//
// Idempotent, so the render path can filter again without harm.
func VisibleTxRows(rows []store.Transaction, filterAccount *int64) []store.Transaction {
	if filterAccount != nil {
		return rows
	}
	out := make([]store.Transaction, 0, len(rows))
	for _, t := range rows {
		if t.TransferAccountID != nil && t.InflowCents > 0 {
			continue
		}
		out = append(out, t)
	}
	return out
}

templ TransactionRow(t store.Transaction, accts []store.AccountWithBalance, cats []store.Category, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("tx-%d", t.ID)} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div
		class="group grid grid-cols-[1fr_190px_140px_28px_32px] items-center gap-s4 rounded-md px-s3 py-[9px] hover:bg-foreground/[0.04]"
		{ attrs... }
	>
		<div class="flex min-w-0 items-center gap-s2">
			<span class="truncate text-[16px] font-semibold">{ txDisplayName(ctx, t, accts) }</span>
			@TxCategoryCell(t, accts, cats)
		</div>
		<span class="truncate text-[14px] text-muted-foreground">
			{ accountName(accts, t.AccountID) }
		</span>
		<span class="text-right text-[17px] font-bold tabular-nums">
			if t.InflowCents > 0 {
				<span class="text-money-positive">{ money.Format(ctx, t.InflowCents) }</span>
			} else {
				<span class="text-foreground">{ money.Format(ctx, -t.OutflowCents) }</span>
			}
		</span>
		@txClearCell(t)
		<span class="opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100">
			@txRowMenu(t)
		</span>
	</div>
}

// txDisplayName is what the row leads with: the payee for a normal transaction,
// and for a transfer the account at the other end — so a transfer reads as a
// movement between two named places rather than as a payee-less blank.
func txDisplayName(ctx context.Context, t store.Transaction, accts []store.AccountWithBalance) string {
	if t.TransferAccountID != nil {
		return accountName(accts, *t.TransferAccountID)
	}
	if t.Payee != nil && *t.Payee != "" {
		return *t.Payee
	}
	return i18n.T(ctx, "tx.no_payee")
}

// TxCategoryCell renders the row's tag: a neutral "transfer" tag, or the
// category in sage. A transfer that also carries a budget category (a card
// payment tagged to an envelope) shows both.
templ TxCategoryCell(t store.Transaction, accts []store.AccountWithBalance, cats []store.Category) {
	<span class="flex shrink-0 items-center gap-1">
		if t.TransferAccountID != nil {
			<span class="rounded-pill bg-tag-neutral-bg px-2 py-0.5 text-[12px] font-semibold text-tag-neutral-fg">{ i18n.T(ctx, "tx.tag_transfer") }</span>
			if t.CategoryID != nil {
				<span class="rounded-pill bg-tag-sage-bg px-2 py-0.5 text-[12px] font-semibold text-tag-sage-fg">
					{ categoryName(cats, *t.CategoryID) }
				</span>
			}
		} else if t.CategoryID != nil {
			<span class="rounded-pill bg-tag-sage-bg px-2 py-0.5 text-[12px] font-semibold text-tag-sage-fg">
				{ categoryName(cats, *t.CategoryID) }
			</span>
		} else {
			<span class="rounded-pill bg-tag-neutral-bg px-2 py-0.5 text-[12px] font-semibold text-tag-neutral-fg">{ i18n.T(ctx, "tx.tag_uncategorized") }</span>
		}
		// Unreviewed bank-sync import: the amber tag IS the "mark reviewed"
		// action (click to clear), so review costs one click and no extra column.
		if t.NeedsReview {
			<button
				type="button"
				title={ i18n.T(ctx, "tx.mark_reviewed") }
				class="rounded-pill bg-tag-amber-bg px-2 py-0.5 text-[12px] font-semibold text-tag-amber-fg hover:opacity-80"
				hx-post={ fmt.Sprintf("/transactions/%d/review", t.ID) }
				hx-target={ fmt.Sprintf("#tx-%d", t.ID) }
				hx-swap="outerHTML"
			>
				{ i18n.T(ctx, "tx.tag_needs_review") }
			</button>
		}
	</span>
}

// txClearCell is the cleared marker: a sage check when cleared, and an explicit
// empty circle when not — a stated "pending", not the absence of a tick. For a
// transfer this toggles both legs (SetCleared already does).
templ txClearCell(t store.Transaction) {
	{{ title := i18n.T(ctx, "tx.not_cleared") }}
	if t.Cleared {
		{{ title = i18n.T(ctx, "tx.cleared") }}
	}
	<button
		type="button"
		title={ title }
		aria-pressed={ fmt.Sprintf("%t", t.Cleared) }
		class="inline-flex size-7 items-center justify-center rounded-pill hover:bg-foreground/[0.07]"
		hx-post={ fmt.Sprintf("/transactions/%d/cleared", t.ID) }
		hx-target={ fmt.Sprintf("#tx-%d", t.ID) }
		hx-swap="outerHTML"
	>
		if t.Cleared {
			@icon.Check(icon.Props{Class: "size-[17px] text-money-positive"})
		} else {
			<span class="block size-[10px] rounded-pill border-2 border-muted-foreground"></span>
		}
	</button>
}

// TransactionEditRow edits a transaction in place: the row is replaced by this
// card. Every type edits the same way — a transfer needs it (one record spanning
// two accounts, where a side sheet would hide the list that gives it context)
// and consistency argues the rest should follow rather than having two editing
// idioms in one list.
//
// It carries the row's own id so Cancel can put the row back, and it is a
// [data-tx-form], so the shared CSS drives the type-dependent fields, the
// From/To labelling and the debt-destination Budget category.
templ TransactionEditRow(d TxFormData) {
	<form
		id={ fmt.Sprintf("tx-%d", d.ID) }
		data-tx-form
		hx-put={ fmt.Sprintf("/transactions/%d", d.ID) }
		hx-target="#tx-rows"
		hx-swap="innerHTML"
		class="flex flex-col gap-s3 rounded-md bg-surface-quickadd p-s3 shadow-organic-sm"
	>
		<div class="flex items-baseline gap-s2">
			<span class="font-heading text-[17px] font-semibold">
				if d.TxType == "transfer" {
					{ i18n.T(ctx, "tx.editing_transfer") }
				} else {
					{ i18n.T(ctx, "tx.editing_transaction") }
				}
			</span>
			if d.TxType == "transfer" {
				<span class="text-[13px] text-muted-foreground">{ i18n.T(ctx, "tx.transfer_shape") }</span>
			}
		</div>
		<div class="flex flex-wrap items-end gap-s2">
			@quickField("tx-edit-type", i18n.T(ctx, "tx.field_type"), "w-full md:w-[140px]") {
				// A transfer cannot become an expense, or vice versa — the stored
				// shape differs (two linked legs vs one row). txTypeOptions disables
				// the conversions rather than hiding them, so the constraint is
				// visible instead of mysterious.
				@SelectField(SelectFieldProps{
					ID:           "tx-edit-type",
					Name:         "tx_type",
					Class:        "tx-type-select w-full",
					TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
					NoSearch:     true,
				}, txTypeOptions(ctx, d))
			}
			@quickField("tx-edit-from", accountFieldLabel, "w-full md:w-[180px]") {
				@SelectField(SelectFieldProps{
					ID:           "tx-edit-from",
					Name:         "account_id",
					Class:        "w-full",
					TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
				}, accountOptions(d.Accounts, d.AccountID))
			}
			<div class="tx-transfer-only w-full md:w-[180px]">
				@quickField("tx-edit-to", i18n.T(ctx, "tx.field_to"), "w-full") {
					@SelectField(SelectFieldProps{
						ID:           "tx-edit-to",
						Name:         "transfer_to",
						Placeholder:  i18n.T(ctx, "common.none_placeholder"),
						Class:        "tx-to-select w-full",
						TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
					}, transferOptions(d.Accounts, d.TransferAccountID))
				}
			</div>
			<button
				type="button"
				data-tx-swap
				aria-label={ i18n.T(ctx, "tx.swap_from_to") }
				title={ i18n.T(ctx, "tx.swap_from_to") }
				class="tx-transfer-only size-9 shrink-0 items-center justify-center rounded-pill border border-border text-foreground hover:bg-foreground/[0.07]"
			>
				@icon.ArrowLeftRight(icon.Props{Class: "size-[18px]"})
			</button>
			@quickField("tx-edit-date", i18n.T(ctx, "tx.field_date"), "w-full md:w-[170px]") {
				@datepicker.DatePicker(datepicker.Props{
								// The calendar's month and weekday names come from the browser's
								// Intl via this tag, so it has to follow the request locale or the
								// popover stays English inside a French page.
								LocaleTag: datepicker.LocaleTag(i18n.LocaleFrom(ctx)),
					ID:    "tx-edit-date",
					Name:  "date",
					Value: txDate(d.Date),
					Class: "w-full",
				})
			}
			@quickField("tx-edit-amount", i18n.T(ctx, "tx.field_amount"), "w-full md:w-[124px]") {
				<input
					id="tx-edit-amount"
					type="text"
					name="amount"
					value={ d.Amount }
					inputmode="decimal"
					autocomplete="off"
					class="h-9 w-full rounded-pill border border-primary bg-surface-sunk px-s3 text-right text-[15px] font-bold tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"
				/>
			}
			<div class="tx-transfer-category w-full md:w-[210px]">
				@quickField("tx-edit-transfer-category", i18n.T(ctx, "tx.field_budget_category"), "w-full") {
					@SelectFieldGrouped(SelectFieldProps{
						ID:           "tx-edit-transfer-category",
						Name:         "transfer_category_id",
						Placeholder:  i18n.T(ctx, "common.none_placeholder"),
						Class:        "w-full",
						TriggerClass: "h-9 rounded-pill border-primary bg-surface-sunk text-[15px]",
					}, nil, categoryOptGroups(d.Categories, d.Groups, d.CategoryID))
				}
			</div>
			// Same tail as the quick-add row — Category, Payee, Notes — so an edit
			// reads as the row it replaces rather than as a different form.
			<div class="tx-plain-only w-full md:w-[170px]">
				@quickField("tx-edit-category", i18n.T(ctx, "tx.field_category"), "w-full") {
					@SelectFieldGrouped(SelectFieldProps{
						ID:           "tx-edit-category",
						Name:         "category_id",
						Placeholder:  i18n.T(ctx, "common.none_placeholder"),
						Class:        "w-full",
						TriggerClass: "h-9 rounded-pill border-input bg-surface-sunk text-[15px]",
					}, nil, categoryOptGroups(d.Categories, d.Groups, d.CategoryID))
				}
			</div>
			<div class="tx-plain-only w-full md:w-[200px]">
				@quickField("tx-edit-payee", i18n.T(ctx, "tx.field_payee"), "w-full") {
					<input
						id="tx-edit-payee"
						type="text"
						name="payee"
						value={ d.Payee }
						autocomplete="off"
						class="h-9 w-full rounded-pill border border-input bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:border-primary"
					/>
				}
			</div>
			@quickField("tx-edit-notes", i18n.T(ctx, "tx.field_notes"), "w-full min-w-[150px] md:flex-1") {
				<input
					id="tx-edit-notes"
					type="text"
					name="notes"
					value={ d.Notes }
					autocomplete="off"
					class="h-9 w-full rounded-pill border border-input bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:border-primary"
				/>
			}
		</div>
		<div class="flex items-center justify-end gap-s2">
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "rounded-pill",
				Attributes: templ.Attributes{
					"hx-get":    fmt.Sprintf("/transactions/%d/row", d.ID),
					"hx-target": fmt.Sprintf("#tx-%d", d.ID),
					"hx-swap":   "outerHTML",
				},
			}) {
				{ i18n.T(ctx, "common.cancel") }
			}
			@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Class: "rounded-pill"}) {
				{ i18n.T(ctx, "common.save") }
			}
		</div>
	</form>
}

// txRowMenu renders the per-row actions menu.
templ txRowMenu(t store.Transaction) {
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class:      "inline-flex size-8 items-center justify-center rounded-pill text-muted-foreground hover:bg-foreground/[0.07] hover:text-foreground",
			Attributes: templ.Attributes{"title": i18n.T(ctx, "tx.row_actions")},
		}) {
			@icon.EllipsisVertical(icon.Props{Class: "size-4"})
		}
		@dropdown.Content(dropdown.ContentProps{Class: "w-[260px]"}) {
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-get":    fmt.Sprintf("/transactions/%d/edit-row", t.ID),
					"hx-target": fmt.Sprintf("#tx-%d", t.ID),
					"hx-swap":   "outerHTML",
				},
			}) {
				{ i18n.T(ctx, "tx.menu_edit") }
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class: "text-money-negative",
				Attributes: templ.Attributes{
					"hx-delete":  fmt.Sprintf("/transactions/%d", t.ID),
					"hx-target":  fmt.Sprintf("#tx-%d", t.ID),
					"hx-swap":    "outerHTML",
					"hx-confirm": txDeleteConfirm(ctx, t),
				},
			}) {
				{ i18n.T(ctx, "tx.menu_delete") }
			}
		}
	}
}

// txDeleteConfirm words the confirmation. A transfer has two stored legs and
// deleting removes both — there is no half-deleted transfer — so the prompt says
// so rather than letting the user assume only the visible row goes.
func txDeleteConfirm(ctx context.Context, t store.Transaction) string {
	if t.TransferAccountID != nil {
		return i18n.T(ctx, "tx.delete_transfer_confirm")
	}
	return i18n.T(ctx, "tx.delete_confirm")
}

// txDefaultAccount preselects the quick-add's account: the one being filtered
// on, else the first account, so a run of entries starts on the right one.
func txDefaultAccount(d TransactionsData) int64 {
	if d.FilterAccount != nil {
		return *d.FilterAccount
	}
	if len(d.Accounts) > 0 {
		return d.Accounts[0].ID
	}
	return 0
}

// todayISO is today's date in the format a native date input expects.
func todayISO() string {
	return time.Now().Format("2006-01-02")
}

templ formRow(id, text string) {
	<div class="grid gap-1.5">
		@label.Label(label.Props{For: id}) {
			{ text }
		}
		<div class="[&>input]:w-full [&>select]:w-full">
			{ children... }
		</div>
	</div>
}

type TxFormData struct {
	Editing           bool
	ID                int64
	TxType            string // "expense" | "income" | "transfer" (default expense)
	Date              string // YYYY-MM-DD
	AccountID         int64
	CategoryID        *int64
	TransferAccountID *int64
	Payee             string
	Notes             string
	Amount            string
	Accounts          []store.AccountWithBalance
	Categories        []store.Category
	Groups            []store.CategoryGroup
}

func accountOptions(accts []store.AccountWithBalance, selectedID int64) []Opt {
	out := make([]Opt, 0, len(accts))
	for _, a := range accts {
		out = append(out, Opt{
			Value:    strconv.FormatInt(a.ID, 10),
			Label:    a.Name,
			Selected: a.ID == selectedID,
		})
	}
	return out
}

// transferOptions lists the accounts a transfer can arrive in, each tagged with
// its account type. The type drives the Budget category field: money moving to a
// card or loan is paying down a debt, which belongs in an envelope, whereas
// moving cash between your own accounts does not.
func transferOptions(accts []store.AccountWithBalance, selected *int64) []Opt {
	out := make([]Opt, 0, len(accts))
	for _, a := range accts {
		out = append(out, Opt{
			Value:      strconv.FormatInt(a.ID, 10),
			Label:      a.Name,
			Selected:   selected != nil && *selected == a.ID,
			Attributes: templ.Attributes{"data-acct-type": string(a.Type)},
		})
	}
	return out
}

func accountName(accts []store.AccountWithBalance, id int64) string {
	for _, a := range accts {
		if a.ID == id {
			return a.Name
		}
	}
	return ""
}

func categoryName(cats []store.Category, id int64) string {
	for _, c := range cats {
		if c.ID == id {
			return c.Name
		}
	}
	return ""
}

func transactionsPageHref(d TransactionsData, page int) string {
	q := fmt.Sprintf("/transactions?page=%d", page)
	if d.FilterMonth != "" {
		q += "&month=" + d.FilterMonth
	} else {
		q += "&all=1"
	}
	return q + txFilterQuery(d)
}

// txMonthHref builds a /transactions URL pointing at the given month
// (or "all months" when month is empty), preserving the active account
// and category filters.
func txMonthHref(d TransactionsData, month string) string {
	q := "/transactions"
	if month != "" {
		q += "?month=" + month
	} else {
		q += "?all=1"
	}
	return q + txFilterQuery(d)
}

// txFilterQuery renders the active account/category filters as query params to
// append to a /transactions URL, so month navigation and paging stay scoped.
func txFilterQuery(d TransactionsData) string {
	q := ""
	if d.FilterAccount != nil {
		q += fmt.Sprintf("&account=%d", *d.FilterAccount)
	}
	if d.FilterCategory != nil {
		q += fmt.Sprintf("&category=%d", *d.FilterCategory)
	}
	return q
}

// txTypeOrDefault returns the transaction type for the form, defaulting to
// "expense" (the most common entry) when unset.
func txTypeOrDefault(t string) string {
	if t == "" {
		return "expense"
	}
	return t
}

// txTypeOptions builds the type selector. New transactions allow any type, but
// editing can't convert between a transfer and a regular transaction (the user
// deletes and recreates instead), so the invalid types are disabled: editing a
// transfer locks out Expense/Income; editing a regular transaction locks out
// Transfer. Expense↔Income stays allowed either way.
func txTypeOptions(ctx context.Context, d TxFormData) []Opt {
	lockPlain := d.Editing && d.TxType == "transfer"
	lockTransfer := d.Editing && d.TxType != "transfer"
	sel := txTypeOrDefault(d.TxType)
	return []Opt{
		{Value: "expense", Label: i18n.T(ctx, "tx.type_expense"), Selected: sel == "expense", Disabled: lockPlain},
		{Value: "income", Label: i18n.T(ctx, "tx.type_income"), Selected: sel == "income", Disabled: lockPlain},
		{Value: "transfer", Label: i18n.T(ctx, "tx.type_transfer"), Selected: sel == "transfer", Disabled: lockTransfer},
	}
}

// txDate parses a "YYYY-MM-DD" form value into a time.Time for the date picker.
// Returns the zero time (picker shows its placeholder) when empty or malformed.
func txDate(s string) time.Time {
	t, _ := time.Parse("2006-01-02", s)
	return t
}

func sameDay(a, b time.Time) bool {
	ay, am, ad := a.Date()
	by, bm, bd := b.Date()
	return ay == by && am == bm && ad == bd
}

func txMonthLabel(ctx context.Context, month string) string {
	if month == "" {
		return i18n.T(ctx, "tx.all_months")
	}
	t, err := time.Parse("2006-01", month)
	if err != nil {
		return month
	}
	return format.MonthYearLong(ctx, t)
}
