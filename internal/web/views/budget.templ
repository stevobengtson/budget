package views

import (
	"fmt"
	"time"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/accountsoverview"
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/table"
)

type BudgetData struct {
	Month       string // "YYYY-MM"
	PrevMonth   string
	NextMonth   string
	Estimated   int64
	Actual      int64
	Budgeted    int64
	Remain      int64
	EstAct      int64
	CreditRows  []store.CreditActivity
	GroupedRows [][]store.CategoryBudget // grouped by GroupName order, no Income
	Accounts    []store.AccountWithBalance
}

templ BudgetPage(d BudgetData) {
	@Layout("Budget", "budget") {
		@BudgetBody(d)
	}
}

templ BudgetMonthSelector(d BudgetData) {
	<div class="mb-4 flex items-center justify-between gap-4">
		<h1 class="text-2xl font-semibold tracking-tight">Budget · { formatMonth(d.Month) }</h1>
		<div class="flex items-center gap-2">
			@button.Button(button.Props{Href: "/budget?month=" + d.PrevMonth, Variant: button.VariantOutline, Size: button.SizeSm}) {
				‹ prev
			}
			@button.Button(button.Props{Href: "/budget?month=" + nowMonth(), Variant: button.VariantOutline, Size: button.SizeSm}) {
				today
			}
			@button.Button(button.Props{Href: "/budget?month=" + d.NextMonth, Variant: button.VariantOutline, Size: button.SizeSm}) {
				next ›
			}
		</div>
	</div>
}

// BudgetBanner renders the summary stat cards inside a stable #budget-banner
// container so a single assignment save can refresh it via an out-of-band swap
// (pass oob=true) without touching the rest of the page.
templ BudgetBanner(d BudgetData) {
	@budgetBanner(d, false)
}

templ budgetBanner(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "budget-banner"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div { attrs... }>
		<div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-5">
			@bannerStat("Estimated", money.Format(d.Estimated), "text-foreground")
			@bannerStat("Actual", money.Format(d.Actual), "text-foreground")
			@bannerStat("Budgeted", money.Format(d.Budgeted), "text-foreground")
			@bannerStatSigned("Remain", d.Remain)
			@bannerStatSigned("Est−Act", d.EstAct)
		</div>
		<p class="mb-4 text-xs text-muted-foreground">Tip: <a class="underline underline-offset-4 hover:text-foreground" href="/budget/income">manage income</a> in this month.</p>
	</div>
}

templ bannerStat(label, value, valueClass string) {
	@card.Card(card.Props{Class: "p-4"}) {
		<div class="text-xs uppercase tracking-wide text-muted-foreground">{ label }</div>
		<div class={ "mt-1 text-lg font-semibold tabular-nums " + valueClass }>{ value }</div>
	}
}

templ bannerStatSigned(label string, cents int64) {
	@card.Card(card.Props{Class: "p-4"}) {
		<div class="text-xs uppercase tracking-wide text-muted-foreground">{ label }</div>
		<div class="mt-1 text-lg font-semibold tabular-nums">
			@SignedMoney(cents)
		</div>
	}
}

templ BudgetCreditSection(d BudgetData) {
	if len(d.CreditRows) > 0 {
		<h2 class="mb-2 mt-6 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Credit</h2>
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() { Account }
					@table.Head() { Purchases }
					@table.Head() { Payments }
					@table.Head() { Owing }
				}
			}
			@table.Body() {
				for _, ca := range d.CreditRows {
					@table.Row() {
						@table.Cell() { { ca.AccountName } }
						@table.Cell(table.CellProps{Class: "tabular-nums text-red-500"}) { { money.Format(ca.PurchasesCents) } }
						@table.Cell(table.CellProps{Class: "tabular-nums text-emerald-500"}) { { money.Format(ca.PaymentsCents) } }
						@table.Cell(table.CellProps{Class: "tabular-nums"}) {
							@SignedMoney(ca.OwingCents)
						}
					}
				}
			}
		}
	}
}

templ BudgetTable(d BudgetData) {
	@table.Table(table.Props{Class: "mt-2"}) {
		@table.Header() {
			@table.Row() {
				@table.Head(table.HeadProps{Class: "w-[34%]"}) { Group / Category }
				@table.Head() { Assigned }
				@table.Head() { Spent }
				@table.Head() { Available }
				@table.Head() { Goal }
				@table.Head() { }
			}
		}
		@table.Body() {
			for _, group := range d.GroupedRows {
				if len(group) > 0 {
					@table.Row(table.RowProps{Class: "bg-muted/40 hover:bg-muted/40"}) {
						@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2 align-middle font-semibold uppercase tracking-wide text-xs text-muted-foreground"}}) {
							{ group[0].GroupName }
						}
					}
					for _, r := range group {
						@BudgetRow(d.Month, r)
					}
				}
			}
		}
		@table.Footer() {
			@BudgetTotalsRow(d, false)
		}
	}
}

// BudgetTotalsRow is the footer totals row, factored out with a stable
// #budget-totals id so an assignment save can refresh just the totals via an
// out-of-band swap (oob=true) instead of re-rendering the whole table. When
// swapped OOB it must be wrapped in a <template> by the caller, because the
// browser strips a bare <tr> that isn't already inside a table.
templ BudgetTotalsRow(d BudgetData, oob bool) {
	{{ assigned, spent, available := budgetTotals(d.GroupedRows) }}
	{{ attrs := templ.Attributes{"id": "budget-totals"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "font-semibold"}) { Totals }
		@table.Cell(table.CellProps{Class: "tabular-nums font-semibold"}) { { money.Format(assigned) } }
		@table.Cell(table.CellProps{Class: "tabular-nums font-semibold"}) { { money.Format(spent) } }
		@table.Cell(table.CellProps{Class: "tabular-nums font-semibold"}) {
			@SignedMoney(available)
		}
		@table.Cell() { }
		@table.Cell() { }
	}
}

templ BudgetBody(d BudgetData) {
	@BudgetMonthSelector(d)
	<div class="flex items-start gap-6">
		<aside class="sticky top-20 hidden w-72 shrink-0 lg:block">
			@accountsoverview.AccountsOverview(d.Accounts)
		</aside>
		<div class="min-w-0 flex-1">
			@BudgetRegion(d)
		</div>
	</div>
}

// BudgetRegion is the initial-render container for the assignment-dependent
// sections: banner stats, the credit table, and the main budget table. On the
// full page load it renders everything; incremental assignment saves no longer
// swap this whole region — they replace just the edited row and refresh the
// banner + totals via out-of-band swaps (see BudgetAssignResult).
templ BudgetRegion(d BudgetData) {
	<div id="budget-region">
		@BudgetBanner(d)
		@BudgetCreditSection(d)
		@BudgetTable(d)
	</div>
}

// BudgetAssignResult is the response to a single assignment save. It replaces
// the edited category row (primary swap into #cat-<id>) and refreshes the two
// things a save can move: the footer totals and the summary banner. The totals
// <tr> is wrapped in a <template> so htmx's out-of-band swap survives the
// browser's table-parsing rules; the banner is a <div> and needs no wrapper.
templ BudgetAssignResult(month string, edited store.CategoryBudget, d BudgetData) {
	@BudgetRow(month, edited)
	<template>
		@BudgetTotalsRow(d, true)
	</template>
	@budgetBanner(d, true)
}

templ BudgetRow(month string, r store.CategoryBudget) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"id": fmt.Sprintf("cat-%d", r.CategoryID)}}) {
		@table.Cell(table.CellProps{Class: "pl-6"}) { { r.CategoryName } }
		@table.Cell() {
			<div class="flex items-center justify-end gap-2">
				<form
					hx-post={ fmt.Sprintf("/budget/assign/%d?month=%s", r.CategoryID, month) }
					hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
					hx-swap="outerHTML"
					class="js-assign flex items-center"
				>
					<button
						type="button"
						class="js-assign-display cursor-text rounded-md px-2 py-1 text-right text-sm tabular-nums ring-1 ring-transparent transition-shadow hover:ring-border"
						title="Click to edit"
					>
						{ money.Format(r.AssignedCents) }
					</button>
					<input
						type="text"
						name="amount"
						value={ money.Format(r.AssignedCents) }
						inputmode="decimal"
						autocomplete="off"
						class="js-assign-input hidden h-8 w-28 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Class:   "text-muted-foreground hover:text-foreground",
					Attributes: templ.Attributes{
						"hx-post":   fmt.Sprintf("/budget/assign/%d/copy-prev?month=%s", r.CategoryID, month),
						"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
						"hx-swap":   "outerHTML",
						"title":     "Copy from previous month",
					},
				}) {
					← prev
				}
			</div>
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) { { money.Format(r.SpentCents) } }
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			@SignedMoney(r.AvailableCents)
		}
		@table.Cell() {
			@GoalCell(r)
		}
		@table.Cell() { }
	}
}

templ GoalCell(r store.CategoryBudget) {
	if g, ok := format.GoalFor(r.GoalCents, r.GoalDueDate, r.MonthlyTarget); ok {
		<div class="flex flex-wrap items-center gap-1">
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				goal { g.Amount }
			}
			if g.Due != "" {
				<span class="text-xs text-muted-foreground">by { g.Due }</span>
			}
			if g.Need != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					need { g.Need }
				}
			}
		</div>
	}
}

templ SignedMoney(cents int64) {
	if cents > 0 {
		<span class="text-emerald-500 tabular-nums">{ money.Format(cents) }</span>
	} else if cents < 0 {
		<span class="text-red-500 tabular-nums">{ money.Format(cents) }</span>
	} else {
		<span class="text-muted-foreground tabular-nums">{ money.Format(cents) }</span>
	}
}

func formatMonth(m string) string {
	t, err := time.Parse("2006-01", m)
	if err != nil {
		return m
	}
	return t.Format("Jan 2006")
}

func nowMonth() string { return time.Now().Format("2006-01") }

func budgetTotals(grouped [][]store.CategoryBudget) (assigned, spent, available int64) {
	for _, group := range grouped {
		for _, r := range group {
			assigned += r.AssignedCents
			spent += r.SpentCents
			available += r.AvailableCents
		}
	}
	return
}
