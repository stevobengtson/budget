package views

import (
	"fmt"
	"time"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/accountsoverview"
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/table"
)

type BudgetData struct {
	Month       string // "YYYY-MM"
	PrevMonth   string
	NextMonth   string
	Estimated   int64
	Budgeted    int64
	Remain      int64
	CreditRows  []store.CreditActivity
	Groups      []BudgetGroup
	IncomeRows  []store.Income
	Accounts    []store.AccountWithBalance
}

// BudgetGroup is one category group plus its month rows, for rendering a
// per-group <tbody>. Empty groups (Rows == nil) still render so the user can
// add the first category to them.
type BudgetGroup struct {
	ID   int64
	Name string
	Rows []store.CategoryBudget
}

templ BudgetPage(d BudgetData) {
	@Layout("Budget", "budget") {
		@BudgetBody(d)
	}
}

templ BudgetMonthSelector(d BudgetData) {
	<div class="flex items-center justify-between gap-4">
		<h1 class="text-2xl font-semibold tracking-tight">{ formatMonth(d.Month) }</h1>
		<div class="flex items-center gap-2">
			@button.Button(button.Props{Href: "/budget?month=" + d.PrevMonth, Variant: button.VariantOutline, Size: button.SizeSm}) {
				‹ prev
			}
			@button.Button(button.Props{Href: "/budget?month=" + nowMonth(), Variant: button.VariantOutline, Size: button.SizeSm}) {
				today
			}
			@button.Button(button.Props{Href: "/budget?month=" + d.NextMonth, Variant: button.VariantOutline, Size: button.SizeSm}) {
				next ›
			}
		</div>
	</div>
}

// BudgetBanner renders the summary stat cards inside a stable #budget-banner
// container so a single assignment save can refresh it via an out-of-band swap
// (pass oob=true) without touching the rest of the page.
templ BudgetBanner(d BudgetData) {
	@budgetBanner(d, false)
}

templ budgetBanner(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "budget-banner", "class": "sticky top-16 z-10 bg-background py-4"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div { attrs... }>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
			@bannerStat("Income", money.Format(d.Estimated), "text-foreground")
			@bannerStat("Budgeted", money.Format(d.Budgeted), "text-foreground")
			@bannerStatSigned("Remain", d.Remain)
		</div>
	</div>
}

templ bannerStat(label, value, valueClass string) {
	@card.Card(card.Props{Class: "p-4"}) {
		<div class="text-xs uppercase tracking-wide text-muted-foreground">{ label }</div>
		<div class={ "mt-1 text-lg font-semibold tabular-nums " + valueClass }>{ value }</div>
	}
}

templ bannerStatSigned(label string, cents int64) {
	@card.Card(card.Props{Class: "p-4"}) {
		<div class="text-xs uppercase tracking-wide text-muted-foreground">{ label }</div>
		<div class="mt-1 text-lg font-semibold tabular-nums">
			@SignedMoney(cents)
		</div>
	}
}

templ BudgetCreditSection(d BudgetData) {
	if len(d.CreditRows) > 0 {
    @card.Card() {
      @card.Header() {
        @card.Title() {
          Credit
        }
      }
      @card.Content() {
        @table.Table() {
          @table.Header() {
            @table.Row() {
              @table.Head() { Account }
              @table.Head() { Purchases }
              @table.Head() { Payments }
              @table.Head() { Owing }
            }
          }
          @table.Body() {
            for _, ca := range d.CreditRows {
              @table.Row() {
                @table.Cell() { { ca.AccountName } }
                @table.Cell(table.CellProps{Class: "tabular-nums text-red-500"}) { { money.Format(ca.PurchasesCents) } }
                @table.Cell(table.CellProps{Class: "tabular-nums text-emerald-500"}) { { money.Format(ca.PaymentsCents) } }
                @table.Cell(table.CellProps{Class: "tabular-nums"}) {
                  @SignedMoney(ca.OwingCents)
                }
              }
            }
          }
        }
      }
    }
	}
}

templ BudgetTable(d BudgetData) {
	@table.Table(table.Props{Class: "mt-2"}) {
		@table.Header() {
			@table.Row() {
				@table.Head(table.HeadProps{Class: "w-[34%]"}) { Group / Category }
				@table.Head() { Assigned }
				@table.Head() { Spent }
				@table.Head() { Available }
				@table.Head() { Goal }
				@table.Head(table.HeadProps{Class: "text-right"}) {
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantGhost,
						Size:    button.SizeSm,
						Class:   "text-muted-foreground hover:text-foreground",
						Attributes: templ.Attributes{
							"hx-get":    "/budget/group/new",
							"hx-target": "#budget-totals-body",
							"hx-swap":   "beforebegin",
							"title":     "Add category group",
						},
					}) {
						+ group
					}
				}
			}
		}
		for _, g := range d.Groups {
			@BudgetGroupTbody(d.Month, g)
		}
		<tbody id="budget-totals-body">
			@BudgetTotalsRow(d, false)
		</tbody>
	}
}

templ BudgetGroupTbody(month string, g BudgetGroup) {
	<tbody id={ fmt.Sprintf("group-%d", g.ID) }>
		@BudgetGroupHeader(month, g)
		for _, r := range g.Rows {
			@BudgetRow(month, r)
		}
	</tbody>
}

templ BudgetGroupHeader(month string, g BudgetGroup) {
	@budgetGroupHeader(month, g, false)
}

// budgetGroupHeader renders a group's header row. When oob is true the <tr>
// carries hx-swap-oob so a response can refresh it out of band (used after
// adding the first category to a group, to drop the "delete empty group"
// control). An OOB bare <tr> must be wrapped in a <template> by the caller.
templ budgetGroupHeader(month string, g BudgetGroup, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("group-head-%d", g.ID), "class": "bg-muted/40 hover:bg-muted/40"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2 align-middle"}}) {
			<div class="flex items-center gap-2">
				<form
					hx-put={ fmt.Sprintf("/budget/group/%d?month=%s", g.ID, month) }
					hx-target={ fmt.Sprintf("#group-head-%d", g.ID) }
					hx-swap="outerHTML"
					class="flex items-center"
				>
					<button
						type="button"
						class="js-name-display cursor-text rounded-md px-1 py-0.5 text-xs font-semibold uppercase tracking-wide text-muted-foreground ring-1 ring-transparent hover:ring-border"
						title="Click to rename"
					>
						{ g.Name }
					</button>
					<input
						type="text"
						name="name"
						value={ g.Name }
						autocomplete="off"
						class="js-name-input hidden h-7 w-56 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Class:   "text-muted-foreground hover:text-foreground",
					Attributes: templ.Attributes{
						"hx-get":    fmt.Sprintf("/budget/group/%d/category/new?month=%s", g.ID, month),
						"hx-target": fmt.Sprintf("#group-%d", g.ID),
						"hx-swap":   "beforeend",
						"title":     "Add category",
					},
				}) {
					+ category
				}
				if len(g.Rows) == 0 {
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantGhost,
						Size:    button.SizeSm,
						Class:   "text-muted-foreground hover:text-destructive",
						Attributes: templ.Attributes{
							"hx-post":    fmt.Sprintf("/budget/group/%d/delete?month=%s", g.ID, month),
							"hx-target":  "#budget-region",
							"hx-swap":    "outerHTML",
							"hx-confirm": "Delete this empty group?",
							"title":      "Delete empty group",
						},
					}) {
						×
					}
				}
			</div>
		}
	}
}

// BudgetGroupNewRow is the transient editable <tbody> inserted by "+ group".
// name-edit.js submits it on Enter/blur or removes it if left empty.
templ BudgetGroupNewRow() {
	<tbody data-newrow>
		@table.Row() {
			@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2"}}) {
				<form hx-post="/budget/group" hx-target="closest tbody" hx-swap="outerHTML" class="flex items-center">
					<input
						type="text"
						name="name"
						autocomplete="off"
						autofocus
						placeholder="New group name"
						class="js-name-new h-7 w-56 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
			}
		}
	</tbody>
}

// BudgetTotalsRow is the footer totals row, factored out with a stable
// #budget-totals id so an assignment save can refresh just the totals via an
// out-of-band swap (oob=true) instead of re-rendering the whole table. When
// swapped OOB it must be wrapped in a <template> by the caller, because the
// browser strips a bare <tr> that isn't already inside a table.
templ BudgetTotalsRow(d BudgetData, oob bool) {
	{{ assigned, spent, available := budgetTotals(d.Groups) }}
	{{ attrs := templ.Attributes{"id": "budget-totals"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "font-semibold"}) { Totals }
		@table.Cell(table.CellProps{Class: "tabular-nums font-semibold"}) { { money.Format(assigned) } }
		@table.Cell(table.CellProps{Class: "tabular-nums font-semibold"}) { { money.Format(spent) } }
		@table.Cell(table.CellProps{Class: "tabular-nums font-semibold"}) {
			@SignedMoney(available)
		}
		@table.Cell() { }
		@table.Cell() { }
	}
}

templ BudgetBody(d BudgetData) {
	<div class="flex items-start gap-6">
		<aside class="sticky top-20 hidden w-72 shrink-0 lg:block">
			@accountsoverview.AccountsOverview(d.Accounts, d.Month)
		</aside>
		<div class="min-w-0 flex-1">
			@BudgetRegion(d)
		</div>
	</div>
}

// BudgetRegion is the initial-render container for the assignment-dependent
// sections: banner stats, the credit table, and the main budget table. On the
// full page load it renders everything; incremental assignment saves no longer
// swap this whole region — they replace just the edited row and refresh the
// banner + totals via out-of-band swaps (see BudgetAssignResult).
templ BudgetRegion(d BudgetData) {
	<div id="budget-region">
    @BudgetMonthSelector(d)
    @BudgetBanner(d)
    @BudgetIncomeSection(d)
		@BudgetCreditSection(d)
		@BudgetTable(d)
	</div>
}

// BudgetAssignResult is the response to a single assignment save. It replaces
// the edited category row (primary swap into #cat-<id>) and refreshes the two
// things a save can move: the footer totals and the summary banner. The totals
// <tr> is wrapped in a <template> so htmx's out-of-band swap survives the
// browser's table-parsing rules; the banner is a <div> and needs no wrapper.
templ BudgetAssignResult(month string, edited store.CategoryBudget, d BudgetData) {
	@BudgetRow(month, edited)
	<template>
		@BudgetTotalsRow(d, true)
	</template>
	@budgetBanner(d, true)
}

templ BudgetRow(month string, r store.CategoryBudget) {
	@budgetRow(month, r, false)
}

// budgetRow renders one category row. When oob is true the <tr> carries
// hx-swap-oob so a response can refresh it out of band (used by the goal save).
templ budgetRow(month string, r store.CategoryBudget, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("cat-%d", r.CategoryID), "class": "group"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "pl-6"}) {
			if r.IsIncome {
				{ r.CategoryName }
			} else {
				<form
					hx-put={ fmt.Sprintf("/budget/category/%d?month=%s", r.CategoryID, month) }
					hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
					hx-swap="outerHTML"
					class="flex items-center"
				>
					<button type="button" class="js-name-display cursor-text rounded-md px-1 py-0.5 text-sm ring-1 ring-transparent hover:ring-border" title="Click to rename">
						{ r.CategoryName }
					</button>
					<input
						type="text"
						name="name"
						value={ r.CategoryName }
						autocomplete="off"
						class="js-name-input hidden h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
			}
		}
		@table.Cell() {
			<div class="flex items-center justify-end gap-2">
				<form
					hx-post={ fmt.Sprintf("/budget/assign/%d?month=%s", r.CategoryID, month) }
					hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
					hx-swap="outerHTML"
					class="js-assign flex items-center"
				>
					<button
						type="button"
						class="js-assign-display cursor-text rounded-md px-2 py-1 text-right text-sm tabular-nums ring-1 ring-transparent transition-shadow hover:ring-border"
						title="Click to edit"
					>
						{ money.Format(r.AssignedCents) }
					</button>
					<input
						type="text"
						name="amount"
						value={ money.Format(r.AssignedCents) }
						inputmode="decimal"
						autocomplete="off"
						class="js-assign-input hidden h-8 w-28 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Class:   "text-muted-foreground hover:text-foreground",
					Attributes: templ.Attributes{
						"hx-post":   fmt.Sprintf("/budget/assign/%d/copy-prev?month=%s", r.CategoryID, month),
						"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
						"hx-swap":   "outerHTML",
						"title":     "Copy from previous month",
					},
				}) {
					← prev
				}
			</div>
		}
		@table.Cell(table.CellProps{Class: "tabular-nums"}) { { money.Format(r.SpentCents) } }
		@table.Cell(table.CellProps{Class: "tabular-nums"}) {
			@SignedMoney(r.AvailableCents)
		}
		@table.Cell() {
			if r.IsIncome {
				@GoalCell(r)
			} else {
				<button
					type="button"
					class="w-full cursor-pointer rounded-md px-1 py-0.5 text-left ring-1 ring-transparent hover:ring-border"
					hx-get={ fmt.Sprintf("/budget/goal/%d/edit?month=%s", r.CategoryID, month) }
					hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
					hx-swap="afterend"
					title="Click to set a goal"
				>
					@GoalCell(r)
				</button>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			if !r.IsIncome {
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Class:   "text-muted-foreground hover:text-destructive",
					Attributes: templ.Attributes{
						"hx-post":    fmt.Sprintf("/budget/category/%d/archive?month=%s", r.CategoryID, month),
						"hx-target":  "#budget-region",
						"hx-swap":    "outerHTML",
						"hx-confirm": "Archive this category?",
						"title":      "Archive category",
					},
				}) {
					×
				}
			}
		}
	}
}

// BudgetCategoryNewRow is the transient editable row inserted by "+ category".
// BudgetCategoryCreateResult swaps the transient new-category row into the real
// row and refreshes the group header out of band so its "delete empty group"
// control disappears once the group has a category.
templ BudgetCategoryCreateResult(month string, r store.CategoryBudget, g BudgetGroup) {
	@BudgetRow(month, r)
	<template>
		@budgetGroupHeader(month, g, true)
	</template>
}

templ BudgetCategoryNewRow(month string, gid int64) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-newrow": ""}}) {
		@table.Cell(table.CellProps{Class: "pl-6"}) {
			<form hx-post={ fmt.Sprintf("/budget/group/%d/category?month=%s", gid, month) } hx-target="closest tr" hx-swap="outerHTML" class="flex items-center">
				<input
					type="text"
					name="name"
					autocomplete="off"
					autofocus
					placeholder="new category"
					class="js-name-new h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
				/>
			</form>
		}
		@table.Cell() { }
		@table.Cell() { }
		@table.Cell() { }
		@table.Cell() { }
		@table.Cell() { }
	}
}

// BudgetGoalEditor is the expanding editor row inserted below a category row.
// It is pre-filled with the current goal so it edits and clears as well as sets.
templ BudgetGoalEditor(month string, r store.CategoryBudget) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"id": fmt.Sprintf("goal-edit-%d", r.CategoryID)}}) {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "bg-muted/20 p-2"}}) {
			<form
				hx-post={ fmt.Sprintf("/budget/goal/%d?month=%s", r.CategoryID, month) }
				hx-target={ fmt.Sprintf("#goal-edit-%d", r.CategoryID) }
				hx-swap="outerHTML"
				class="flex flex-wrap items-end gap-3"
			>
				<div class="grid gap-1">
					<label class="text-xs text-muted-foreground">Goal $</label>
					<input type="text" name="goal_cents" value={ goalCentsValue(r) } inputmode="decimal" placeholder="(optional)" autocomplete="off" class="h-8 w-32 rounded-md border border-input bg-transparent px-2 text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				</div>
				<div class="grid gap-1">
					<label class="text-xs text-muted-foreground">Goal due</label>
					<input type="date" name="goal_due" value={ goalDueValue(r) } class="h-8 w-40 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				</div>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm}) {
					save
				}
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-on:click": fmt.Sprintf("document.getElementById('goal-edit-%d').remove()", r.CategoryID),
					},
				}) {
					cancel
				}
			</form>
		}
	}
}

// BudgetGoalResult removes the editor row (empty primary target) and refreshes
// the category row out of band. The <template> wrapper lets the OOB <tr>
// survive the browser's table-parsing rules (same trick as BudgetTotalsRow).
templ BudgetGoalResult(month string, r store.CategoryBudget) {
	<template>
		@budgetRow(month, r, true)
	</template>
}

func goalCentsValue(r store.CategoryBudget) string {
	if r.GoalCents != nil {
		return money.Format(*r.GoalCents)
	}
	return ""
}

func goalDueValue(r store.CategoryBudget) string {
	if r.GoalDueDate != nil {
		return r.GoalDueDate.Format("2006-01-02")
	}
	return ""
}

templ GoalCell(r store.CategoryBudget) {
	if g, ok := format.GoalFor(r.GoalCents, r.GoalDueDate, r.MonthlyTarget); ok {
		<div class="flex flex-wrap items-center gap-1">
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				goal { g.Amount }
			}
			if g.Due != "" {
				<span class="text-xs text-muted-foreground">by { g.Due }</span>
			}
			if g.Need != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					need { g.Need }
				}
			}
		</div>
	}
}

templ SignedMoney(cents int64) {
	if cents > 0 {
		<span class="text-emerald-500 tabular-nums">{ money.Format(cents) }</span>
	} else if cents < 0 {
		<span class="text-red-500 tabular-nums">{ money.Format(cents) }</span>
	} else {
		<span class="text-muted-foreground tabular-nums">{ money.Format(cents) }</span>
	}
}

func formatMonth(m string) string {
	t, err := time.Parse("2006-01", m)
	if err != nil {
		return m
	}
	return t.Format("Jan 2006")
}

func nowMonth() string { return time.Now().Format("2006-01") }

func budgetTotals(groups []BudgetGroup) (assigned, spent, available int64) {
	for _, g := range groups {
		for _, r := range g.Rows {
			assigned += r.AssignedCents
			spent += r.SpentCents
			available += r.AvailableCents
		}
	}
	return
}

templ BudgetIncomeSection(d BudgetData) {
	<div class="mb-2 mt-6 flex items-center justify-between gap-2">
    @card.Card() {
      @card.Header() {
        @card.Title() {
          Income
        }
      }
      @card.Content() {
        @table.Table() {
          @table.Header() {
            @table.Row() {
              @table.Head() { Source }
              @table.Head(table.HeadProps{Class: "text-right"}) { Amount }
              @table.Head(table.HeadProps{Class: "w-10"}) { }
            }
          }
          <tbody id="income-rows">
            for _, r := range d.IncomeRows {
              @IncomeRow(d.Month, r)
            }
          </tbody>
          <tfoot>
            @IncomeTotalsRow(d, false)
          </tfoot>
        }
      }
      @card.Footer(card.FooterProps{ Class: "flex justify-between" }) {
        @button.Button(button.Props{
          Type:    "button",
          Variant: button.VariantOutline,
          Size:    button.SizeSm,
          Class:   "text-muted-foreground hover:text-foreground",
          Attributes: templ.Attributes{
            "hx-post":    "/budget/income/copy-prev?month=" + d.Month,
            "hx-target":  "#budget-region",
            "hx-swap":    "outerHTML",
            "hx-confirm": "Copy all entries from the previous month into this one?",
            "title":      "Copy every entry from the previous month",
          },
        }) {
          ← copy from prev
        }
        @button.Button(button.Props{
          Type:    "button",
          Size:    button.SizeSm,
          Attributes: templ.Attributes{
            "hx-get":    "/budget/income/new?month=" + d.Month,
            "hx-target": "#income-rows",
            "hx-swap":   "beforeend",
            "title":     "Add income",
          },
        }) {
          Add
        }
      }
    }
	</div>
}

// IncomeTotalsRow is the income table footer, with a stable #income-totals id so
// an income mutation can refresh just the total via an out-of-band swap
// (oob=true) instead of re-rendering the section. When swapped OOB it must be
// wrapped in a <template> by the caller, because the browser strips a bare <tr>
// that isn't already inside a table.
templ IncomeTotalsRow(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "income-totals"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "font-semibold"}) { Total }
		@table.Cell(table.CellProps{Class: "text-right font-semibold tabular-nums text-emerald-500"}) {
			{ money.Format(incomeTotal(d.IncomeRows)) }
		}
		@table.Cell() { }
	}
}

func incomeTotal(rows []store.Income) (total int64) {
	for _, r := range rows {
		total += r.AmountCents
	}
	return
}

templ IncomeRow(month string, r store.Income) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"id": fmt.Sprintf("income-%d", r.ID), "class": "group"}}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="flex items-center">
				<button type="button" class="js-name-display cursor-text rounded-md px-1 py-0.5 text-sm ring-1 ring-transparent hover:ring-border" title="Click to rename">
					{ r.Name }
				</button>
				<input type="text" name="name" value={ r.Name } autocomplete="off" class="js-name-input hidden h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</form>
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			<form hx-put={ fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month) } hx-target={ fmt.Sprintf("#income-%d", r.ID) } hx-swap="outerHTML" class="js-assign flex items-center justify-end">
				<button type="button" class="js-assign-display cursor-text rounded-md px-2 py-1 text-right text-sm tabular-nums text-emerald-500 ring-1 ring-transparent hover:ring-border" title="Click to edit">
					{ money.Format(r.AmountCents) }
				</button>
				<input type="text" name="amount" value={ money.Format(r.AmountCents) } inputmode="decimal" autocomplete="off" class="js-assign-input hidden h-8 w-28 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
			</form>
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			@button.Button(button.Props{
				Type:    "button",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Class:   "text-muted-foreground hover:text-destructive",
				Attributes: templ.Attributes{
					"hx-delete":  fmt.Sprintf("/budget/income/%d?month=%s", r.ID, month),
					"hx-target":  fmt.Sprintf("#income-%d", r.ID),
					"hx-swap":    "outerHTML",
					"hx-confirm": "Delete this income entry?",
					"title":      "Delete",
				},
			}) {
				×
			}
		}
	}
}

// IncomeNewRow is the transient add-income row (multi-field -> explicit Save,
// like the goal editor, not blur-save).
templ IncomeNewRow(month string) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-newrow": ""}}) {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "3", "class": "p-2"}}) {
			<form hx-post={ "/budget/income?month=" + month } hx-target="closest tr" hx-swap="outerHTML" class="flex flex-wrap items-end gap-3">
				<input type="text" name="name" autofocus placeholder="Source" autocomplete="off" class="h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				<input type="text" name="amount" placeholder="0.00" inputmode="decimal" autocomplete="off" class="h-8 w-32 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm}) {
					save
				}
				@button.Button(button.Props{
					Type:       "button",
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"hx-on:click": "this.closest('tr').remove()"},
				}) {
					cancel
				}
			</form>
		}
	}
}

// BudgetIncomeRowResult refreshes one income row plus the OOB banner and income
// total (income changes move Estimated / Remain and the footer sum).
templ BudgetIncomeRowResult(month string, r store.Income, d BudgetData) {
	@IncomeRow(month, r)
	@budgetBanner(d, true)
	<template>
		@IncomeTotalsRow(d, true)
	</template>
}

// BudgetIncomeDeleteResult removes the income row (empty primary target) and
// refreshes the banner + income total out of band.
templ BudgetIncomeDeleteResult(d BudgetData) {
	@budgetBanner(d, true)
	<template>
		@IncomeTotalsRow(d, true)
	</template>
}
