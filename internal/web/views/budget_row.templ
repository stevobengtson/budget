package views

import (
	"fmt"
	"time"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/datepicker"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
)

templ BudgetRow(month string, r store.CategoryBudget) {
	@budgetRow(month, r, false)
}

// budgetRow renders one category as four columns: name, an editable Assigned
// field, a progress bar, and Available as the headline figure. Spent is no
// longer its own column — it is the progress bar's numerator and the wording
// beneath it — which is what frees the row down to two numbers.
//
// When oob is true it carries hx-swap-oob so a response can refresh it out of
// band (used by the goal save).
templ budgetRow(month string, r store.CategoryBudget, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("cat-%d", r.CategoryID)} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	{{ attrs["data-category"] = "" }}
	{{ attrs["data-category-id"] = fmt.Sprintf("%d", r.CategoryID) }}
	{{ attrs["data-available"] = fmt.Sprintf("%d", r.AvailableCents) }}
	{{ rowClass := budgetGridCols + " group rounded-md px-s3 py-[9px]" }}
	if r.AvailableCents < 0 {
		{{ rowClass += " bg-surface-overspent" }}
	}
	<div class={ rowClass } { attrs... }>
		<div class="col-start-1 row-start-1 flex min-w-0 items-center gap-1">
			<span
				class="js-category-handle hidden cursor-grab touch-none items-center text-warm-400 opacity-0 transition-opacity group-hover:opacity-100 md:inline-flex"
				title="Drag to reorder category"
				aria-hidden="true"
			>
				@icon.GripVertical(icon.Props{Class: "size-4"})
			</span>
			<form
				hx-put={ fmt.Sprintf("/budget/category/%d?month=%s", r.CategoryID, month) }
				hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
				hx-swap="outerHTML"
				class="flex min-w-0 items-center"
			>
				<button type="button" class="js-name-display cursor-text truncate rounded-sm px-1 py-0.5 text-[16px] font-semibold ring-1 ring-transparent hover:ring-border" title="Click to rename">
					{ r.CategoryName }
				</button>
				<input
					type="text"
					name="name"
					value={ r.CategoryName }
					autocomplete="off"
					class="js-name-input hidden h-9 w-[220px] rounded-pill border border-primary bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-ring"
				/>
			</form>
		</div>
		@GoalCell(r)
		<form
			hx-post={ fmt.Sprintf("/budget/assign/%d?month=%s", r.CategoryID, month) }
			hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
			hx-swap="outerHTML"
			class="js-assign col-start-3 row-start-1 hidden items-center justify-end @min-[660px]:flex"
		>
			<button
				type="button"
				class="js-assign-display h-9 w-full cursor-text rounded-pill bg-surface-sunk px-s3 text-right text-[15px] font-semibold tabular-nums ring-1 ring-transparent transition-shadow hover:ring-border"
				title="Click to edit"
			>
				{ money.Format(r.AssignedCents) }
			</button>
			<input
				type="text"
				name="amount"
				value={ money.Format(r.AssignedCents) }
				inputmode="decimal"
				autocomplete="off"
				class="js-assign-input hidden h-9 w-full rounded-pill border border-primary bg-surface-sunk px-s3 text-right text-[15px] font-semibold tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"
			/>
		</form>
		@budgetProgress(r)
		<div class="col-start-2 row-start-1 row-span-2 flex items-center justify-end gap-1 @min-[660px]:col-start-4 @min-[660px]:row-span-1 @min-[950px]:col-start-5">
			// At tier 1 Available doubles as the assign control: the Assigned column
			// is not rendered and a 36px number field could not survive the reflow,
			// so tapping the figure opens the assign sheet instead of editing in
			// place. It hands over at the same width the Assigned field appears.
			<button
				type="button"
				class={ "flex min-h-[44px] items-center gap-1 rounded-md px-1 text-[19px] font-bold tabular-nums @min-[660px]:hidden", availColorClass(r.AvailableCents) }
				aria-label={ "Assign to " + r.CategoryName }
				hx-get={ fmt.Sprintf("/budget/assign/%d/sheet?month=%s", r.CategoryID, month) }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				{ money.Format(r.AvailableCents) }
				@icon.ChevronRight(icon.Props{Class: "size-4 text-muted-foreground"})
			</button>
			<span class={ "hidden text-[17px] font-bold tabular-nums @min-[660px]:inline", availColorClass(r.AvailableCents) }>
				{ money.Format(r.AvailableCents) }
			</span>
			// Hover-reveal is a pointer affordance; on touch the menu must simply
			// be there.
			<span class="opacity-100 transition-opacity md:opacity-0 md:group-focus-within:opacity-100 md:group-hover:opacity-100">
				@rowMenu(month, r)
			</span>
		</div>
	</div>
}

// budgetProgress is the spent-against-assigned bar plus a worded note. An
// overspent category pins the bar to full width in terracotta and says so in
// words, so the state never rests on colour alone.
templ budgetProgress(r store.CategoryBudget) {
	{{ pct, over := progressPct(r.SpentCents, r.AvailableCents) }}
	{{ envelope := r.SpentCents + r.AvailableCents }}
	<div class="col-start-1 row-start-2 flex flex-col gap-1 @min-[950px]:col-start-4 @min-[950px]:row-start-1">
		<div class="h-[7px] w-full overflow-hidden rounded-pill bg-progress-track @min-[950px]:h-2">
			<div
				class={ "h-full rounded-pill", templ.KV("bg-progress-fill-over", over), templ.KV("bg-progress-fill", !over) }
				style={ fmt.Sprintf("width:%d%%", pct) }
			></div>
		</div>
		<span class="truncate text-[12px] text-muted-foreground">
			if over {
				{ money.Format(-r.AvailableCents) } overspent
			} else {
				{ money.Format(r.SpentCents) } of { money.Format(envelope) }
			}
		</span>
	</div>
}

// progressPct returns the bar width as a whole percentage and whether the
// category is overspent.
//
// The bar measures spending against everything in the envelope this month, not
// against this month's assignment alone: the store defines
// Available = carryover + assigned − spent, so the envelope is spent + available.
// Using AssignedCents instead understates a category carrying money forward — a
// category with $60 rolled over and $5 assigned would read "$1.00 of $5.00"
// while its Available column correctly said $64.
//
// Overspent is taken straight from Available being negative, so the bar and the
// Available figure can never disagree about the state of a row.
func progressPct(spent, available int64) (int, bool) {
	if available < 0 {
		return 100, true
	}
	envelope := spent + available
	if envelope <= 0 || spent <= 0 {
		return 0, false
	}
	if spent >= envelope {
		return 100, false
	}
	return int(spent * 100 / envelope), false
}

// BudgetAssignResult is the response to a single assignment save. It replaces
// the edited category row (primary swap into #cat-<id>) and refreshes the
// summary rail out of band, since an assignment moves Assigned, Available,
// Still-in-envelopes and Ready-to-assign.
templ BudgetAssignResult(month string, edited store.CategoryBudget, d BudgetData) {
	@BudgetRow(month, edited)
	@BudgetRail(d, true)
}

// BudgetCategoriesReorderResult refreshes the affected group headers out of band
// after a category drag. The drag-sort JS already moved the rows in the DOM; the
// only stale bit is each affected group's "delete empty group" control, which
// depends on whether the group now has categories.
templ BudgetCategoriesReorderResult(d BudgetData, affected []int64) {
	for _, gid := range affected {
		if g, ok := findGroup(d.Groups, gid); ok {
			@budgetGroupHeader(d.Month, g, true)
		}
	}
}

func findGroup(groups []BudgetGroup, gid int64) (BudgetGroup, bool) {
	for _, g := range groups {
		if g.ID == gid {
			return g, true
		}
	}
	return BudgetGroup{}, false
}

// rowMenu renders the per-category actions menu. The two rollover items post the
// target mode computed from the row's current one and keep the menu open
// (PreventClose) so both can be flipped in one visit. The labels say what the
// flags do rather than naming them.
templ rowMenu(month string, r store.CategoryBudget) {
	{{ rolloverOn := r.RolloverMode != store.RolloverNone }}
	{{ ignoreNeg := r.RolloverMode == store.RolloverCarryPositive }}
	{{
		rolloverTarget := store.RolloverCarryPositive // turning ON defaults to ignore-negative
		if rolloverOn {
			rolloverTarget = store.RolloverNone
		}
		ignoreTarget := store.RolloverCarryPositive
		if ignoreNeg {
			ignoreTarget = store.RolloverCarry
		}
	}}
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class:      "inline-flex size-8 items-center justify-center rounded-pill text-muted-foreground hover:bg-foreground/[0.07] hover:text-foreground",
			Attributes: templ.Attributes{"title": "Category actions"},
		}) {
			@icon.EllipsisVertical(icon.Props{Class: "size-4"})
		}
		@dropdown.Content(dropdown.ContentProps{Class: "w-[264px]"}) {
			@dropdown.Item(dropdown.ItemProps{
				Href: fmt.Sprintf("/transactions?category=%d&month=%s", r.CategoryID, month),
			}) {
				See transactions
			}
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-get":    fmt.Sprintf("/budget/goal/%d/edit?month=%s", r.CategoryID, month),
					"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
					"hx-swap":   "afterend",
					// afterend inserts, so choosing "Set a goal" again would stack a
					// second editor under the row. Drop any open one first, making the
					// action idempotent.
					"hx-on:click": fmt.Sprintf("document.getElementById('goal-edit-%d')?.remove()", r.CategoryID),
				},
			}) {
				Set a goal
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				PreventClose: true,
				Attributes: templ.Attributes{
					"hx-post":   fmt.Sprintf("/budget/category/%d/rollover?month=%s", r.CategoryID, month),
					"hx-vals":   fmt.Sprintf(`{"mode":"%s"}`, rolloverTarget),
					"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
					"hx-swap":   "outerHTML",
				},
			}) {
				@menuCheck(rolloverOn)
				Carry the balance forward
			}
			@dropdown.Item(dropdown.ItemProps{
				PreventClose: true,
				Disabled:     !rolloverOn,
				Attributes: templ.Attributes{
					"hx-post":   fmt.Sprintf("/budget/category/%d/rollover?month=%s", r.CategoryID, month),
					"hx-vals":   fmt.Sprintf(`{"mode":"%s"}`, ignoreTarget),
					"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
					"hx-swap":   "outerHTML",
				},
			}) {
				@menuCheck(ignoreNeg)
				Ignore overspending
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-post":   fmt.Sprintf("/budget/assign/%d/copy-prev?month=%s", r.CategoryID, month),
					"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
					"hx-swap":   "outerHTML",
				},
			}) {
				Same as last month
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class: "text-money-negative",
				Attributes: templ.Attributes{
					"hx-post":    fmt.Sprintf("/budget/category/%d/archive?month=%s", r.CategoryID, month),
					"hx-target":  "#budget-region",
					"hx-swap":    "outerHTML",
					"hx-confirm": "Archive this category?",
				},
			}) {
				Archive category
			}
		}
	}
}

// menuCheck shows a leading tick for an enabled toggle, or a blank gutter of the
// same width so labels stay aligned whether checked or not.
templ menuCheck(on bool) {
	<span class="mr-2 inline-flex w-4 shrink-0 items-center">
		if on {
			@icon.Check(icon.Props{Class: "size-4 text-money-positive"})
		}
	</span>
}

// BudgetCategoryCreateResult swaps the transient new-category row into the real
// row and refreshes the group header out of band so its "delete empty group"
// control disappears once the group has a category.
templ BudgetCategoryCreateResult(month string, r store.CategoryBudget, g BudgetGroup) {
	@BudgetRow(month, r)
	@budgetGroupHeader(month, g, true)
}

templ BudgetCategoryNewRow(month string, gid int64) {
	<div data-newrow class="px-s3 py-s2">
		<form hx-post={ fmt.Sprintf("/budget/group/%d/category?month=%s", gid, month) } hx-target="closest [data-newrow]" hx-swap="outerHTML" class="flex items-center gap-s3">
			<input
				type="text"
				name="name"
				autocomplete="off"
				autofocus
				placeholder="New category"
				class="js-name-new h-9 w-[220px] rounded-pill border border-primary bg-surface-sunk px-s3 text-[15px] outline-none focus-visible:ring-2 focus-visible:ring-ring"
			/>
			<span class="text-[13px] text-muted-foreground">⏎ adds it · Esc cancels</span>
		</form>
	</div>
}

// BudgetGoalEditor is the panel that opens directly beneath a category row.
templ BudgetGoalEditor(month string, r store.CategoryBudget) {
	<div id={ fmt.Sprintf("goal-edit-%d", r.CategoryID) } class="mx-s3 mb-s2 rounded-md bg-surface-quickadd p-s4">
		<form
			hx-post={ fmt.Sprintf("/budget/goal/%d?month=%s", r.CategoryID, month) }
			hx-target={ fmt.Sprintf("#goal-edit-%d", r.CategoryID) }
			hx-swap="outerHTML"
			class="flex flex-col gap-s3"
		>
			<span class="text-[12px] font-bold uppercase tracking-[0.08em] text-muted-foreground">
				Goal for { r.CategoryName }
			</span>
			<div class="flex flex-wrap items-end gap-s3">
				<div class="grid gap-1">
					<label class="text-[12px] font-semibold text-muted-foreground">Target amount</label>
					<input type="text" name="goal_cents" value={ goalCentsValue(r) } inputmode="decimal" placeholder="(optional)" autocomplete="off" class="h-9 w-[160px] rounded-pill border border-input bg-surface-sunk px-s3 text-[15px] tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				</div>
				<div class="grid gap-1" data-goal-due>
					<label class="text-[12px] font-semibold text-muted-foreground">Needed by</label>
					<div class="flex items-center gap-s2">
						@datepicker.DatePicker(datepicker.Props{
							Name:        "goal_due",
							Value:       goalDueTime(r),
							Placeholder: "No date",
							Class:       "w-[200px]",
						})
						// A due date is optional, and templUI's datepicker has no clear
						// of its own — once picked there would be no way back. Emptying
						// the hidden input and firing `input` is what the component
						// itself listens for, so the display falls back to the
						// placeholder.
						<button
							type="button"
							title="Clear the date"
							class="shrink-0 rounded-pill px-2 py-1 text-[13px] text-muted-foreground underline-offset-2 hover:text-foreground hover:underline"
							onclick="const i=this.closest('[data-goal-due]').querySelector('[data-tui-datepicker-hidden-input]'); if(i){i.value='';i.dispatchEvent(new Event('input',{bubbles:true}));}"
						>
							clear
						</button>
					</div>
				</div>
				// hx-target on the preview MUST be explicit: htmx inherits hx-target
				// from ancestors, and the enclosing form targets the whole editor
				// panel, so without it the preview swap replaces the editor itself
				// with the figure.
				//
				// Always present, and refreshed from the server as the target or date
				// changes — it used to appear only once a goal had been saved, so
				// setting a new one gave no feedback until after the fact. The figure
				// is computed by the same store.MonthlyTarget the saved row uses, so
				// the preview and the result cannot disagree.
				<div class="grid gap-1">
					<span class="text-[12px] font-semibold text-muted-foreground">To arrive on time</span>
					<div
						id={ fmt.Sprintf("goal-need-%d", r.CategoryID) }
						hx-post={ fmt.Sprintf("/budget/goal/%d/preview?month=%s", r.CategoryID, month) }
						hx-trigger={ fmt.Sprintf("change from:#goal-edit-%d, keyup changed delay:400ms from:#goal-edit-%d", r.CategoryID, r.CategoryID) }
						hx-include={ fmt.Sprintf("#goal-edit-%d", r.CategoryID) }
						hx-target="this"
						hx-swap="innerHTML"
					>
						@GoalNeed(r.MonthlyTarget)
					</div>
				</div>
				<div class="ml-auto flex items-center gap-s2">
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantGhost,
						Size:    button.SizeSm,
						Class:   "rounded-pill",
						Attributes: templ.Attributes{
							"hx-on:click": fmt.Sprintf("document.getElementById('goal-edit-%d').remove()", r.CategoryID),
						},
					}) {
						Cancel
					}
					@button.Button(button.Props{Type: "submit", Size: button.SizeSm, Class: "rounded-pill"}) {
						Save goal
					}
				</div>
			</div>
		</form>
	</div>
}

// BudgetGoalResult removes the editor (empty primary target) and refreshes the
// category row out of band.
templ BudgetGoalResult(month string, r store.CategoryBudget) {
	@budgetRow(month, r, true)
}

func goalCentsValue(r store.CategoryBudget) string {
	if r.GoalCents != nil {
		return money.Format(*r.GoalCents)
	}
	return ""
}

// GoalNeed is the "to arrive on time" figure, on its own so the goal editor can
// swap just this fragment while the target and date are being edited. A zero
// target means the goal is already met, has no date, or is not set yet — all of
// which read better as a dash than as $0.00/mo.
templ GoalNeed(monthlyTarget int64) {
	if monthlyTarget > 0 {
		<span class="font-heading text-[22px] font-semibold tabular-nums text-surface-attention-fg">
			{ money.Format(monthlyTarget) }/mo
		</span>
	} else {
		<span class="font-heading text-[22px] font-semibold text-muted-foreground">—</span>
	}
}

// goalDueTime is the goal's due date for the picker. The zero time means "no
// date", which the picker renders as its placeholder and posts as empty — the
// handler then stores a nil due date.
func goalDueTime(r store.CategoryBudget) time.Time {
	if r.GoalDueDate != nil {
		return *r.GoalDueDate
	}
	return time.Time{}
}

// GoalCell shows a category's goal at a glance: the target, and what has to go
// in each month to reach it in time. Read-only — the goal is edited from the row
// menu's "Set a goal", which opens the editor panel beneath the row — so this
// column stays a statement of where the category stands rather than another
// control competing with the Assigned field beside it.
//
// Hidden at tier 1, like the Assigned field: the reflow gives each row two
// columns, and the goal is still reachable through the row menu.
//
// Stays on the first grid row at every tier. At tier 2 the progress bar sits
// beneath the name, so the row is two lines tall — but spanning both and
// centring against them left the name riding the top line alone while every
// figure floated in the middle. Name, goal, assigned and available all read as
// one line, with the bar hanging below it.
templ GoalCell(r store.CategoryBudget) {
	<div class="col-start-2 row-start-1 hidden min-w-0 flex-col items-start gap-0.5 @min-[660px]:flex">
		if g, ok := format.GoalFor(r.GoalCents, r.GoalDueDate, r.MonthlyTarget); ok {
			// The tag holds the target and nothing else. Putting the deadline in it
			// too made one pill carry two facts, which filled the column edge to
			// edge however wide it was; the deadline belongs with the monthly
			// figure, since together they are the one sentence — this much a month,
			// until then.
			<span class="max-w-full truncate rounded-pill bg-tag-sage-bg px-2 py-0.5 text-[12px] font-semibold text-tag-sage-fg">
				{ g.Amount }
			</span>
			if g.Need != "" || g.Due != "" {
				<span class="max-w-full truncate text-[12px] text-muted-foreground">
					if g.Need != "" && g.Due != "" {
						{ g.Need } · by { g.Due }
					} else if g.Need != "" {
						{ g.Need }
					} else {
						by { g.Due }
					}
				</span>
			}
		}
	</div>
}
