package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/signedmoney"
	"github.com/templui/templui/components/badge"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/table"
)

templ BudgetRow(month string, r store.CategoryBudget) {
	@budgetRow(month, r, false)
}

// budgetRow renders one category row. When oob is true the <tr> carries
// hx-swap-oob so a response can refresh it out of band (used by the goal save).
templ budgetRow(month string, r store.CategoryBudget, oob bool) {
	{{ attrs := templ.Attributes{"id": fmt.Sprintf("cat-%d", r.CategoryID), "class": "group"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	if !r.IsIncome {
		{{ attrs["data-category"] = "" }}
		{{ attrs["data-category-id"] = fmt.Sprintf("%d", r.CategoryID) }}
	}
	@table.Row(table.RowProps{Attributes: attrs}) {
		@table.Cell(table.CellProps{Class: "pl-6"}) {
			if r.IsIncome {
				{ r.CategoryName }
			} else {
				<div class="flex items-center gap-1">
					<span
						class="js-category-handle inline-flex cursor-grab touch-none items-center text-muted-foreground/40 hover:text-foreground"
						title="Drag to reorder category"
						aria-hidden="true"
					>
						@icon.GripVertical(icon.Props{Class: "size-3.5"})
					</span>
					<form
						hx-put={ fmt.Sprintf("/budget/category/%d?month=%s", r.CategoryID, month) }
						hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
						hx-swap="outerHTML"
						class="flex items-center"
					>
						<button type="button" class="js-name-display cursor-text rounded-md px-1 py-0.5 text-sm ring-1 ring-transparent hover:ring-border" title="Click to rename">
							{ r.CategoryName }
						</button>
						<input
							type="text"
							name="name"
							value={ r.CategoryName }
							autocomplete="off"
							class="js-name-input hidden h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
						/>
					</form>
				</div>
			}
		}
		@table.Cell() {
			<div class="flex items-center justify-end gap-2">
				<form
					hx-post={ fmt.Sprintf("/budget/assign/%d?month=%s", r.CategoryID, month) }
					hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
					hx-swap="outerHTML"
					class="js-assign flex items-center"
				>
					<button
						type="button"
						class="js-assign-display cursor-text rounded-md px-2 py-1 text-right text-sm tabular-nums ring-1 ring-transparent transition-shadow hover:ring-border"
						title="Click to edit"
					>
						{ money.Format(r.AssignedCents) }
					</button>
					<input
						type="text"
						name="amount"
						value={ money.Format(r.AssignedCents) }
						inputmode="decimal"
						autocomplete="off"
						class="js-assign-input hidden h-8 w-28 rounded-md border border-input bg-transparent px-2 text-right text-sm tabular-nums shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring"
					/>
				</form>
			</div>
		}
		@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums"}) {
			{ money.Format(r.SpentCents) }
		}
		@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums"}) {
			@signedmoney.Money(r.AvailableCents)
		}
		@table.Cell() {
			if r.IsIncome {
				@GoalCell(r)
			} else {
				<button
					type="button"
					class="w-full cursor-pointer rounded-md px-1 py-0.5 text-left ring-1 ring-transparent hover:ring-border"
					hx-get={ fmt.Sprintf("/budget/goal/%d/edit?month=%s", r.CategoryID, month) }
					hx-target={ fmt.Sprintf("#cat-%d", r.CategoryID) }
					hx-swap="afterend"
					title="Click to set a goal"
				>
					@GoalCell(r)
				</button>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			if !r.IsIncome {
				@rowMenu(month, r)
			}
		}
	}
}

// BudgetAssignResult is the response to a single assignment save. It replaces
// the edited category row (primary swap into #cat-<id>) and refreshes the footer
// summary (totals + income/left-to-assign) out of band, since an assignment
// moves Budgeted, Available and Left to assign.
templ BudgetAssignResult(month string, edited store.CategoryBudget, d BudgetData) {
	@BudgetRow(month, edited)
	@BudgetSummary(d, true)
}

// BudgetCategoriesReorderResult refreshes the affected group headers out of band
// after a category drag. The drag-sort JS already moved the rows in the DOM; the
// only stale bit is each affected group's "delete empty group" control, which
// depends on whether the group now has categories. Groups come from BudgetData
// (buildGroups keeps emptied groups, with their name), so an emptied source
// group still renders its name and regains the delete control.
templ BudgetCategoriesReorderResult(d BudgetData, affected []int64) {
	for _, gid := range affected {
		if g, ok := findGroup(d.Groups, gid); ok {
			<template>
				@budgetGroupHeader(d.Month, g, true)
			</template>
		}
	}
}

func findGroup(groups []BudgetGroup, gid int64) (BudgetGroup, bool) {
	for _, g := range groups {
		if g.ID == gid {
			return g, true
		}
	}
	return BudgetGroup{}, false
}

// rowMenu renders the per-category three-dot actions menu: rollover toggles,
// copy-from-previous-month, and delete (archive). The two toggle items post the
// target rollover mode computed from the row's current mode and keep the menu
// open (PreventClose) so both can be flipped in one visit.
templ rowMenu(month string, r store.CategoryBudget) {
	{{ rolloverOn := r.RolloverMode != store.RolloverNone }}
	{{ ignoreNeg := r.RolloverMode == store.RolloverCarryPositive }}
	{{
		rolloverTarget := store.RolloverCarryPositive // turning ON defaults to ignore-negative
		if rolloverOn {
			rolloverTarget = store.RolloverNone
		}
		ignoreTarget := store.RolloverCarryPositive
		if ignoreNeg {
			ignoreTarget = store.RolloverCarry
		}
	}}
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class:      "inline-flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground",
			Attributes: templ.Attributes{"title": "Category actions"},
		}) {
			@icon.EllipsisVertical(icon.Props{Class: "size-4"})
		}
		@dropdown.Content() {
			@dropdown.Item(dropdown.ItemProps{
				PreventClose: true,
				Attributes: templ.Attributes{
					"hx-post":   fmt.Sprintf("/budget/category/%d/rollover?month=%s", r.CategoryID, month),
					"hx-vals":   fmt.Sprintf(`{"mode":"%s"}`, rolloverTarget),
					"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
					"hx-swap":   "outerHTML",
				},
			}) {
				@menuCheck(rolloverOn)
				Rollover
			}
			@dropdown.Item(dropdown.ItemProps{
				PreventClose: true,
				Disabled:     !rolloverOn,
				Attributes: templ.Attributes{
					"hx-post":   fmt.Sprintf("/budget/category/%d/rollover?month=%s", r.CategoryID, month),
					"hx-vals":   fmt.Sprintf(`{"mode":"%s"}`, ignoreTarget),
					"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
					"hx-swap":   "outerHTML",
				},
			}) {
				@menuCheck(ignoreNeg)
				Ignore Negative
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-post":   fmt.Sprintf("/budget/assign/%d/copy-prev?month=%s", r.CategoryID, month),
					"hx-target": fmt.Sprintf("#cat-%d", r.CategoryID),
					"hx-swap":   "outerHTML",
				},
			}) {
				← Previous Month
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class: "text-destructive",
				Attributes: templ.Attributes{
					"hx-post":    fmt.Sprintf("/budget/category/%d/archive?month=%s", r.CategoryID, month),
					"hx-target":  "#budget-region",
					"hx-swap":    "outerHTML",
					"hx-confirm": "Delete this category?",
				},
			}) {
				Delete
			}
		}
	}
}

// menuCheck shows a leading ✓ for an enabled menu toggle, or a blank gutter so
// labels stay aligned when unchecked.
templ menuCheck(on bool) {
	if on {
		<span class="mr-2 inline-block w-3">✓</span>
	} else {
		<span class="mr-2 inline-block w-3"></span>
	}
}

// BudgetCategoryNewRow is the transient editable row inserted by "+ category".
// BudgetCategoryCreateResult swaps the transient new-category row into the real
// row and refreshes the group header out of band so its "delete empty group"
// control disappears once the group has a category.
templ BudgetCategoryCreateResult(month string, r store.CategoryBudget, g BudgetGroup) {
	@BudgetRow(month, r)
	<template>
		@budgetGroupHeader(month, g, true)
	</template>
}

templ BudgetCategoryNewRow(month string, gid int64) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"data-newrow": ""}}) {
		@table.Cell(table.CellProps{Class: "pl-6"}) {
			<form hx-post={ fmt.Sprintf("/budget/group/%d/category?month=%s", gid, month) } hx-target="closest tr" hx-swap="outerHTML" class="flex items-center">
				<input
					type="text"
					name="name"
					autocomplete="off"
					autofocus
					placeholder="new category"
					class="js-name-new h-8 w-48 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
				/>
			</form>
		}
		@table.Cell()
		@table.Cell()
		@table.Cell()
		@table.Cell()
		@table.Cell()
	}
}

// BudgetGoalEditor is the expanding editor row inserted below a category row.
// It is pre-filled with the current goal so it edits and clears as well as sets.
templ BudgetGoalEditor(month string, r store.CategoryBudget) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"id": fmt.Sprintf("goal-edit-%d", r.CategoryID)}}) {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "bg-muted/20 p-2"}}) {
			<form
				hx-post={ fmt.Sprintf("/budget/goal/%d?month=%s", r.CategoryID, month) }
				hx-target={ fmt.Sprintf("#goal-edit-%d", r.CategoryID) }
				hx-swap="outerHTML"
				class="flex flex-wrap items-end gap-3"
			>
				<div class="grid gap-1">
					<label class="text-xs text-muted-foreground">Goal $</label>
					<input type="text" name="goal_cents" value={ goalCentsValue(r) } inputmode="decimal" placeholder="(optional)" autocomplete="off" class="h-8 w-32 rounded-md border border-input bg-transparent px-2 text-sm tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				</div>
				<div class="grid gap-1">
					<label class="text-xs text-muted-foreground">Goal due</label>
					<input type="date" name="goal_due" value={ goalDueValue(r) } class="h-8 w-40 rounded-md border border-input bg-transparent px-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/>
				</div>
				@button.Button(button.Props{Type: "submit", Size: button.SizeSm}) {
					save
				}
				@button.Button(button.Props{
					Type:    "button",
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-on:click": fmt.Sprintf("document.getElementById('goal-edit-%d').remove()", r.CategoryID),
					},
				}) {
					cancel
				}
			</form>
		}
	}
}

// BudgetGoalResult removes the editor row (empty primary target) and refreshes
// the category row out of band. The <template> wrapper lets the OOB <tr>
// survive the browser's table-parsing rules (same trick as BudgetSummary).
templ BudgetGoalResult(month string, r store.CategoryBudget) {
	<template>
		@budgetRow(month, r, true)
	</template>
}

func goalCentsValue(r store.CategoryBudget) string {
	if r.GoalCents != nil {
		return money.Format(*r.GoalCents)
	}
	return ""
}

func goalDueValue(r store.CategoryBudget) string {
	if r.GoalDueDate != nil {
		return r.GoalDueDate.Format("2006-01-02")
	}
	return ""
}

templ GoalCell(r store.CategoryBudget) {
	if g, ok := format.GoalFor(r.GoalCents, r.GoalDueDate, r.MonthlyTarget); ok {
		<div class="flex flex-wrap items-center gap-1">
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				goal { g.Amount }
			}
			if g.Due != "" {
				<span class="text-xs text-muted-foreground">by { g.Due }</span>
			}
			if g.Need != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					need { g.Need }
				}
			}
		</div>
	} else {
		<div class="flex flex-wrap items-center gap-1">
			<span class="text-xs text-muted-foreground">Create a goal...</span>
		</div>
	}
}
