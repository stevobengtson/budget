package views

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/sbengtson/budget/internal/core/auth"
	"github.com/sbengtson/budget/internal/core/format"
	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	switchcomp "github.com/templui/templui/components/switch"
	"github.com/templui/templui/components/tabs"
)

// authInputClass is the shared input styling for the standalone auth pages.
var authInputClass = "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"

// authLayout is the card shell for the pre-auth pages (login/signup/forgot/etc).
// The title is both the document title and the card heading.
templ authLayout(title string) {
	<!DOCTYPE html>
	<html lang={ string(i18n.LocaleFrom(ctx)) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Pigglet</title>
			<script>
				(function () {
					var t = localStorage.getItem("theme") || "system";
					if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
						document.documentElement.classList.add("dark");
					}
				})();
			</script>
			<link rel="stylesheet" href={ Asset("/static/app.css") }/>
			<link rel="icon" type="image/svg+xml" href={ Asset("/static/favicon.svg") }/>
			<script>
				function togglePw(btn) {
					var i = btn.parentNode.querySelector("input");
					if (!i) return;
					i.type = i.type === "password" ? "text" : "password";
					btn.querySelectorAll("[data-eye]").forEach(function (e) { e.classList.toggle("hidden"); });
				}
			</script>
		</head>
		<body class="min-h-screen flex items-center justify-center bg-background text-foreground px-4 py-8">
			<main class="w-full max-w-md">
				<div class="rounded-xl border border-border bg-card text-card-foreground p-6 shadow-sm sm:p-8">
					<h1 class="text-2xl font-semibold tracking-tight">{ title }</h1>
					<div class="mt-6">
						{ children... }
					</div>
				</div>
			</main>
		</body>
	</html>
}

// formError renders a validation error in every language, stacked. It takes a
// message key, not text — the caller cannot know which language to render in.
templ formError(errKey string) {
	if errKey != "" {
		<div class="mb-4 rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive">
			for i, line := range i18n.EveryLocale(ctx, errKey) {
				if i == 0 {
					<p>{ line }</p>
				} else {
					<p class="mt-1 opacity-80">{ line }</p>
				}
			}
		</div>
	}
}

templ emailField(value string) {
	<div class="space-y-1.5">
		<label for="email" class="text-sm font-medium leading-none">{ bi(ctx, "auth.email") }</label>
		<input id="email" name="email" type="email" value={ value } placeholder="m@example.com" autocomplete="email" required class={ authInputClass }/>
	</div>
}

// passwordField renders a labelled password input with a show/hide toggle. Pass
// minLen="" to omit the minlength constraint (login accepts any existing pw).
templ passwordField(label, name, placeholder, autocomplete, minLen string) {
	<div class="space-y-1.5">
		<label for={ name } class="text-sm font-medium leading-none">{ label }</label>
		<div class="relative">
			<input
				id={ name }
				name={ name }
				type="password"
				placeholder={ placeholder }
				autocomplete={ autocomplete }
				required
				if minLen != "" {
					minlength={ minLen }
				}
				class={ authInputClass + " pr-10" }
			/>
			<button type="button" tabindex="-1" onclick="togglePw(this)" aria-label={ i18n.T(ctx, "auth.toggle_password_visibility") } class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground">
				<span data-eye>
					@icon.Eye(icon.Props{Class: "size-4"})
				</span>
				<span data-eye class="hidden">
					@icon.EyeOff(icon.Props{Class: "size-4"})
				</span>
			</button>
		</div>
	</div>
}

templ authButton(label string) {
	<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">{ label }</button>
}

// authFooter renders a muted prompt followed by a "Sign In"/"Sign Up" link. An
// empty prompt renders just the link.
templ authFooter(prompt, href, linkText string) {
	<div class="mt-6 text-center text-sm text-muted-foreground">
		if prompt != "" {
			// The link sits on its own line rather than running on from the prompt.
			// Both are bilingual, so the pair is long enough to wrap — and it wrapped
			// mid-link, splitting "Sign In / Se connecter" across two lines with the
			// underline broken through it.
			<p>{ prompt }</p>
		}
		<a
			href={ templ.SafeURL(href) }
			class="mt-1 inline-block font-medium text-foreground underline underline-offset-4"
		>
			{ linkText }
		</a>
	</div>
}

// The signed-out auth pages render every supported language at once rather than
// picking one. A visitor here has no stored preference — only the browser's
// Accept-Language, which is a guess — and someone who cannot read a wrong guess
// cannot get far enough to correct it.
//
// Two shapes: short things (labels, buttons, links) join on one line as
// "Email / Courriel"; sentences stack, the non-primary ones muted, because a
// paragraph joined with a slash is unreadable in both languages at once.
//
// This is deliberately a stopgap for two languages. A third makes every one of
// these three lines long, and at that point these pages want a language
// switcher instead.

// bi joins a message's renderings for inline use: "Email / Courriel".
func bi(ctx context.Context, id string) string {
	return strings.Join(i18n.EveryLocale(ctx, id), " / ")
}

// biLines stacks a message's renderings, the context's own locale first and the
// rest muted beneath it.
templ biLines(id string) {
	@biLinesOf(i18n.EveryLocale(ctx, id))
}

// biLinesF is biLines for a message that interpolates named values.
templ biLinesF(id string, data i18n.M) {
	@biLinesOf(i18n.EveryLocaleF(ctx, id, data))
}

templ biLinesOf(lines []string) {
	for i, line := range lines {
		if i == 0 {
			<p class="text-sm text-muted-foreground">{ line }</p>
		} else {
			<p class="mt-1 text-sm text-muted-foreground/70">{ line }</p>
		}
	}
}

// LoginPage and the other auth pages take message KEYS, not rendered strings: a
// rendered string can only be one language, and these pages show every one.
templ LoginPage(email, errKey string) {
	@authLayout(bi(ctx, "auth.sign_in")) {
		@formError(errKey)
		<form method="post" action="/login" class="space-y-4" data-passkey-autofill>
			@emailField(email)
			@passwordField(bi(ctx, "auth.password"), "password", "", "current-password", "")
			@authButton(bi(ctx, "auth.sign_in"))
		</form>
		// Hidden by default and revealed by passkey.js only where WebAuthn
		// exists. The page must stay a working password form with JS off, so
		// nothing here may be required to sign in.
		<button type="button" data-passkey-login hidden class="mt-3 inline-flex h-10 w-full items-center justify-center rounded-md border border-input bg-background px-4 text-sm font-medium hover:bg-accent">
			{ bi(ctx, "auth.sign_in_passkey") }
		</button>
		<p class="mt-4 text-center text-sm">
			<a href="/forgot" class="text-muted-foreground underline underline-offset-4 hover:text-foreground">{ bi(ctx, "auth.forgot_password") }</a>
		</p>
		@authFooter(bi(ctx, "auth.need_account"), "/signup", bi(ctx, "auth.sign_up"))
		<script src={ Asset("/static/passkey.js") } defer></script>
	}
}

// LoginPageLocked is the login page after too many failed attempts.
//
// It names the wait rather than repeating "invalid email or password", which
// would leave someone typing the correct password convinced they had forgotten
// it. This tells an attacker only that the address is being hammered — which
// they already know — and never whether it exists, because addresses that were
// never registered lock on exactly the same schedule.
templ LoginPageLocked(email string, minutes int) {
	@authLayout(bi(ctx, "auth.sign_in")) {
		<div class="mb-4 rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive">
			for i, line := range i18n.EveryLocaleF(ctx, "auth.err_locked_out", i18n.M{"Minutes": minutes}) {
				if i == 0 {
					<p>{ line }</p>
				} else {
					<p class="mt-1 opacity-80">{ line }</p>
				}
			}
		</div>
		<form method="post" action="/login" class="space-y-4">
			@emailField(email)
			@passwordField(bi(ctx, "auth.password"), "password", "", "current-password", "")
			@authButton(bi(ctx, "auth.sign_in"))
		</form>
		<p class="mt-4 text-center text-sm">
			<a href="/forgot" class="text-muted-foreground underline underline-offset-4 hover:text-foreground">{ bi(ctx, "auth.forgot_password") }</a>
		</p>
	}
}

templ SignupPage(email, errKey string) {
	@authLayout(bi(ctx, "auth.sign_up")) {
		@formError(errKey)
		<form method="post" action="/signup" class="space-y-4">
			@emailField(email)
			@passwordField(bi(ctx, "auth.password"), "password", "", "new-password", "8")
			@authButton(bi(ctx, "auth.sign_up"))
		</form>
		@authFooter(bi(ctx, "auth.have_account"), "/login", bi(ctx, "auth.sign_in"))
	}
}

// MessagePage is the notice card (email verification sent, verified, reset done,
// etc). headingKey and bodyKey are message keys; bodyData carries any values the
// body interpolates (nil when it has none). promptKey is the muted text before
// the Sign In link, "" for none.
templ MessagePage(headingKey, bodyKey string, bodyData i18n.M, promptKey string) {
	@authLayout(bi(ctx, headingKey)) {
		if bodyData != nil {
			@biLinesF(bodyKey, bodyData)
		} else {
			@biLines(bodyKey)
		}
		if promptKey != "" {
			@authFooter(bi(ctx, promptKey), "/login", bi(ctx, "auth.sign_in"))
		} else {
			@authFooter("", "/login", bi(ctx, "auth.sign_in"))
		}
	}
}

templ ForgotPage(errKey string) {
	@authLayout(bi(ctx, "auth.forgot_title")) {
		@formError(errKey)
		<form method="post" action="/forgot" class="space-y-4">
			@emailField("")
			@authButton(bi(ctx, "auth.send_reset_link"))
		</form>
		@authFooter(bi(ctx, "auth.remember_password"), "/login", bi(ctx, "auth.sign_in"))
	}
}

templ ResetPage(token, errKey string) {
	@authLayout(bi(ctx, "auth.reset_title")) {
		@formError(errKey)
		<form method="post" action="/reset" class="space-y-4">
			<input type="hidden" name="token" value={ token }/>
			@passwordField(bi(ctx, "auth.new_password"), "password", "", "new-password", "8")
			@authButton(bi(ctx, "auth.reset_title"))
		</form>
		@authFooter(bi(ctx, "auth.remember_password"), "/login", bi(ctx, "auth.sign_in"))
	}
}

// AccountPage renders inside the app shell (the user is authenticated): current
// email, a change-password form, and a logout control.
// AccountData is the settings page view model: the current profile plus the
// active tab and per-section status messages.
type AccountData struct {
	Name          string
	Email         string
	PendingEmail  string       // a not-yet-confirmed email change, "" when none
	AvatarVersion int64        // >0 renders the stored image; 0 renders the monogram
	AddOns        []store.AddOn // the add-on catalog with this user's enabled state
	ActiveTab     string       // "account" | "security" | "addons" | "billing"
	// Billing is the subscription state for the Billing tab. It is a pointer
	// because only the page load builds it: the settings mutation handlers
	// (profile save, add-on toggle, …) re-render this whole page and have no
	// reason to query the subscription. When it is nil the tab fetches itself,
	// so it is never rendered from empty data — which would have it claim
	// billing was unconfigured.
	//
	// The standalone /billing paywall remains for locked-out users, who cannot
	// reach settings at all.
	Billing       *BillingData
	Collapsed     bool         // render the sidebar collapsed to its icon rail
	AvatarErr     string
	AvatarOK      string
	ProfileErr    string
	ProfileOK     string
	EmailErr      string
	EmailOK       string
	PasswordErr   string
	PasswordOK    string
	AddOnErr      string
	AddOnOK       string
	StartFreshErr string // Danger zone: "start fresh" (wipe data) error
	DeleteErr     string // Danger zone: delete-account error
	// SessionsData backs the Security tab's active-sessions card, which renders
	// and re-renders independently of the rest of the tab.
	SessionsData SessionsData
	// Security is the two-factor state for the Security tab.
	Security SecurityView
	// PasskeysData backs the Security tab's passkey card.
	PasskeysData PasskeysData
	// NewRecoveryCodes are shown exactly once, on the response that generated
	// them. Only their hashes are stored, so there is nothing to show later.
	NewRecoveryCodes []string
	TwoFactorErr     string
	TwoFactorOK      string
	RecoveryErr      string
	RecoveryOK       string
}

// SecurityView is the Security tab's two-factor state.
type SecurityView struct {
	// Available is false when the server has no encryption key, in which case
	// enrolment is refused rather than storing secrets in the clear.
	Available         bool
	TOTPEnabled       bool
	EmailOTPEnabled   bool
	RecoveryRemaining int
	// PendingURI and PendingSecret are set only while an enrolment is waiting
	// to be confirmed.
	PendingURI    string
	PendingSecret string
}

// OnlyFactor reports whether exactly one second factor is on, which is when
// turning it off also destroys the recovery codes. The warning that gives is
// the difference between an informed choice and a printout that silently stops
// working.
func (v SecurityView) OnlyFactor() bool {
	n := 0
	if v.TOTPEnabled {
		n++
	}
	if v.EmailOTPEnabled {
		n++
	}
	return n == 1 && v.RecoveryRemaining > 0
}

// sessionTitle names a device for the sessions list. The stored label is
// derived from the user agent at sign-in; when there was none to parse (a
// scripted client, a stripped header) the client kind is still meaningful, and
// falling back to a generic word beats showing an empty row.
func sessionTitle(ctx context.Context, s auth.SessionView) string {
	if s.Label != "" {
		return s.Label
	}
	switch s.Client {
	case "ios":
		return i18n.T(ctx, "settings.session_ios")
	case "android":
		return i18n.T(ctx, "settings.session_android")
	default:
		return i18n.T(ctx, "settings.session_unknown")
	}
}

templ AccountPage(d AccountData) {
	@Layout(i18n.T(ctx, "menu.settings"), "account", d.Collapsed) {
		<div class="mx-auto w-full max-w-2xl space-y-6">
			<h1 class="text-2xl font-semibold tracking-tight">{ i18n.T(ctx, "menu.settings") }</h1>
			// data-url-tabs makes tab-url.js mirror the selected tab into ?tab=,
			// so a refresh or a shared link reopens the same panel. The default
			// tab is written as no parameter, keeping a bare /account clean.
			@tabs.Tabs(tabs.Props{Attributes: templ.Attributes{
				"data-url-tabs":         "tab",
				"data-url-tabs-default": "account",
			}}) {
				@tabs.List() {
					@tabs.Trigger(tabs.TriggerProps{Value: "account", IsActive: d.ActiveTab == "account"}) {
						@icon.User(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "settings.tab_account") }
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "security", IsActive: d.ActiveTab == "security"}) {
						@icon.Shield(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "settings.tab_security") }
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "addons", IsActive: d.ActiveTab == "addons"}) {
						@icon.Blocks(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "settings.tab_addons") }
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "billing", IsActive: d.ActiveTab == "billing"}) {
						@icon.CreditCard(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "menu.billing") }
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "account", IsActive: d.ActiveTab == "account", Class: "mt-6"}) {
					<div class="space-y-6">
						@AccountProfileSection(d)
						@AccountEmailSection(d)
						@accountDangerSection(d)
					</div>
				}
				@tabs.Content(tabs.ContentProps{Value: "security", IsActive: d.ActiveTab == "security", Class: "mt-6"}) {
					@AccountSecuritySection(d)
				}
				@tabs.Content(tabs.ContentProps{Value: "addons", IsActive: d.ActiveTab == "addons", Class: "mt-6"}) {
					@AccountAddOnsSection(d)
				}
				@tabs.Content(tabs.ContentProps{Value: "billing", IsActive: d.ActiveTab == "billing", Class: "mt-6"}) {
					if d.Billing != nil {
						@BillingSection(*d.Billing)
					} else {
						<div hx-get="/account/billing" hx-trigger="load" hx-swap="outerHTML">
							<div class="rounded-xl border bg-card p-6 text-sm text-muted-foreground">
								{ i18n.T(ctx, "settings.loading_plan") }
							</div>
						</div>
					}
				}
			}
		</div>
	}
}

// AccountProfileSection is the Account tab's "User profile" card: avatar
// (monogram, upload not wired yet) and the editable display name.
// AddOnToggleResult is the response to enabling or disabling an add-on: the
// Add-ons section itself, plus the two navs refreshed out of band, since which
// add-ons are on decides which entries they carry.
templ AddOnToggleResult(d AccountData) {
	@AccountAddOnsSection(d)
	@PrimaryNav("account", true)
	@tabBarNav("account", true)
}

// The settings sections are exported and individually swappable: each form
// posts with htmx and replaces only its own section, rather than the whole
// settings page being re-rendered for a name change.
templ AccountProfileSection(d AccountData) {
	<section id="account-profile" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.profile_heading") }</h2>
		<div class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				<div class="space-y-1.5">
					<label class="text-sm font-medium leading-none">{ i18n.T(ctx, "menu.avatar_alt") }</label>
					<div class="flex items-center gap-3">
						@userAvatar(d.Name, d.AvatarVersion, "size-14 rounded-lg text-lg")
						<form hx-post="/account/avatar" hx-trigger="change" hx-target="#account-profile" hx-swap="outerHTML" hx-encoding="multipart/form-data" enctype="multipart/form-data">
							<label class="inline-flex h-8 cursor-pointer items-center rounded-full border border-input bg-background px-3 text-sm font-medium hover:bg-accent hover:text-accent-foreground">
								{ i18n.T(ctx, "settings.change_avatar") }
								<input
									type="file"
									name="avatar"
									accept="image/png,image/jpeg,image/gif,image/webp"
									class="sr-only"
								/>
							</label>
						</form>
						if d.AvatarVersion > 0 {
							<form hx-post="/account/avatar/remove" hx-target="#account-profile" hx-swap="outerHTML">
								@button.Button(button.Props{
									Type:    button.TypeSubmit,
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "text-muted-foreground hover:text-destructive",
								}) {
									{ i18n.T(ctx, "paydown.menu_remove") }
								}
							</form>
						}
					</div>
					@settingsMessages(d.AvatarErr, d.AvatarOK)
				</div>
				<form id="profile-form" hx-post="/account/profile" hx-target="#account-profile" hx-swap="outerHTML" class="space-y-1.5">
					<label for="profile-name" class="text-sm font-medium leading-none">{ i18n.T(ctx, "settings.name_label") }</label>
					@input.Input(input.Props{ID: "profile-name", Name: "name", Value: d.Name, Attributes: templ.Attributes{"required": true, "autocomplete": "name"}})
					@settingsMessages(d.ProfileErr, d.ProfileOK)
				</form>
			</div>
			<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Form: "profile-form"}) {
					{ i18n.T(ctx, "settings.save_changes") }
				}
			</div>
		</div>
	</section>
}

// AccountEmailSection is the Account tab's "Change email" card. Submitting emails
// a confirmation link to the new address; the login email only changes once that
// link is clicked, so a pending change is surfaced here.
templ AccountEmailSection(d AccountData) {
	<section id="account-email" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.email_heading") }</h2>
		<form hx-post="/account/email" hx-target="#account-email" hx-swap="outerHTML" class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				if d.PendingEmail != "" {
					<div class="rounded-md border border-primary/40 bg-primary/10 px-3 py-2 text-sm text-muted-foreground">
						{ i18n.Tf(ctx, "settings.email_pending", i18n.M{"Pending": d.PendingEmail, "Current": d.Email}) }
					</div>
				}
				<div class="space-y-1.5">
					<label for="new-email" class="text-sm font-medium leading-none">{ i18n.T(ctx, "settings.new_email_label") }</label>
					@input.Input(input.Props{ID: "new-email", Name: "new_email", Type: input.TypeEmail, Placeholder: d.Email, Attributes: templ.Attributes{"required": true, "autocomplete": "email"}})
				</div>
				<div class="space-y-1.5">
					<label for="email-password" class="text-sm font-medium leading-none">{ i18n.T(ctx, "auth.current_password") }</label>
					@input.Input(input.Props{ID: "email-password", Name: "password", Type: input.TypePassword, Attributes: templ.Attributes{"required": true, "autocomplete": "current-password"}})
				</div>
				@settingsMessages(d.EmailErr, d.EmailOK)
			</div>
			<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ i18n.T(ctx, "settings.update_email") }
				}
			</div>
		</form>
	</section>
}

// accountDangerSection is the Account tab's "Danger zone": irreversible actions
// (wipe data / delete account), each gated on the current password (and, for
// deletion, re-typing the account email). Both submit as full-page POSTs.
templ accountDangerSection(d AccountData) {
	<section id="account-danger" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold text-destructive">{ i18n.T(ctx, "settings.danger_heading") }</h2>
		<div class="divide-y overflow-hidden rounded-xl border border-destructive/40 bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				<div class="space-y-1">
					<h3 class="text-sm font-medium">{ i18n.T(ctx, "settings.start_fresh_heading") }</h3>
					<p class="text-sm text-muted-foreground">
						{ i18n.T(ctx, "settings.start_fresh_body") }
					</p>
				</div>
				<form method="post" action="/account/start-fresh" class="space-y-4">
					@dangerPassword("sf_password")
					@settingsMessages(d.StartFreshErr, "")
					@dangerButton(i18n.T(ctx, "settings.delete_all_data"))
				</form>
			</div>
			<div class="space-y-4 p-4 sm:p-6">
				<div class="space-y-1">
					<h3 class="text-sm font-medium">{ i18n.T(ctx, "settings.delete_account_heading") }</h3>
					<p class="text-sm text-muted-foreground">
						{ i18n.T(ctx, "settings.delete_account_body") }
					</p>
				</div>
				<form method="post" action="/account/delete" class="space-y-4">
					@dangerPassword("del_password")
					<div class="space-y-1.5">
						<label for="confirm_email" class="text-sm font-medium leading-none">
							{ i18n.Tf(ctx, "settings.type_to_confirm", i18n.M{"Email": d.Email}) }
						</label>
						<input id="confirm_email" name="confirm_email" type="email" autocomplete="off" required placeholder={ d.Email } class={ authInputClass }/>
					</div>
					@settingsMessages(d.DeleteErr, "")
					@dangerButton(i18n.T(ctx, "settings.delete_my_account"))
				</form>
			</div>
		</div>
	</section>
}

// dangerPassword is the current-password input shared by the danger-zone forms.
// id is unique per form; the field name is always "password" (what the handlers
// read).
templ dangerPassword(id string) {
	<div class="space-y-1.5">
		<label for={ id } class="text-sm font-medium leading-none">{ i18n.T(ctx, "auth.current_password") }</label>
		<input id={ id } name="password" type="password" autocomplete="current-password" required class={ authInputClass }/>
	</div>
}

// dangerButton is the destructive submit button for a danger-zone form.
templ dangerButton(label string) {
	<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-destructive px-4 text-sm font-medium text-destructive-foreground transition-colors hover:bg-destructive/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive focus-visible:ring-offset-2 focus-visible:ring-offset-background">{ label }</button>
}

// AccountSecuritySection is the Security tab: a container of independent cards.
//
// Each card is its own [data-inline-errors] section with its own hx-target, so
// a failed password change re-renders only the password card and leaves the
// sessions list — and the reader's scroll position — where they were. The tab
// gains more cards in later phases (two-factor, recovery codes, passkeys), and
// a single-section tab would have every one of them re-render the whole screen.
templ AccountSecuritySection(d AccountData) {
	<div class="space-y-6">
		@AccountPasswordCard(d)
		@AccountPasskeysCard(d.PasskeysData)
		@AccountTwoFactorCard(d)
		@AccountRecoveryCard(d)
		@AccountSessionsCard(d.SessionsData)
	</div>
}

// AccountPasswordCard is the "Change password" card.
templ AccountPasswordCard(d AccountData) {
	<section id="account-password" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.password_heading") }</h2>
		<form hx-post="/account/password" hx-target="#account-password" hx-swap="outerHTML" class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				@passwordField(i18n.T(ctx, "auth.current_password"), "current", i18n.T(ctx, "auth.enter_current_password"), "current-password", "")
				@passwordField(i18n.T(ctx, "auth.new_password"), "next", i18n.T(ctx, "auth.new_password"), "new-password", "8")
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.password_signs_out_others") }</p>
				@settingsMessages(d.PasswordErr, d.PasswordOK)
			</div>
			<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ i18n.T(ctx, "settings.update_password") }
				}
			</div>
		</form>
	</section>
}

// SessionsData is the active-sessions card's view model.
type SessionsData struct {
	Sessions    []auth.SessionView
	SessionsErr string
	SessionsOK  string
}

// AccountSessionsCard lists the devices signed in to this account.
//
// The copy has to be explicit that this covers phones: the mobile apps
// authenticate with a bearer token that is a row in the very same sessions
// table, so "sign out everywhere" genuinely signs the user's phone out. That is
// correct, but it surprises people who think of it as a browser-only action.
templ AccountSessionsCard(d SessionsData) {
	<section id="account-sessions" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.sessions_heading") }</h2>
		<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.sessions_intro") }</p>
		<div class="overflow-hidden rounded-xl border bg-card">
			<div class="divide-y">
				for _, s := range d.Sessions {
					@sessionRow(s)
				}
			</div>
			<div class="space-y-3 border-t bg-muted/30 px-4 py-3 sm:px-6">
				@settingsMessages(d.SessionsErr, d.SessionsOK)
				if len(d.Sessions) > 1 {
					<form hx-post="/account/sessions/revoke-others" hx-target="#account-sessions" hx-swap="outerHTML">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "settings.revoke_others") }
						}
					</form>
				}
			</div>
		</div>
	</section>
}

// sessionRow is one signed-in device.
templ sessionRow(s auth.SessionView) {
	<div class="flex items-start justify-between gap-4 p-4 sm:px-6">
		<div class="min-w-0 space-y-1">
			<p class="text-sm font-medium">
				{ sessionTitle(ctx, s) }
				if s.Current {
					<span class="ml-2 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">{ i18n.T(ctx, "settings.session_current") }</span>
				}
			</p>
			<p class="text-xs text-muted-foreground">
				{ i18n.Tf(ctx, "settings.session_last_seen", i18n.M{"When": format.DateMedium(ctx, s.LastSeen)}) }
				if s.IP != "" {
					{ " · " + s.IP }
				}
			</p>
		</div>
		if !s.Current {
			<form hx-post={ fmt.Sprintf("/account/sessions/%d/revoke", s.ID) } hx-target="#account-sessions" hx-swap="outerHTML">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantGhost}) {
					{ i18n.T(ctx, "settings.revoke_session") }
				}
			</form>
		}
	</div>
}

// ReauthCard asks the user to prove a factor again before a sensitive action.
//
// It is returned with a 4xx from requireRecentAuth, which the settings forms
// swap in place through the existing [data-inline-errors] contract — so the
// prompt appears exactly where the blocked action was, with no new client-side
// machinery.
templ ReauthCard(next string) {
	@ReauthCardWithError(next, "")
}

templ ReauthCardWithError(next, errKey string) {
	<section id="account-reauth" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "auth.reauth_heading") }</h2>
		<form hx-post="/account/reauth" hx-target="#account-reauth" hx-swap="outerHTML" class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "auth.reauth_prompt") }</p>
				<input type="hidden" name="next" value={ next }/>
				@passwordField(i18n.T(ctx, "auth.password"), "password", i18n.T(ctx, "auth.enter_current_password"), "current-password", "")
				if errKey != "" {
					<p class="text-sm text-destructive">{ i18n.T(ctx, errKey) }</p>
				}
			</div>
			<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ i18n.T(ctx, "auth.reauth_confirm") }
				}
			</div>
		</form>
	</section>
}

// AccountAddOnsSection is the Add-ons tab: the feature catalog, each with a
// switch that turns it on or off for this user. Toggling submits the row's form
// (a full-page POST), so the sidebar nav reflects the change on re-render.
templ AccountAddOnsSection(d AccountData) {
	<section id="account-addons" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.tab_addons") }</h2>
		<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.addons_intro") }</p>
		@settingsMessages(d.AddOnErr, d.AddOnOK)
		<div class="divide-y overflow-hidden rounded-xl border bg-card">
			for _, a := range d.AddOns {
				@addOnRow(a)
			}
		</div>
	</section>
}

// addOnRow renders one catalog add-on: name, price, description, and the enable
// switch. The switch posts enabled=on when checked, nothing when unchecked; the
// handler reads that as on/off.
templ addOnRow(a store.AddOn) {
	<div class="flex items-start justify-between gap-4 p-4 sm:p-6">
		<div class="min-w-0 space-y-1">
			<div class="flex items-center gap-2">
				<span class="text-sm font-medium">{ addOnName(ctx, a) }</span>
				<span class="rounded-full border px-2 py-0.5 text-xs text-muted-foreground">{ addOnPrice(ctx, a.PriceCents) }</span>
			</div>
			<p class="text-sm text-muted-foreground">{ addOnDescription(ctx, a) }</p>
		</div>
		<form hx-post={ addOnAction(a.Slug) } hx-trigger="change" hx-target="#account-addons" hx-swap="outerHTML" class="shrink-0 pt-0.5">
			@switchcomp.Switch(switchcomp.Props{
				Name:       "enabled",
				Checked:    a.Enabled,
				Attributes: templ.Attributes{"aria-label": i18n.Tf(ctx, "settings.toggle_addon", i18n.M{"Name": addOnName(ctx, a)})},
			})
		</form>
	</div>
}

// addOnPrice renders an add-on's monthly price, or "Free" when it's zero.
func addOnPrice(ctx context.Context, cents int64) string {
	if cents == 0 {
		return i18n.T(ctx, "settings.addon_free")
	}
	return money.Format(ctx, cents) + i18n.T(ctx, "budget.per_month_suffix")
}

// addOnName and addOnDescription translate the add-on catalog, which is stored
// in the database but authored by us, not by the user. The row stays the source
// of truth for which add-ons exist; the catalog supplies the words. An add-on
// added to the database before its catalog entry falls back to its English row
// text rather than rendering a message ID.
func addOnName(ctx context.Context, a store.AddOn) string {
	return i18n.TOr(ctx, "addons.name."+a.Slug, a.Name)
}

func addOnDescription(ctx context.Context, a store.AddOn) string {
	return i18n.TOr(ctx, "addons.description."+a.Slug, a.Description)
}

// addOnAction builds the toggle endpoint for an add-on slug.
func addOnAction(slug string) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/account/addons/%s", slug))
}

// settingsMessages renders an inline error or success line for a settings card.
templ settingsMessages(errMsg, okMsg string) {
	if errMsg != "" {
		<p class="text-sm text-destructive">{ errMsg }</p>
	}
	if okMsg != "" {
		<p class="text-sm text-primary">{ okMsg }</p>
	}
}

// ChallengeData backs the second-factor screen.
type ChallengeData struct {
	// Token is the opaque challenge id, carried in a hidden field rather than a
	// cookie: it survives the form post without adding a second cookie surface,
	// and the JSON API carries the same value in its body.
	Token string
	// Method is the factor currently being asked for.
	Method auth.Factor
	// Methods are every factor this user could switch to.
	Methods []auth.Factor
	// MaskedEmail tells the user which inbox to check without the page
	// restating an address they have not finished proving they own.
	MaskedEmail string
	ErrKey      string
}

// ChallengePage asks for the second factor.
//
// A signed-out page, so it renders every supported language: the visitor has no
// stored preference yet, and someone who cannot read a wrong guess cannot get
// far enough to correct it. It therefore takes message KEYS, never rendered
// strings.
templ ChallengePage(d ChallengeData) {
	@authLayout(bi(ctx, "auth.challenge_title")) {
		@formError(d.ErrKey)
		switch d.Method {
			case auth.FactorEmailOTP:
				@biLinesF("auth.challenge_body_email", i18n.M{"Email": d.MaskedEmail})
			case auth.FactorRecovery:
				@biLines("auth.challenge_body_recovery")
			default:
				@biLines("auth.challenge_body_totp")
		}
		<form method="post" action="/login/challenge" class="mt-4 space-y-4">
			<input type="hidden" name="challenge" value={ d.Token }/>
			<input type="hidden" name="method" value={ string(d.Method) }/>
			@codeField(d.Method)
			@authButton(bi(ctx, "auth.verify_code"))
		</form>
		<div class="mt-4 space-y-2 text-center text-sm">
			if d.Method == auth.FactorEmailOTP {
				@challengeAction(d.Token, "email_otp", "auth.resend_code", "/login/challenge/send")
			}
			for _, m := range d.Methods {
				if m != d.Method {
					@challengeSwitch(d.Token, m)
				}
			}
			@challengeAction(d.Token, "", "auth.cancel_signin", "/login/challenge/cancel")
		</div>
	}
}

// codeField is a plain input, deliberately not a templui component:
// autocomplete="one-time-code" is what makes iOS and Safari offer the emailed
// code straight from the notification, and no component library exposes it.
// A recovery code is alphanumeric, so only the numeric factors get the numeric
// keypad hints.
templ codeField(method auth.Factor) {
	<div class="space-y-1.5">
		<label for="code" class="text-sm font-medium leading-none">{ bi(ctx, "auth.code_label") }</label>
		if method == auth.FactorRecovery {
			<input id="code" name="code" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" required class={ authInputClass }/>
		} else {
			<input
				id="code"
				name="code"
				type="text"
				inputmode="numeric"
				pattern="[0-9]*"
				maxlength="6"
				autocomplete="one-time-code"
				autocapitalize="none"
				spellcheck="false"
				required
				class={ authInputClass + " text-center text-lg tracking-[0.4em]" }
			/>
		}
	</div>
}

// challengeSwitch offers another factor. A POST, not a link, because switching
// carries the challenge token and a GET would put it in the URL — and therefore
// in logs and referrers.
templ challengeSwitch(token string, m auth.Factor) {
	switch m {
		case auth.FactorTOTP:
			@challengeAction(token, string(m), "auth.use_totp_instead", "/login/challenge")
		case auth.FactorEmailOTP:
			@challengeAction(token, string(m), "auth.use_email_instead", "/login/challenge/send")
		case auth.FactorRecovery:
			@challengeAction(token, string(m), "auth.use_recovery_instead", "/login/challenge")
	}
}

templ challengeAction(token, method, labelKey, action string) {
	<form method="post" action={ templ.SafeURL(action) }>
		<input type="hidden" name="challenge" value={ token }/>
		if method != "" {
			<input type="hidden" name="method" value={ method }/>
		}
		<input type="hidden" name="switch" value="1"/>
		<button type="submit" class="text-muted-foreground underline underline-offset-4 hover:text-foreground">{ bi(ctx, labelKey) }</button>
	</form>
}

// AccountTwoFactorCard is the Security tab's two-step verification card.
templ AccountTwoFactorCard(d AccountData) {
	<section id="account-2fa" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.twofa_heading") }</h2>
		<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.twofa_intro") }</p>
		<div class="overflow-hidden rounded-xl border bg-card">
			if !d.Security.Available {
				<p class="p-4 text-sm text-muted-foreground sm:p-6">{ i18n.T(ctx, "settings.twofa_unavailable") }</p>
			} else {
				if d.Security.PendingURI != "" {
					@twoFactorSetup(d)
				} else {
					@twoFactorRows(d)
				}
				<div class="border-t bg-muted/30 px-4 py-3 sm:px-6">
					@settingsMessages(d.TwoFactorErr, d.TwoFactorOK)
				</div>
			}
		</div>
	</section>
}

// twoFactorSetup is the enrolment step: QR, manual key, and the confirm field.
templ twoFactorSetup(d AccountData) {
	<div class="space-y-4 p-4 sm:p-6">
		<p class="text-sm">{ i18n.T(ctx, "settings.twofa_scan") }</p>
		<img src="/account/2fa/qr" alt="" width="200" height="200" class="rounded-lg border bg-white p-2"/>
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.twofa_manual_key") }</p>
		<code class="block break-all rounded-md bg-muted px-3 py-2 font-mono text-xs">{ d.Security.PendingSecret }</code>
		<form hx-post="/account/2fa/totp/confirm" hx-target="#account-2fa" hx-swap="outerHTML" class="space-y-3">
			<input name="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" required placeholder="000000" class="flex h-10 w-40 rounded-md border border-input bg-background px-3 py-2 text-center text-sm tracking-[0.3em]"/>
			<div class="flex gap-2">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ i18n.T(ctx, "settings.twofa_confirm") }
				}
				<button type="submit" formaction="/account/2fa/totp/cancel" hx-post="/account/2fa/totp/cancel" hx-target="#account-2fa" hx-swap="outerHTML" class="inline-flex h-9 items-center rounded-md px-3 text-sm text-muted-foreground hover:text-foreground">{ i18n.T(ctx, "settings.twofa_cancel") }</button>
			</div>
		</form>
	</div>
}

templ twoFactorRows(d AccountData) {
	<div class="divide-y">
		<div class="flex items-start justify-between gap-4 p-4 sm:p-6">
			<div class="min-w-0">
				<p class="text-sm font-medium">{ i18n.T(ctx, "settings.twofa_app_heading") }</p>
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.twofa_app_desc") }</p>
			</div>
			if d.Security.TOTPEnabled {
				<form hx-post="/account/2fa/totp/disable" hx-target="#account-2fa" hx-swap="outerHTML" class="shrink-0 text-right">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "settings.twofa_app_disable") }
					}
					if d.Security.OnlyFactor() {
						@lastFactorWarning()
					}
				</form>
			} else {
				<form hx-post="/account/2fa/totp/begin" hx-target="#account-2fa" hx-swap="outerHTML">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						{ i18n.T(ctx, "settings.twofa_app_setup") }
					}
				</form>
			}
		</div>
		<div class="flex items-start justify-between gap-4 p-4 sm:p-6">
			<div class="min-w-0">
				<p class="text-sm font-medium">{ i18n.T(ctx, "settings.twofa_email_heading") }</p>
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.twofa_email_desc") }</p>
			</div>
			<form hx-post="/account/2fa/email" hx-target="#account-2fa" hx-swap="outerHTML" class="shrink-0 text-right">
				<input type="hidden" name="enabled" value={ toggleValue(d.Security.EmailOTPEnabled) }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
					if d.Security.EmailOTPEnabled {
						{ i18n.T(ctx, "settings.twofa_app_disable") }
					} else {
						{ i18n.T(ctx, "settings.twofa_app_setup") }
					}
				}
				if d.Security.EmailOTPEnabled && d.Security.OnlyFactor() {
					@lastFactorWarning()
				}
			</form>
		</div>
	</div>
}

// lastFactorWarning tells the user, before they act, that turning this factor
// off will also destroy their recovery codes — the one consequence they cannot
// see from the button's label.
templ lastFactorWarning() {
	<p class="mt-2 max-w-[16rem] text-xs text-muted-foreground">{ i18n.T(ctx, "settings.twofa_last_factor_warning") }</p>
}

// AccountRecoveryCard shows recovery-code state, and the codes themselves the
// one time they exist in memory.
templ AccountRecoveryCard(d AccountData) {
	<section id="account-recovery" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.recovery_heading") }</h2>
		<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.recovery_intro") }</p>
		<div class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				if len(d.NewRecoveryCodes) > 0 {
					<p class="text-sm font-medium text-destructive">{ i18n.T(ctx, "settings.recovery_shown_once") }</p>
					<ul class="grid grid-cols-2 gap-2 rounded-md bg-muted p-3 font-mono text-sm">
						for _, c := range d.NewRecoveryCodes {
							<li>{ c }</li>
						}
					</ul>
					<a href="/account/recovery-codes.txt" download="pigglet-recovery-codes.txt" class="inline-block text-sm underline underline-offset-4">{ i18n.T(ctx, "settings.recovery_download") }</a>
				} else if d.Security.RecoveryRemaining > 0 {
					<p class="text-sm">{ i18n.Tnf(ctx, "settings.recovery_remaining", d.Security.RecoveryRemaining, i18n.M{"Count": d.Security.RecoveryRemaining}) }</p>
				} else {
					// "0 codes remaining" reads like something went wrong. With
					// no second factor there is simply nothing to recover past,
					// which is worth saying outright.
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.recovery_none_needed") }</p>
				}
				@settingsMessages(d.RecoveryErr, d.RecoveryOK)
			</div>
			if d.Security.TOTPEnabled || d.Security.EmailOTPEnabled {
				<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
					<form hx-post="/account/recovery-codes" hx-target="#account-recovery" hx-swap="outerHTML">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "settings.recovery_regenerate") }
						}
					</form>
				</div>
			}
		</div>
	</section>
}

// toggleValue flips a boolean for a form that posts the DESIRED next state.
func toggleValue(current bool) string {
	if current {
		return "off"
	}
	return "on"
}

// TwoFactorWithRecovery renders the two-factor card and pushes the recovery
// card alongside it out-of-band.
//
// Both change together when enrolment completes, and the codes exist in memory
// only on this one response — a second request to fetch them would find nothing
// but hashes.
templ TwoFactorWithRecovery(d AccountData) {
	@AccountTwoFactorCard(d)
	<div hx-swap-oob="outerHTML:#account-recovery">
		@AccountRecoveryCard(d)
	</div>
}

// PasskeyView is one registered credential as the settings card shows it.
type PasskeyView struct {
	ID           int64
	Name         string
	Created      time.Time
	LastUsed     *time.Time
	CloneWarning bool
	// SyncedBackup reports that the authenticator has this credential backed up.
	// One that is not lives and dies with a single device.
	SyncedBackup bool
}

// PasskeysData backs the passkey card.
type PasskeysData struct {
	Available  bool
	Passkeys   []PasskeyView
	PasskeyErr string
	PasskeyOK  string
}

// AccountPasskeysCard lists the account's passkeys and offers to add one.
templ AccountPasskeysCard(d PasskeysData) {
	<section id="account-passkeys" data-inline-errors class="space-y-2">
		<h2 class="text-sm font-semibold">{ i18n.T(ctx, "settings.passkeys_heading") }</h2>
		<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "settings.passkeys_intro") }</p>
		<div class="overflow-hidden rounded-xl border bg-card">
			if !d.Available {
				<p class="p-4 text-sm text-muted-foreground sm:p-6">{ i18n.T(ctx, "settings.passkeys_unavailable") }</p>
			} else {
				if len(d.Passkeys) > 0 {
					<div class="divide-y">
						for _, p := range d.Passkeys {
							@passkeyRow(p)
						}
					</div>
				} else {
					<p class="p-4 text-sm text-muted-foreground sm:p-6">{ i18n.T(ctx, "settings.passkeys_none") }</p>
				}
				<div class="space-y-3 border-t bg-muted/30 px-4 py-3 sm:px-6">
					@settingsMessages(d.PasskeyErr, d.PasskeyOK)
					// Progressive enhancement: the button is inert without
					// WebAuthn, and passkey.js hides it when the browser has no
					// support rather than offering something that cannot work.
					<button type="button" data-passkey-register hidden class="inline-flex h-9 items-center rounded-md border border-input bg-background px-3 text-sm font-medium hover:bg-accent">
						{ i18n.T(ctx, "settings.passkeys_add") }
					</button>
				</div>
			}
		</div>
	</section>
}

templ passkeyRow(p PasskeyView) {
	<div class="flex items-start justify-between gap-4 p-4 sm:px-6">
		<div class="min-w-0 space-y-1">
			<p class="text-sm font-medium">
				if p.Name != "" {
					{ p.Name }
				} else {
					{ i18n.T(ctx, "settings.passkey_unnamed") }
				}
			</p>
			<p class="text-xs text-muted-foreground">
				{ i18n.Tf(ctx, "settings.passkey_added", i18n.M{"When": format.DateMedium(ctx, p.Created)}) }
				if p.LastUsed != nil {
					{ " · " + i18n.Tf(ctx, "settings.passkey_last_used", i18n.M{"When": format.DateMedium(ctx, *p.LastUsed)}) }
				}
			</p>
			if !p.SyncedBackup {
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.passkey_not_backed_up") }</p>
			}
			if p.CloneWarning {
				// The counter went backwards, which is the spec's signal that
				// this credential may have been copied.
				<p class="text-xs text-destructive">{ i18n.T(ctx, "settings.passkey_clone_warning") }</p>
			}
		</div>
		<form hx-post={ fmt.Sprintf("/account/passkeys/%d/delete", p.ID) } hx-target="#account-passkeys" hx-swap="outerHTML" class="shrink-0">
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantGhost}) {
				{ i18n.T(ctx, "settings.passkey_remove") }
			}
		</form>
	</div>
}
