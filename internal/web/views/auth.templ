package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	switchcomp "github.com/templui/templui/components/switch"
	"github.com/templui/templui/components/tabs"
)

// authInputClass is the shared input styling for the standalone auth pages.
var authInputClass = "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"

// authLayout is the card shell for the pre-auth pages (login/signup/forgot/etc).
// The title is both the document title and the card heading.
templ authLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Pigglet</title>
			<script>
				(function () {
					var t = localStorage.getItem("theme") || "system";
					if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
						document.documentElement.classList.add("dark");
					}
				})();
			</script>
			<link rel="stylesheet" href={ Asset("/static/app.css") }/>
			<link rel="icon" type="image/svg+xml" href={ Asset("/static/favicon.svg") }/>
			<script>
				function togglePw(btn) {
					var i = btn.parentNode.querySelector("input");
					if (!i) return;
					i.type = i.type === "password" ? "text" : "password";
					btn.querySelectorAll("[data-eye]").forEach(function (e) { e.classList.toggle("hidden"); });
				}
			</script>
		</head>
		<body class="min-h-screen flex items-center justify-center bg-background text-foreground px-4 py-8">
			<main class="w-full max-w-md">
				<div class="rounded-xl border border-border bg-card text-card-foreground p-6 shadow-sm sm:p-8">
					<h1 class="text-2xl font-semibold tracking-tight">{ title }</h1>
					<div class="mt-6">
						{ children... }
					</div>
				</div>
			</main>
		</body>
	</html>
}

templ formError(msg string) {
	if msg != "" {
		<div class="mb-4 rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive">{ msg }</div>
	}
}

templ emailField(value string) {
	<div class="space-y-1.5">
		<label for="email" class="text-sm font-medium leading-none">Email</label>
		<input id="email" name="email" type="email" value={ value } placeholder="m@example.com" autocomplete="email" required class={ authInputClass }/>
	</div>
}

// passwordField renders a labelled password input with a show/hide toggle. Pass
// minLen="" to omit the minlength constraint (login accepts any existing pw).
templ passwordField(label, name, placeholder, autocomplete, minLen string) {
	<div class="space-y-1.5">
		<label for={ name } class="text-sm font-medium leading-none">{ label }</label>
		<div class="relative">
			<input
				id={ name }
				name={ name }
				type="password"
				placeholder={ placeholder }
				autocomplete={ autocomplete }
				required
				if minLen != "" {
					minlength={ minLen }
				}
				class={ authInputClass + " pr-10" }
			/>
			<button type="button" tabindex="-1" onclick="togglePw(this)" aria-label="Toggle password visibility" class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground">
				<span data-eye>
					@icon.Eye(icon.Props{Class: "size-4"})
				</span>
				<span data-eye class="hidden">
					@icon.EyeOff(icon.Props{Class: "size-4"})
				</span>
			</button>
		</div>
	</div>
}

templ authButton(label string) {
	<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">{ label }</button>
}

// authFooter renders a muted prompt followed by a "Sign In"/"Sign Up" link. An
// empty prompt renders just the link.
templ authFooter(prompt, href, linkText string) {
	<p class="mt-6 text-center text-sm text-muted-foreground">
		if prompt != "" {
			{ prompt + " " }
		}
		<a href={ templ.SafeURL(href) } class="font-medium text-foreground underline underline-offset-4">{ linkText }</a>
	</p>
}

templ LoginPage(email, errMsg string) {
	@authLayout("Sign In") {
		@formError(errMsg)
		<form method="post" action="/login" class="space-y-4">
			@emailField(email)
			@passwordField("Password", "password", "Password", "current-password", "")
			@authButton("Sign In")
		</form>
		<p class="mt-4 text-center text-sm">
			<a href="/forgot" class="text-muted-foreground underline underline-offset-4 hover:text-foreground">Forgot password?</a>
		</p>
		@authFooter("Need to create an account?", "/signup", "Sign Up")
	}
}

templ SignupPage(email, errMsg string) {
	@authLayout("Sign Up") {
		@formError(errMsg)
		<form method="post" action="/signup" class="space-y-4">
			@emailField(email)
			@passwordField("Password", "password", "Password", "new-password", "8")
			@authButton("Sign Up")
		</form>
		@authFooter("Already have an account?", "/login", "Sign In")
	}
}

// MessagePage is the notice card (email verification sent, verified, reset done,
// etc). signInPrompt is the muted text before the Sign In link ("" for none).
templ MessagePage(heading, body, signInPrompt string) {
	@authLayout(heading) {
		<p class="text-sm text-muted-foreground">{ body }</p>
		@authFooter(signInPrompt, "/login", "Sign In")
	}
}

templ ForgotPage(errMsg string) {
	@authLayout("Forgot Password") {
		@formError(errMsg)
		<form method="post" action="/forgot" class="space-y-4">
			@emailField("")
			@authButton("Send reset link")
		</form>
		@authFooter("Remember your password?", "/login", "Sign In")
	}
}

templ ResetPage(token, errMsg string) {
	@authLayout("Reset Password") {
		@formError(errMsg)
		<form method="post" action="/reset" class="space-y-4">
			<input type="hidden" name="token" value={ token }/>
			@passwordField("Password", "password", "New password", "new-password", "8")
			@authButton("Reset Password")
		</form>
		@authFooter("Remember your password?", "/login", "Sign In")
	}
}

// AccountPage renders inside the app shell (the user is authenticated): current
// email, a change-password form, and a logout control.
// AccountData is the settings page view model: the current profile plus the
// active tab and per-section status messages.
type AccountData struct {
	Name          string
	Email         string
	PendingEmail  string       // a not-yet-confirmed email change, "" when none
	AvatarVersion int64        // >0 renders the stored image; 0 renders the monogram
	AddOns        []store.AddOn // the add-on catalog with this user's enabled state
	ActiveTab     string       // "account" | "security" | "addons"
	Collapsed     bool         // render the sidebar collapsed to its icon rail
	AvatarErr     string
	AvatarOK      string
	ProfileErr    string
	ProfileOK     string
	EmailErr      string
	EmailOK       string
	PasswordErr   string
	PasswordOK    string
	AddOnErr      string
	AddOnOK       string
	StartFreshErr string // Danger zone: "start fresh" (wipe data) error
	DeleteErr     string // Danger zone: delete-account error
}

templ AccountPage(d AccountData) {
	@Layout("Account", "account", d.Collapsed) {
		<div class="mx-auto w-full max-w-2xl space-y-6">
			<h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
			@tabs.Tabs() {
				@tabs.List() {
					@tabs.Trigger(tabs.TriggerProps{Value: "account", IsActive: d.ActiveTab != "security"}) {
						@icon.User(icon.Props{Class: "size-4"})
						Account
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "security", IsActive: d.ActiveTab == "security"}) {
						@icon.Shield(icon.Props{Class: "size-4"})
						Security
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "addons", IsActive: d.ActiveTab == "addons"}) {
						@icon.Blocks(icon.Props{Class: "size-4"})
						Add-ons
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "account", IsActive: d.ActiveTab != "security" && d.ActiveTab != "addons", Class: "mt-6"}) {
					<div class="space-y-6">
						@accountProfileSection(d)
						@accountEmailSection(d)
						@accountDangerSection(d)
					</div>
				}
				@tabs.Content(tabs.ContentProps{Value: "security", IsActive: d.ActiveTab == "security", Class: "mt-6"}) {
					@accountSecuritySection(d)
				}
				@tabs.Content(tabs.ContentProps{Value: "addons", IsActive: d.ActiveTab == "addons", Class: "mt-6"}) {
					@accountAddOnsSection(d)
				}
			}
		</div>
	}
}

// accountProfileSection is the Account tab's "User profile" card: avatar
// (monogram, upload not wired yet) and the editable display name.
templ accountProfileSection(d AccountData) {
	<section class="space-y-2">
		<h2 class="text-sm font-semibold">User profile</h2>
		<div class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				<div class="space-y-1.5">
					<label class="text-sm font-medium leading-none">Avatar</label>
					<div class="flex items-center gap-3">
						@userAvatar(d.Name, d.AvatarVersion, "size-14 rounded-lg text-lg")
						<form method="post" action="/account/avatar" enctype="multipart/form-data">
							<label class="inline-flex h-8 cursor-pointer items-center rounded-full border border-input bg-background px-3 text-sm font-medium hover:bg-accent hover:text-accent-foreground">
								Change avatar
								<input
									type="file"
									name="avatar"
									accept="image/png,image/jpeg,image/gif,image/webp"
									class="sr-only"
									onchange="this.form.submit()"
								/>
							</label>
						</form>
						if d.AvatarVersion > 0 {
							<form method="post" action="/account/avatar/remove">
								@button.Button(button.Props{
									Type:    button.TypeSubmit,
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "text-muted-foreground hover:text-destructive",
								}) {
									Remove
								}
							</form>
						}
					</div>
					@settingsMessages(d.AvatarErr, d.AvatarOK)
				</div>
				<form id="profile-form" method="post" action="/account/profile" class="space-y-1.5">
					<label for="profile-name" class="text-sm font-medium leading-none">Name</label>
					@input.Input(input.Props{ID: "profile-name", Name: "name", Value: d.Name, Attributes: templ.Attributes{"required": true, "autocomplete": "name"}})
					@settingsMessages(d.ProfileErr, d.ProfileOK)
				</form>
			</div>
			<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Form: "profile-form"}) {
					Save changes
				}
			</div>
		</div>
	</section>
}

// accountEmailSection is the Account tab's "Change email" card. Submitting emails
// a confirmation link to the new address; the login email only changes once that
// link is clicked, so a pending change is surfaced here.
templ accountEmailSection(d AccountData) {
	<section class="space-y-2">
		<h2 class="text-sm font-semibold">Change email</h2>
		<form method="post" action="/account/email" class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				if d.PendingEmail != "" {
					<div class="rounded-md border border-primary/40 bg-primary/10 px-3 py-2 text-sm text-muted-foreground">
						Pending confirmation for <span class="font-medium text-foreground">{ d.PendingEmail }</span>. Your login email stays { d.Email } until that link is clicked.
					</div>
				}
				<div class="space-y-1.5">
					<label for="new-email" class="text-sm font-medium leading-none">New email</label>
					@input.Input(input.Props{ID: "new-email", Name: "new_email", Type: input.TypeEmail, Placeholder: d.Email, Attributes: templ.Attributes{"required": true, "autocomplete": "email"}})
				</div>
				<div class="space-y-1.5">
					<label for="email-password" class="text-sm font-medium leading-none">Current password</label>
					@input.Input(input.Props{ID: "email-password", Name: "password", Type: input.TypePassword, Attributes: templ.Attributes{"required": true, "autocomplete": "current-password"}})
				</div>
				@settingsMessages(d.EmailErr, d.EmailOK)
			</div>
			<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					Update email
				}
			</div>
		</form>
	</section>
}

// accountDangerSection is the Account tab's "Danger zone": irreversible actions
// (wipe data / delete account), each gated on the current password (and, for
// deletion, re-typing the account email). Both submit as full-page POSTs.
templ accountDangerSection(d AccountData) {
	<section class="space-y-2">
		<h2 class="text-sm font-semibold text-destructive">Danger zone</h2>
		<div class="divide-y overflow-hidden rounded-xl border border-destructive/40 bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				<div class="space-y-1">
					<h3 class="text-sm font-medium">Start fresh</h3>
					<p class="text-sm text-muted-foreground">
						Delete all your accounts, categories, transactions and goals and start
						over with the default starter budget. Your login and subscription are
						kept. This can't be undone.
					</p>
				</div>
				<form method="post" action="/account/start-fresh" class="space-y-4">
					@dangerPassword("sf_password")
					@settingsMessages(d.StartFreshErr, "")
					@dangerButton("Delete all data")
				</form>
			</div>
			<div class="space-y-4 p-4 sm:p-6">
				<div class="space-y-1">
					<h3 class="text-sm font-medium">Delete account</h3>
					<p class="text-sm text-muted-foreground">
						Permanently delete your account and everything in it. Your subscription
						is set to cancel at the end of the current period and won't renew. This
						can't be undone.
					</p>
				</div>
				<form method="post" action="/account/delete" class="space-y-4">
					@dangerPassword("del_password")
					<div class="space-y-1.5">
						<label for="confirm_email" class="text-sm font-medium leading-none">
							Type <span class="font-semibold text-foreground">{ d.Email }</span> to confirm
						</label>
						<input id="confirm_email" name="confirm_email" type="email" autocomplete="off" required placeholder={ d.Email } class={ authInputClass }/>
					</div>
					@settingsMessages(d.DeleteErr, "")
					@dangerButton("Delete my account")
				</form>
			</div>
		</div>
	</section>
}

// dangerPassword is the current-password input shared by the danger-zone forms.
// id is unique per form; the field name is always "password" (what the handlers
// read).
templ dangerPassword(id string) {
	<div class="space-y-1.5">
		<label for={ id } class="text-sm font-medium leading-none">Current password</label>
		<input id={ id } name="password" type="password" autocomplete="current-password" required class={ authInputClass }/>
	</div>
}

// dangerButton is the destructive submit button for a danger-zone form.
templ dangerButton(label string) {
	<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-destructive px-4 text-sm font-medium text-destructive-foreground transition-colors hover:bg-destructive/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive focus-visible:ring-offset-2 focus-visible:ring-offset-background">{ label }</button>
}

// accountSecuritySection is the Security tab's "Change password" card.
templ accountSecuritySection(d AccountData) {
	<section class="space-y-2">
		<h2 class="text-sm font-semibold">Change password</h2>
		<form method="post" action="/account/password" class="overflow-hidden rounded-xl border bg-card">
			<div class="space-y-4 p-4 sm:p-6">
				@passwordField("Current password", "current", "Enter your current password", "current-password", "")
				@passwordField("New password", "next", "New password", "new-password", "8")
				@settingsMessages(d.PasswordErr, d.PasswordOK)
			</div>
			<div class="flex items-center border-t bg-muted/30 px-4 py-3 sm:px-6">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					Update password
				}
			</div>
		</form>
	</section>
}

// accountAddOnsSection is the Add-ons tab: the feature catalog, each with a
// switch that turns it on or off for this user. Toggling submits the row's form
// (a full-page POST), so the sidebar nav reflects the change on re-render.
templ accountAddOnsSection(d AccountData) {
	<section class="space-y-2">
		<h2 class="text-sm font-semibold">Add-ons</h2>
		<p class="text-sm text-muted-foreground">Turn on only the features you need. Enable more any time.</p>
		@settingsMessages(d.AddOnErr, d.AddOnOK)
		<div class="divide-y overflow-hidden rounded-xl border bg-card">
			for _, a := range d.AddOns {
				@addOnRow(a)
			}
		</div>
	</section>
}

// addOnRow renders one catalog add-on: name, price, description, and the enable
// switch. The switch posts enabled=on when checked, nothing when unchecked; the
// handler reads that as on/off.
templ addOnRow(a store.AddOn) {
	<div class="flex items-start justify-between gap-4 p-4 sm:p-6">
		<div class="min-w-0 space-y-1">
			<div class="flex items-center gap-2">
				<span class="text-sm font-medium">{ a.Name }</span>
				<span class="rounded-full border px-2 py-0.5 text-xs text-muted-foreground">{ addOnPrice(a.PriceCents) }</span>
			</div>
			<p class="text-sm text-muted-foreground">{ a.Description }</p>
		</div>
		<form method="post" action={ addOnAction(a.Slug) } class="shrink-0 pt-0.5">
			@switchcomp.Switch(switchcomp.Props{
				Name:       "enabled",
				Checked:    a.Enabled,
				Attributes: templ.Attributes{"onchange": "this.form.submit()", "aria-label": "Toggle " + a.Name},
			})
		</form>
	</div>
}

// addOnPrice renders an add-on's monthly price, or "Free" when it's zero.
func addOnPrice(cents int64) string {
	if cents == 0 {
		return "Free"
	}
	return money.Format(cents) + "/mo"
}

// addOnAction builds the toggle endpoint for an add-on slug.
func addOnAction(slug string) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/account/addons/%s", slug))
}

// settingsMessages renders an inline error or success line for a settings card.
templ settingsMessages(errMsg, okMsg string) {
	if errMsg != "" {
		<p class="text-sm text-destructive">{ errMsg }</p>
	}
	if okMsg != "" {
		<p class="text-sm text-primary">{ okMsg }</p>
	}
}
