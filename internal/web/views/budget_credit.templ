package views

import (
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/table"
)

// BudgetCreditSection renders per-card credit activity as a top-of-table
// section between Income and Expenses: a muted "Credit" header row, an
// Account/Purchases/Payments/Owing sub-header (credit's own column labels, which
// differ from the budget grid), then one row per card. Renders nothing when
// there is no activity for the month.
templ BudgetCreditSection(d BudgetData) {
	if len(d.CreditRows) > 0 {
		<tbody id="budget-credit-head">
			@table.Row(table.RowProps{Class: "bg-muted hover:bg-muted", Attributes: templ.Attributes{"id": "credit-header"}}) {
				@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "6", "class": "p-2 align-middle"}}) {
					<div class="flex items-center gap-2">
						<button
							type="button"
							class="flex items-center gap-1.5 rounded-md px-1 py-0.5 hover:text-foreground"
							data-collapse="credit"
							title="Collapse or expand credit"
							aria-label="Toggle credit section"
						>
							@icon.ChevronRight(icon.Props{Class: "js-credit-caret size-3.5 text-muted-foreground transition-transform"})
							<span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Credit</span>
						</button>
						{{ owing := creditOwingTotal(d.CreditRows) }}
						<span class={ "js-credit-total-header ml-auto text-sm font-semibold tabular-nums " + owingColor(owing) }>
							{ money.Format(owing) }
						</span>
					</div>
				}
			}
			@subHeaderRow("Account", "Purchases", "Payments", "Owing")
		</tbody>
		<tbody id="budget-credit-body">
			for _, ca := range d.CreditRows {
				@table.Row() {
					@table.Cell(table.CellProps{Class: "pl-6 font-medium"}) {
						{ ca.AccountName }
					}
					@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums text-money-negative"}) {
						{ money.Format(ca.PurchasesCents) }
					}
					@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums text-money-positive"}) {
						{ money.Format(ca.PaymentsCents) }
					}
					@table.Cell(table.CellProps{Class: "text-right pr-4 tabular-nums"}) {
						if ca.OwingCents > 0 {
							<span class="text-money-negative">{ money.Format(ca.OwingCents) }</span>
						} else if ca.OwingCents < 0 {
							<span class="text-money-positive">{ money.Format(ca.OwingCents) }</span>
						} else {
							<span class="text-muted-foreground">{ money.Format(ca.OwingCents) }</span>
						}
					}
					@table.Cell()
					@table.Cell()
				}
			}
		</tbody>
	}
}

// creditOwingTotal sums the month's per-card owing so the collapsed Credit header
// can show a single "owing" figure.
func creditOwingTotal(rows []store.CreditActivity) (total int64) {
	for _, r := range rows {
		total += r.OwingCents
	}
	return
}

// owingColor tints an owing figure like the per-card Owing cells: positive (you
// owe) reads as negative money (terracotta), negative (overpaid/credit) as
// positive money (sage), zero neutral. Note the inversion — owing is the one
// place where a positive figure is the bad one.
func owingColor(v int64) string {
	switch {
	case v > 0:
		return "text-money-negative"
	case v < 0:
		return "text-money-positive"
	default:
		return "text-muted-foreground"
	}
}
