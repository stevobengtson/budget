package views

import (
	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/icon"
)

// BudgetCreditPanel is the per-card activity for the month: what went on each
// card, what was paid off, and what is still owing.
//
// DEVIATION from the handoff, flagged for review: the design retires the credit
// section entirely and surfaces only the owing figure in "Needs attention". That
// would drop the per-card purchases and payments totals, which appear nowhere
// else in the app — the account list shows balances and the transactions list
// shows individual entries, but neither gives this month-by-card summary. So
// owing does move to the rail as designed, and the detail survives here behind a
// button, mirroring the income panel.
templ BudgetCreditPanel(d BudgetData) {
	@dialogPanel("max-w-xl") {
		<div class="flex items-center justify-between gap-s3">
			<h2 class="font-heading text-[22px] font-semibold">{ i18n.Tf(ctx, "credit.panel_title", i18n.M{"Month": formatMonth(ctx, d.Month)}) }</h2>
			<button
				type="button"
				class="inline-flex size-9 items-center justify-center rounded-pill text-muted-foreground hover:bg-foreground/[0.07] hover:text-foreground"
				aria-label={ i18n.T(ctx, "common.close") }
				hx-on:click="document.getElementById('modal').innerHTML = ''"
			>
				@icon.X(icon.Props{Class: "size-[18px]"})
			</button>
		</div>
		if len(d.CreditRows) == 0 {
			<p class="text-[14px] text-muted-foreground">
				{ i18n.T(ctx, "credit.no_activity") }
			</p>
		} else {
			<div class="flex flex-col">
				<div class="grid grid-cols-[1fr_110px_110px_110px] gap-s3 border-b border-border pb-s2 text-[12px] font-bold uppercase tracking-[0.08em] text-muted-foreground">
					<span>{ i18n.T(ctx, "credit.col_account") }</span>
					<span class="text-right">{ i18n.T(ctx, "credit.col_spent_on_it") }</span>
					<span class="text-right">{ i18n.T(ctx, "credit.col_paid_off") }</span>
					<span class="text-right">{ i18n.T(ctx, "credit.col_owing") }</span>
				</div>
				for _, ca := range d.CreditRows {
					<div class="grid grid-cols-[1fr_110px_110px_110px] items-center gap-s3 border-b border-border py-s2 text-[15px] last:border-b-0">
						<span class="truncate font-semibold">{ ca.AccountName }</span>
						<span class="text-right tabular-nums text-money-negative">{ money.Format(ctx, ca.PurchasesCents) }</span>
						<span class="text-right tabular-nums text-money-positive">{ money.Format(ctx, ca.PaymentsCents) }</span>
						<span class={ "text-right font-bold tabular-nums", owingColor(ca.OwingCents) }>
							{ money.Format(ctx, ca.OwingCents) }
						</span>
					</div>
				}
				<div class="flex items-baseline justify-between gap-s2 border-t border-border pt-s3 text-[15px]">
					<span class="font-semibold">{ i18n.T(ctx, "budget.total_owing") }</span>
					{{ owing := creditOwingTotal(d.CreditRows) }}
					<span class={ "font-bold tabular-nums", owingColor(owing) }>{ money.Format(ctx, owing) }</span>
				</div>
			</div>
		}
		<div class="flex items-center justify-end">
			@button.Button(button.Props{
				Type:       "button",
				Variant:    button.VariantOutline,
				Size:       button.SizeSm,
				Class:      "rounded-pill",
				Attributes: templ.Attributes{"hx-on:click": "document.getElementById('modal').innerHTML = ''"},
			}) {
				{ i18n.T(ctx, "common.done") }
			}
		</div>
	}
}

// creditOwingTotal sums the month's per-card owing.
func creditOwingTotal(rows []store.CreditActivity) (total int64) {
	for _, r := range rows {
		total += r.OwingCents
	}
	return
}

// owingColor tints an owing figure: positive (you owe) reads as negative money
// (terracotta), negative (overpaid/credit) as positive money (sage), zero
// neutral. Note the inversion — owing is the one place where a positive figure
// is the bad one.
func owingColor(v int64) string {
	switch {
	case v > 0:
		return "text-money-negative"
	case v < 0:
		return "text-money-positive"
	default:
		return "text-money-zero"
	}
}
