package views

import (
	"fmt"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/templui/templui/components/icon"
)

// Rail cards carry p-s4 (17.6px) rather than the handoff's 13.2px: at the 32.2px
// corner radius these use, 13.2px leaves the first and last characters of a line
// sitting inside the curve, which reads as overflowing the card.
//
// BudgetRail is the Budget screen's 300px summary column: month navigation, the
// Ready-to-assign headline, the month's totals, and a "Needs attention" card
// that appears only when something is wrong.
//
// It replaces the old footer total rows that lived inside the budget table, so
// it is the out-of-band swap target for anything that moves money — see
// BudgetAssignResult. Being a plain div, it needs none of the <template>
// wrapping the table rows required to survive HTML table parsing.
//
// The account list is NOT here, though the design puts it in this rail: the app
// keeps its sidebar, which carries accounts on desktop and is the single source
// for them. See appShell.
templ BudgetRail(d BudgetData, oob bool) {
	{{ attrs := templ.Attributes{"id": "budget-rail"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<aside class="flex w-full shrink-0 flex-col gap-s3 lg:w-[300px]" { attrs... }>
		@railMonthNav(d)
		@railReadyToAssign(d)
		@railTotals(d)
		@railNeedsAttention(d)
		@railCardsOwing(d)
	</aside>
}

// railMonthNav is the month stepper: two pill icon buttons with the month
// centred between them. The "today" jump is kept as a quiet link beneath rather
// than a third button — the design's rail shows only the two steppers, but
// dropping the jump entirely would lose a control the app already had.
templ railMonthNav(d BudgetData) {
	<div class="flex flex-col gap-s1">
		<div class="flex items-center gap-s2">
			<a
				href={ templ.SafeURL(bgMonthHref(d.PrevMonth)) }
				aria-label="Previous month"
				class="inline-flex size-9 shrink-0 items-center justify-center rounded-pill border border-border text-foreground hover:bg-foreground/[0.07] active:bg-foreground/[0.14]"
			>
				@icon.ChevronLeft(icon.Props{Class: "size-[18px]"})
			</a>
			<span class="flex-1 text-center font-heading text-[22px] font-semibold">
				{ formatMonth(d.Month) }
			</span>
			<a
				href={ templ.SafeURL(bgMonthHref(d.NextMonth)) }
				aria-label="Next month"
				class="inline-flex size-9 shrink-0 items-center justify-center rounded-pill border border-border text-foreground hover:bg-foreground/[0.07] active:bg-foreground/[0.14]"
			>
				@icon.ChevronRight(icon.Props{Class: "size-[18px]"})
			</a>
		</div>
		if d.Month != nowMonth() {
			<a href={ templ.SafeURL(bgMonthHref(nowMonth())) } class="text-center text-[13px] text-muted-foreground underline-offset-2 hover:underline">
				back to this month
			</a>
		}
	</div>
}

// railReadyToAssign is the headline figure. It stays sage even when negative —
// the number itself carries the sign, and the wording below names the problem,
// so an over-assigned month reads as a sentence rather than a colour.
templ railReadyToAssign(d BudgetData) {
	<div class="flex flex-col gap-s2 rounded-xl bg-surface-ready p-s4 shadow-organic-sm">
		<span class="text-[12px] font-bold uppercase tracking-[0.08em] text-surface-ready-fg">
			Ready to assign
		</span>
		<span class="font-heading text-[40px] font-semibold leading-[1.1] tabular-nums text-surface-ready-fg">
			{ money.Format(d.Remain) }
		</span>
		if d.Remain < 0 {
			<span class="text-[13px] text-surface-ready-fg">
				You have assigned more than you expect to earn this month.
			</span>
		}
	</div>
}

// railTotals is the month at a glance. These four figures used to be footer rows
// inside the table; pulling them out is what lets the category list drop to two
// numbers per row.
templ railTotals(d BudgetData) {
	{{ assigned, spent, _ := budgetTotals(d.Groups) }}
	{{ stillInEnvelopes := assigned - spent }}
	<div class="flex flex-col gap-s2 rounded-xl bg-card p-s4 shadow-organic-sm">
		@railTotalRow("Income", money.Format(d.Estimated), "")
		@railTotalRow("Assigned", money.Format(assigned), "")
		@railTotalRow("Spent", money.Format(spent), "")
		<div class="h-px bg-border"></div>
		@railTotalRow("Still in envelopes", money.Format(stillInEnvelopes), availColorClass(stillInEnvelopes))
	</div>
}

templ railTotalRow(label, value, valueClass string) {
	<div class="flex items-baseline justify-between gap-s2 text-[15px]">
		<span class="text-muted-foreground">{ label }</span>
		<span class={ "font-bold tabular-nums", valueClass }>{ value }</span>
	</div>
}

// railNeedsAttention lists what has actually gone wrong — categories spent past
// what was in them — and renders nothing at all when nothing has. It is
// deliberately only overspending: a card balance is a fact to know, not a
// mistake to correct, and mixing the two made a normal month look alarming.
// Card balances live in railCardsOwing below.
//
// Overspending is terracotta here, but it is also worded ("overspent"), so the
// meaning never rests on colour alone.
templ railNeedsAttention(d BudgetData) {
	{{ over := overspentRows(d.Groups) }}
	if len(over) > 0 {
		<div class="flex flex-col gap-s2 rounded-xl bg-surface-attention p-s4 text-surface-attention-fg shadow-organic-sm">
			<span class="text-[12px] font-bold uppercase tracking-[0.08em]">Needs attention</span>
			for _, r := range over {
				// On a phone this is the way into the assign sheet: an overspend is
				// the thing you most want to act on, so it is a 48px tap target
				// rather than a line of text. On desktop the row's own Assigned
				// field is right there, so it stays plain.
				<button
					type="button"
					class="flex min-h-[48px] items-center justify-between gap-s2 rounded-md text-left text-[14px] md:pointer-events-none md:min-h-0"
					hx-get={ fmt.Sprintf("/budget/assign/%d/sheet?month=%s", r.CategoryID, d.Month) }
					hx-target="#modal"
					hx-swap="innerHTML"
				>
					<span class="truncate">{ r.CategoryName } overspent</span>
					<span class="flex shrink-0 items-center gap-1">
						<span class="font-bold tabular-nums">{ money.Format(r.AvailableCents) }</span>
						@icon.ChevronRight(icon.Props{Class: "size-4 md:hidden"})
					</span>
				</button>
			}
		</div>
	}
}

// railCardsOwing reports what is sitting on cards and loans. It is a plain
// raised surface, not the attention tint: carrying a balance is a normal state
// of affairs and only the figures are terracotta. Renders nothing when no card
// carries a balance, and opens the per-card detail panel for the breakdown.
templ railCardsOwing(d BudgetData) {
	{{ owing := owingRows(d.CreditRows) }}
	if len(owing) > 0 {
		<div class="flex flex-col gap-s2 rounded-xl bg-card p-s4 shadow-organic-sm">
			<div class="flex items-baseline justify-between gap-s2">
				<span class="text-[12px] font-bold uppercase tracking-[0.08em] text-muted-foreground">
					On your cards
				</span>
				<button
					type="button"
					class="text-[13px] text-muted-foreground underline-offset-2 hover:text-foreground hover:underline"
					hx-get={ "/budget/credit/panel?month=" + d.Month }
					hx-target="#modal"
					hx-swap="innerHTML"
				>
					details
				</button>
			</div>
			for _, c := range owing {
				<div class="flex items-baseline justify-between gap-s2 text-[14px]">
					<span class="truncate text-muted-foreground">{ c.AccountName }</span>
					<span class="shrink-0 font-bold tabular-nums text-money-negative">
						{ money.Format(c.OwingCents) }
					</span>
				</div>
			}
			if len(owing) > 1 {
				<div class="h-px bg-border"></div>
				<div class="flex items-baseline justify-between gap-s2 text-[14px]">
					<span class="text-muted-foreground">Total owing</span>
					<span class="font-bold tabular-nums text-money-negative">
						{ money.Format(creditOwingTotal(owing)) }
					</span>
				</div>
			}
		</div>
	}
}

// overspentRows collects the categories that have gone negative, in list order.
func overspentRows(groups []BudgetGroup) []store.CategoryBudget {
	var out []store.CategoryBudget
	for _, g := range groups {
		for _, r := range g.Rows {
			if r.AvailableCents < 0 {
				out = append(out, r)
			}
		}
	}
	return out
}

// owingRows collects the cards actually carrying a balance. A zero or negative
// owing figure is nothing to act on, so it never reaches the card.
func owingRows(rows []store.CreditActivity) []store.CreditActivity {
	var out []store.CreditActivity
	for _, r := range rows {
		if r.OwingCents > 0 {
			out = append(out, r)
		}
	}
	return out
}
