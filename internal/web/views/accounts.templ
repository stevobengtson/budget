package views

import (
	"fmt"
	"strconv"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/checkbox"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	"github.com/templui/templui/components/table"
)

type AccountsData struct {
	Rows       []store.AccountWithBalance
	Categories []store.Category
}

templ AccountsPage(d AccountsData, collapsed bool) {
	@Layout("Accounts", "accounts", collapsed) {
		<div class="mb-4 flex items-center justify-between gap-4">
			<h1 class="text-2xl font-semibold tracking-tight">Accounts</h1>
			@button.Button(button.Props{
				Href: "/accounts/new",
				Size: button.SizeSm,
				Attributes: templ.Attributes{
					"hx-get":    "/accounts/new",
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
				},
			}) {
				+ new
			}
		</div>

		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() { Name }
					@table.Head() { Type }
					@table.Head(table.HeadProps{Class: "text-right"}) { Balance }
					@table.Head(table.HeadProps{Class: "text-right"}) { Limit }
					@table.Head(table.HeadProps{Class: "text-right"}) { APR }
					@table.Head(table.HeadProps{Class: "text-right"}) { Available }
					@table.Head() { }
				}
			}
			@table.Body() {
				for _, a := range d.Rows {
					@AccountRow(a)
				}
			}
		}
	}
}

templ AccountRow(a store.AccountWithBalance) {
	@table.Row(table.RowProps{Attributes: templ.Attributes{"id": fmt.Sprintf("acct-%d", a.ID)}}) {
		@table.Cell(table.CellProps{Class: "font-medium"}) { { a.Name } }
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) { { string(a.Type) } }
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			@SignedMoney(a.BalanceCents)
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			if a.CreditLimitCents != nil {
				{ money.Format(*a.CreditLimitCents) }
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			if a.AprBps != nil {
				{ fmt.Sprintf("%.2f%%", float64(*a.AprBps)/100.0) }
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			if a.CreditLimitCents != nil {
				<span class="text-emerald-500">{ money.Format(availableCredit(a)) }</span>
			}
		}
		@table.Cell(table.CellProps{Class: "whitespace-nowrap"}) {
			@button.Button(button.Props{
				Href:    fmt.Sprintf("/accounts/%d/edit", a.ID),
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "mr-1",
				Attributes: templ.Attributes{
					"hx-get":    fmt.Sprintf("/accounts/%d/edit", a.ID),
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
				},
			}) {
				edit
			}
			@button.Button(button.Props{
				Variant: button.VariantDestructive,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"hx-post":    fmt.Sprintf("/accounts/%d/archive", a.ID),
					"hx-target":  fmt.Sprintf("#acct-%d", a.ID),
					"hx-swap":    "outerHTML",
					"hx-confirm": "Archive this account?",
				},
			}) {
				archive
			}
		}
	}
}

type AccountFormData struct {
	Editing           bool
	ID                int64
	Name              string
	Type              string
	StartingBalance   string
	CreditLimit       string
	APR               string
	MonthlyPayment    string
	IncludeInPaydown  bool
	PaymentCategoryID *int64
	Categories        []store.Category
}

templ AccountForm(d AccountFormData) {
	@dialogPanel("max-w-xl") {
		<form
			id="acct-form-inner"
			if d.Editing {
				hx-put={ fmt.Sprintf("/accounts/%d", d.ID) }
			} else {
				hx-post="/accounts"
			}
			hx-target="#modal"
			hx-swap="innerHTML"
			class="grid gap-4"
		>
			@dialog.Header() {
				@dialog.Title() {
					if d.Editing {
						Edit account
					} else {
						New account
					}
				}
			}
			<div class="grid gap-3">
				@formRow("acct-name", "Name") {
					@input.Input(input.Props{ID: "acct-name", Name: "name", Value: d.Name, Required: true})
				}
				@formRow("acct-type", "Type") {
					@SelectField(SelectFieldProps{ID: "acct-type", Name: "type"}, accountTypeOptions(d.Type))
				}
				<div class="grid grid-cols-2 gap-3">
					@formRow("acct-start", "Starting balance") {
						@input.Input(input.Props{ID: "acct-start", Name: "starting_balance", Value: d.StartingBalance, Placeholder: "0.00", Class: "tabular-nums"})
					}
					@formRow("acct-limit", "Credit limit") {
						@input.Input(input.Props{ID: "acct-limit", Name: "credit_limit", Value: d.CreditLimit, Placeholder: "(optional)", Class: "tabular-nums"})
					}
					@formRow("acct-apr", "APR %") {
						@input.Input(input.Props{ID: "acct-apr", Name: "apr", Value: d.APR, Placeholder: "19.99", Class: "tabular-nums"})
					}
					@formRow("acct-pay", "Monthly payment") {
						@input.Input(input.Props{ID: "acct-pay", Name: "monthly_payment", Value: d.MonthlyPayment, Placeholder: "(optional)", Class: "tabular-nums"})
					}
				</div>
				<div class="flex items-center gap-2">
					@checkbox.Checkbox(checkbox.Props{
						ID:      "acct-paydown",
						Name:    "include_in_paydown",
						Value:   "1",
						Checked: d.IncludeInPaydown,
					})
					@label.Label(label.Props{For: "acct-paydown"}) {
						Include in paydown
					}
				</div>
				@formRow("acct-paycat", "Payment category") {
					@SelectField(SelectFieldProps{
						ID:          "acct-paycat",
						Name:        "payment_category_id",
						Placeholder: "(none)",
					}, paymentCategoryOptions(d.Categories, d.PaymentCategoryID))
				}
			</div>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Type:    "button",
					Attributes:   templ.Attributes{"hx-on:click": "document.getElementById('modal').replaceChildren()"},
				}) {
					cancel
				}
				@button.Button(button.Props{Type: "submit"}) {
					save
				}
			}
		</form>
	}
}

func accountTypeOptions(selected string) []Opt {
	types := []string{"checking", "savings", "cash", "credit", "loan"}
	out := make([]Opt, 0, len(types))
	for _, t := range types {
		out = append(out, Opt{
			Value:    t,
			Label:    t,
			Selected: t == selected,
		})
	}
	return out
}

func paymentCategoryOptions(cats []store.Category, selected *int64) []Opt {
	out := make([]Opt, 0, len(cats))
	for _, c := range cats {
		out = append(out, Opt{
			Value:    strconv.FormatInt(c.ID, 10),
			Label:    c.Name,
			Selected: selected != nil && *selected == c.ID,
		})
	}
	return out
}

func availableCredit(a store.AccountWithBalance) int64 {
	if a.CreditLimitCents == nil {
		return 0
	}
	v := a.BalanceCents + *a.CreditLimitCents
	if v < 0 {
		return 0
	}
	return v
}
