package views

import (
	"fmt"
	"strconv"

	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/sbengtson/budget/internal/web/components/ui/buttongroup"
	"github.com/templui/templui/components/checkbox"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
)

type AccountFormData struct {
	Editing           bool
	ID                int64
	Name              string
	Type              string
	StartingBalance   string
	CreditLimit       string
	APR               string
	MonthlyPayment    string
	IncludeInPaydown  bool
	PaymentCategoryID *int64
	Categories        []store.Category
}

templ AccountForm(d AccountFormData) {
	@sheetPanel("") {
		<form
			id="acct-form-inner"
			if d.Editing {
				hx-put={ fmt.Sprintf("/accounts/%d", d.ID) }
			} else {
				hx-post="/accounts"
			}
			hx-target="#modal"
			hx-swap="innerHTML"
			class="grid gap-4"
		>
			@dialog.Header() {
				@dialog.Title() {
					if d.Editing {
						{ i18n.T(ctx, "accounts.edit_title") }
					} else {
						{ i18n.T(ctx, "accounts.new_title") }
					}
				}
			}
			<div class="grid gap-3">
				@formRow("acct-name", i18n.T(ctx, "accounts.name_field")) {
					@input.Input(input.Props{ID: "acct-name", Name: "name", Value: d.Name, Required: true})
				}
				<div class="grid gap-1.5">
					@label.Label(label.Props{For: "acct-type"}) {
						{ i18n.T(ctx, "accounts.type_label") }
					}
					@buttongroup.ButtonGroup(buttongroup.Props{
						ID:    "acct-type",
						Name:  "type",
						Value: accountTypeOrDefault(d.Type),
						Class: "w-full rounded-pill",
						Options: []buttongroup.Option{
							{Value: "checking", Label: i18n.T(ctx, "accounts.type_chequing")},
							{Value: "savings", Label: i18n.T(ctx, "accounts.type_savings")},
							{Value: "credit", Label: i18n.T(ctx, "accounts.type_credit")},
							{Value: "loan", Label: i18n.T(ctx, "accounts.type_loan")},
						},
					})
				</div>
				<div class="grid grid-cols-2 gap-3">
					@formRow("acct-start", i18n.T(ctx, "accounts.balance_field")) {
						@input.Input(input.Props{ID: "acct-start", Name: "starting_balance", Value: d.StartingBalance, Placeholder: "0.00", Class: "tabular-nums"})
					}
					@formRow("acct-limit", i18n.T(ctx, "accounts.credit_limit_field")) {
						@input.Input(input.Props{ID: "acct-limit", Name: "credit_limit", Value: d.CreditLimit, Placeholder: i18n.T(ctx, "common.optional_placeholder"), Class: "tabular-nums"})
					}
					// APR + monthly payment feed the paydown projection, so they only
					// show while that add-on is on. Stored values survive a save with
					// the add-on off — the handler carries them forward.
					if AddOnEnabled(ctx, "paydown") {
						@formRow("acct-apr", i18n.T(ctx, "accounts.apr_field")) {
							@input.Input(input.Props{ID: "acct-apr", Name: "apr", Value: d.APR, Placeholder: "19.99", Class: "tabular-nums"})
						}
						@formRow("acct-pay", i18n.T(ctx, "accounts.monthly_payment_field")) {
							@input.Input(input.Props{ID: "acct-pay", Name: "monthly_payment", Value: d.MonthlyPayment, Placeholder: i18n.T(ctx, "common.optional_placeholder"), Class: "tabular-nums"})
						}
					}
				</div>
				if AddOnEnabled(ctx, "paydown") {
					<div class="flex items-center gap-2">
						@checkbox.Checkbox(checkbox.Props{
							ID:      "acct-paydown",
							Name:    "include_in_paydown",
							Value:   "1",
							Checked: d.IncludeInPaydown,
						})
						@label.Label(label.Props{For: "acct-paydown"}) {
							{ i18n.T(ctx, "accounts.include_in_paydown") }
						}
					</div>
				}
				<p class="text-[13px] text-muted-foreground">
					{ i18n.T(ctx, "wizard.account_sign_note") }
				</p>
				if AddOnEnabled(ctx, "paydown") {
					@formRow("acct-paycat", i18n.T(ctx, "accounts.payment_category_field")) {
						@SelectField(SelectFieldProps{
							ID:          "acct-paycat",
							Name:        "payment_category_id",
							Placeholder: i18n.T(ctx, "common.none_placeholder"),
						}, paymentCategoryOptions(d.Categories, d.PaymentCategoryID))
					}
				}
			</div>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Type:    "button",
					Attributes:   templ.Attributes{"hx-on:click": "document.getElementById('modal').replaceChildren()"},
				}) {
					{ i18n.T(ctx, "common.cancel") }
				}
				@button.Button(button.Props{Type: "submit"}) {
					{ i18n.T(ctx, "accounts.save") }
				}
			}
		</form>
	}
}

func accountTypeOptions(selected string) []Opt {
	types := []string{"checking", "savings", "cash", "credit", "loan"}
	out := make([]Opt, 0, len(types))
	for _, t := range types {
		out = append(out, Opt{
			Value:    t,
			Label:    t,
			Selected: t == selected,
		})
	}
	return out
}

func paymentCategoryOptions(cats []store.Category, selected *int64) []Opt {
	out := make([]Opt, 0, len(cats))
	for _, c := range cats {
		out = append(out, Opt{
			Value:    strconv.FormatInt(c.ID, 10),
			Label:    c.Name,
			Selected: selected != nil && *selected == c.ID,
		})
	}
	return out
}

// accountTypeOrDefault defaults a new account to checking — the account most
// people add first, and the one the first-run wizard pre-selects.
func accountTypeOrDefault(s string) string {
	if s == "" {
		return "checking"
	}
	return s
}
