package accountsoverview

import (
	"strconv"

	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/signedmoney"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/dropdown"
)

// AccountsOverview renders a grouped account list (Cash/Credit/Loan) with an
// estimated net-worth footer. Self-contained: pass the raw account slice and it
// does its own grouping and totaling. Reusable on any page.
templ AccountsOverview(accts []store.AccountWithBalance, month string) {
	@overview(accts, month, false)
}

// AccountsOverviewOOB renders the overview as an out-of-band swap so a
// transaction mutation can refresh account balances without re-rendering the
// page. It targets the stable #accounts-overview container.
templ AccountsOverviewOOB(accts []store.AccountWithBalance, month string) {
	@overview(accts, month, true)
}

templ overview(accts []store.AccountWithBalance, month string, oob bool) {
	{{ buckets, net := group(accts) }}
	{{ attrs := templ.Attributes{"id": "accounts-overview"} }}
	if oob {
		{{ attrs["hx-swap-oob"] = "true" }}
	}
	<div { attrs... }>
		<div class="space-y-3">
			for _, b := range buckets {
				<div class="border-t border-border pt-3 first:border-t-0 first:pt-0">
					<div class="flex items-center justify-between font-medium">
						<span>
							{ b.Name } <span class="text-muted-foreground">({ strconv.Itoa(len(b.Accounts)) })</span>
						</span>
						<span class="tabular-nums">{ money.Format(b.TotalCents) }</span>
					</div>
					<div class="mt-1 space-y-0.5">
						for _, a := range b.Accounts {
							<div class="flex items-center rounded pr-1 transition-colors hover:bg-muted/60">
								<a
									href={ templ.URL(txHref(a.ID, month)) }
									class="flex flex-1 items-center justify-between py-0.5 pl-3 pr-1 text-sm"
									title={ "View transactions for " + a.Name }
								>
									<span class="text-foreground">
										<span class="text-muted-foreground">└ </span>{ a.Name }
									</span>
									<span class="tabular-nums text-foreground">{ money.Format(displayCents(a)) }</span>
								</a>
								@acctMenu(a)
							</div>
						}
					</div>
				</div>
			}
		</div>
			<div class="mt-3 flex items-center justify-between border-t border-border pt-3 font-semibold">
				<span>Est. Net Worth</span>
				@signedmoney.Money(net)
			</div>
			<div class="mt-3 flex justify-end">
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-get":    "/accounts/new",
						"hx-target": "#modal",
						"hx-swap":   "innerHTML",
					},
				}) {
					Add Account
				}
			</div>
	</div>
}

// acctMenu renders the per-account three-dot actions menu (Edit / Archive),
// matching the transactions and budget rows' menu system.
templ acctMenu(a store.AccountWithBalance) {
	{{ id := strconv.FormatInt(a.ID, 10) }}
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class:      "inline-flex size-6 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground",
			Attributes: templ.Attributes{"title": "Account actions"},
		}) {
			⋮
		}
		@dropdown.Content() {
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-get":    "/accounts/" + id + "/edit",
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
				},
			}) {
				Edit Account
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class: "text-destructive",
				Attributes: templ.Attributes{
					"hx-post":    "/accounts/" + id + "/archive",
					"hx-swap":    "none",
					"hx-confirm": "Archive " + a.Name + "?",
				},
			}) {
				Archive Account
			}
		}
	}
}

// txHref builds a link to the transactions page filtered to one account. The
// selected month is preserved when set (e.g. when navigating from a past-month
// budget view), so the transactions page opens on the same month; when unset it
// is omitted and the transactions page falls back to the current month.
func txHref(accountID int64, month string) string {
	acct := "account=" + strconv.FormatInt(accountID, 10)
	if month != "" {
		return "/transactions?month=" + month + "&" + acct
	}
	return "/transactions?" + acct
}
