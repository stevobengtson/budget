package accountsoverview

import (
	"context"
	"net/url"
	"strconv"

	"github.com/sbengtson/budget/internal/core/i18n"
	"github.com/sbengtson/budget/internal/core/money"
	"github.com/sbengtson/budget/internal/core/store"
	"github.com/sbengtson/budget/internal/web/components/signedmoney"
	"github.com/sbengtson/budget/internal/web/components/ui/button"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
)

// ViewContext describes the page the sidebar is being rendered alongside. All
// three fields come from the same place — the current URL's query string — and
// travel together: AccountID highlights the active row, while Month and
// CategoryID are carried into every account link so switching accounts keeps
// the view you were in. Grouped into a struct rather than passed positionally
// because two bare *int64 parameters are trivial to transpose.
type ViewContext struct {
	Month      string // "YYYY-MM"; empty omits the param and the page falls back to today
	AccountID  *int64 // the account being viewed, highlighted in the list
	CategoryID *int64 // the active category filter, preserved across account switches
	// OnTransactions reports that the transactions page is what we are looking
	// at. Needed to distinguish "viewing every account" — where the All Accounts
	// row is the active one — from being on some other page entirely, where
	// nothing in this list is active. Both cases have a nil AccountID.
	OnTransactions bool
	// BankSync reports the bank_sync add-on is enabled, showing the "Link a
	// bank" button and per-account connect/disconnect menu items. Passed in
	// rather than read from ctx so this component stays independent of the
	// views package.
	BankSync bool
	// ReconnectItems are the user's Plaid items that need re-authentication,
	// rendered as a banner prompting the update-mode Link flow.
	ReconnectItems []store.PlaidItem
	// ReviewCount badges the All Accounts row with the user's unreviewed
	// bank-sync imports (0 renders nothing).
	ReviewCount int64
}

// AccountsOverview renders a grouped account list (Cash/Credit/Loan) with an
// estimated net-worth footer. Self-contained: pass the raw account slice and it
// does its own grouping and totaling. Reusable on any page — pass a zero
// ViewContext where there is no active view (nothing highlighted, bare links).
//
// data-accounts-overview is the stable marker. It is an attribute rather than an
// id because the fragment is now mounted twice — once in the desktop sidebar and
// once on the Budget page for mobile — and duplicate ids are invalid. Nothing
// targets it: the refetch targets each mount's own outer id and swaps innerHTML.
templ AccountsOverview(accts []store.AccountWithBalance, view ViewContext) {
	{{ buckets, net := group(accts) }}
	<div data-accounts-overview>
		for _, it := range view.ReconnectItems {
			<div class="mb-2 rounded-md border border-border bg-muted/60 px-2 py-1.5 text-[13px]">
				<p>{ i18n.Tf(ctx, "plaid.reconnect_banner", i18n.M{"Institution": institutionLabel(ctx, it)}) }</p>
				<button
					type="button"
					class="mt-1 font-medium text-primary underline-offset-2 hover:underline"
					hx-post={ "/plaid/items/" + strconv.FormatInt(it.ID, 10) + "/reconnect" }
					hx-target="#modal"
					hx-swap="innerHTML"
				>
					{ i18n.T(ctx, "plaid.reconnect_button") }
				</button>
			</div>
		}
		// "All Accounts" is the unfiltered head of this same list rather than a
		// separate nav entry: every row below links to the transactions page
		// scoped to one account, so the zero-state of that choice belongs here.
		{{ allActive := view.OnTransactions && view.AccountID == nil }}
		<div class={ acctRowClass(allActive), "mb-2" }>
			<a
				href={ templ.URL(allAccountsHref(view)) }
				class="flex flex-1 items-center justify-between rounded-md py-1 pl-2 pr-1 text-sm font-medium"
				title={ i18n.T(ctx, "accounts.view_all_tx") }
				if allActive {
					aria-current="page"
				}
			>
				<span class={ acctNameClass(allActive) }>{ i18n.T(ctx, "nav.all_accounts") }</span>
				if view.ReviewCount > 0 {
					<span class="rounded-pill bg-tag-amber-bg px-1.5 py-0.5 text-[11px] font-bold tabular-nums text-tag-amber-fg">
						{ strconv.FormatInt(view.ReviewCount, 10) }
					</span>
				}
			</a>
		</div>
		<div class="space-y-3">
			if len(buckets) == 0 {
				<p class="px-2 py-1 text-sm text-muted-foreground">
					{ i18n.T(ctx, "accounts.overview_empty") }
				</p>
			}
			for _, b := range buckets {
				<div class="border-t border-border pt-3 first:border-t-0 first:pt-0">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
							{ i18n.Tf(ctx, "accounts.bucket_heading", i18n.M{"Name": i18n.T(ctx, "accounts.bucket_"+b.Key), "Count": len(b.Accounts)}) }
						</span>
						<span class="tabular-nums text-sm font-medium">{ money.Format(ctx, b.TotalCents) }</span>
					</div>
					<div class="mt-1 space-y-0.5">
						for _, a := range b.Accounts {
							{{ active := view.AccountID != nil && *view.AccountID == a.ID }}
							<div class={ acctRowClass(active) }>
								<a
									href={ templ.URL(txHref(a.ID, view)) }
									class="flex flex-1 items-center justify-between rounded-md py-1 pl-2 pr-1 text-sm"
									title={ i18n.Tf(ctx, "accounts.view_tx_for", i18n.M{"Name": a.Name}) }
									if active {
										aria-current="page"
									}
								>
									<span class={ acctNameClass(active) }>{ a.Name }</span>
									<span class="tabular-nums text-muted-foreground">{ money.Format(ctx, displayCents(a)) }</span>
								</a>
								@acctMenu(a, view)
							</div>
						}
					</div>
				</div>
			}
		</div>
			if len(buckets) > 0 {
				<div class="mt-3 flex items-center justify-between border-t border-border pt-3 font-semibold">
					<span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "accounts.net_worth") }</span>
					@signedmoney.Money(net)
				</div>
			}
			<div class="mt-3 flex justify-end gap-2">
				if view.BankSync {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Attributes: templ.Attributes{
							"hx-get":    "/plaid/link",
							"hx-target": "#modal",
							"hx-swap":   "innerHTML",
						},
					}) {
						{ i18n.T(ctx, "plaid.link_bank") }
					}
				}
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-get":    "/accounts/new",
						"hx-target": "#modal",
						"hx-swap":   "innerHTML",
					},
				}) {
					{ i18n.T(ctx, "accounts.add_account") }
				}
			</div>
	</div>
}

// acctMenu renders the per-account three-dot actions menu (Edit / Archive,
// plus bank connect/disconnect when the bank_sync add-on is on), matching the
// transactions and budget rows' menu system.
templ acctMenu(a store.AccountWithBalance, view ViewContext) {
	{{ id := strconv.FormatInt(a.ID, 10) }}
	@dropdown.Dropdown() {
		@dropdown.Trigger(dropdown.TriggerProps{
			Class:      "inline-flex size-6 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground",
			Attributes: templ.Attributes{"title": i18n.T(ctx, "paydown.account_actions")},
		}) {
			@icon.EllipsisVertical(icon.Props{Class: "size-3.5"})
		}
		@dropdown.Content() {
			@dropdown.Item(dropdown.ItemProps{
				Attributes: templ.Attributes{
					"hx-get":    "/accounts/" + id + "/edit",
					"hx-target": "#modal",
					"hx-swap":   "innerHTML",
				},
			}) {
				{ i18n.T(ctx, "accounts.menu_edit") }
			}
			if view.BankSync {
				if a.PlaidLinked() {
					@dropdown.Item(dropdown.ItemProps{
						Attributes: templ.Attributes{
							"hx-post":    "/plaid/accounts/" + id + "/unlink",
							"hx-swap":    "none",
							"hx-confirm": i18n.Tf(ctx, "plaid.disconnect_confirm", i18n.M{"Name": a.Name}),
						},
					}) {
						{ i18n.T(ctx, "plaid.disconnect_account") }
					}
				} else {
					@dropdown.Item(dropdown.ItemProps{
						Attributes: templ.Attributes{
							"hx-get":    "/plaid/link?account=" + id,
							"hx-target": "#modal",
							"hx-swap":   "innerHTML",
						},
					}) {
						{ i18n.T(ctx, "plaid.connect_account") }
					}
				}
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{
				Class: "text-destructive",
				Attributes: templ.Attributes{
					"hx-post":    "/accounts/" + id + "/archive",
					"hx-swap":    "none",
					"hx-confirm": archiveConfirm(ctx, a.Name),
				},
			}) {
				{ i18n.T(ctx, "accounts.menu_archive") }
			}
		}
	}
}

// acctRowClass styles one account row. The selected row reuses the primary
// nav's active treatment (templUI applies these same classes for
// data-tui-sidebar-active) so a selected account reads identically to the
// selected Budget item. Hover is dropped when active — it would otherwise
// paint over the accent background on mouseover.
func acctRowClass(active bool) string {
	const base = "flex items-center rounded-md pr-1 transition-colors"
	if active {
		return base + " bg-sidebar-accent font-medium text-sidebar-accent-foreground"
	}
	return base + " hover:bg-muted/60"
}

// acctNameClass keeps the account name readable on the active row's accent
// background. The balance stays muted in both states, preserving the
// name-over-number hierarchy.
func acctNameClass(active bool) string {
	if active {
		return "truncate text-sidebar-accent-foreground"
	}
	return "truncate text-sidebar-foreground"
}

// allAccountsHref is txHref without the account param: the same view, unscoped.
func allAccountsHref(view ViewContext) string {
	q := url.Values{}
	if view.Month != "" {
		q.Set("month", view.Month)
	}
	if view.CategoryID != nil {
		q.Set("category", strconv.FormatInt(*view.CategoryID, 10))
	}
	if len(q) == 0 {
		return "/transactions"
	}
	return "/transactions?" + q.Encode()
}

// txHref builds a link to the transactions page for one account, carrying the
// current view's month and category filter so switching accounts changes only
// the account. An unset month is omitted and the transactions page falls back
// to the current month; an unset category means no category filter.
//
// Built with url.Values rather than concatenation because month originates in
// the HX-Current-URL header rather than in our own code: an unescaped "&" in it
// would otherwise append extra query params, and Gin reads the first value of a
// repeated param.
func txHref(accountID int64, view ViewContext) string {
	q := url.Values{}
	if view.Month != "" {
		q.Set("month", view.Month)
	}
	q.Set("account", strconv.FormatInt(accountID, 10))
	if view.CategoryID != nil {
		q.Set("category", strconv.FormatInt(*view.CategoryID, 10))
	}
	return "/transactions?" + q.Encode()
}

// institutionLabel names an item in the reconnect banner; a bank that never
// reported a name falls back to a generic label rather than an empty string.
func institutionLabel(ctx context.Context, it store.PlaidItem) string {
	if it.InstitutionName != "" {
		return it.InstitutionName
	}
	return i18n.T(ctx, "plaid.your_bank")
}

// archiveConfirm words the archive prompt so it states what actually happens.
// Archiving is not a delete: the transactions stay put and still count in past
// months — only the account's presence in the sidebar and the paydown plan
// changes.
func archiveConfirm(ctx context.Context, name string) string {
	return i18n.Tf(ctx, "accounts.archive_confirm", i18n.M{"Name": name})
}
