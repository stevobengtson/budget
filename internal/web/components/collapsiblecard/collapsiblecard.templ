package collapsiblecard

import (
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/collapsible"
)

// Props configures a collapsible card. PersistKey is written as
// data-persist-collapsible for the client script that remembers open state via
// the budget_<key>_open cookie.
type Props struct {
	Title      string
	ID         string
	PersistKey string
	Open       bool
}

// Card renders a card whose body collapses. The caller passes the body
// (card.Content, and optionally card.Footer) as children; they are placed
// inside collapsible.Content.
templ Card(p Props) {
	@collapsible.Collapsible(collapsible.Props{Open: p.Open, ID: p.ID, Attributes: templ.Attributes{"data-persist-collapsible": p.PersistKey}}) {
		@card.Card() {
			@collapsible.Trigger(collapsible.TriggerProps{Class: "cursor-pointer select-none"}) {
				@card.Header(card.HeaderProps{Class: "pb-6"}) {
					<div class="flex items-center justify-between gap-2">
						@card.Title() {
							{ p.Title }
						}
						@chevron()
					</div>
				}
			}
			@collapsible.Content(collapsible.ContentProps{Class: openClass(p.Open)}) {
				{ children... }
			}
		}
	}
}

// chevron is the open/closed indicator; rotates when the collapsible root
// reports data-tui-collapsible-state="closed".
templ chevron() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground transition-transform [[data-tui-collapsible-state=closed]_&]:-rotate-90">
		<path d="m6 9 6 6 6-6"></path>
	</svg>
}

// openClass returns the templUI content class that renders the card expanded on
// first paint, or "" when collapsed — matching the root's Open state avoids a
// flash of expand-then-collapse before the collapsible script initializes.
func openClass(open bool) string {
	if open {
		return "tui-collapsible-open"
	}
	return ""
}
