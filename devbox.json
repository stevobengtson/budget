{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "go@1.26.2",
    "templ@0.3.1001",
    "goose@3.27.1",
    "air@1.65.3",
    "tailwindcss_4@4.3.0",
    "go-task@latest"
  ],
  "env": {
    "DB_PATH": "./data/budget.db",
    "GOFLAGS": "-mod=mod"
  },
  "shell": {
    "init_hook": [
      "export TAILWIND=$(command -v tailwindcss)",
      "export TEMPL=$(command -v templ)",
      "echo \"devbox ready — go $(go env GOVERSION) · templ $(templ --version) · tailwind v4.3.0 · $(goose --version 2>&1)\""
    ],
    "scripts": {
      "web": "task run",
      "run": "task run",
      "dev": "task dev",
      "test": "task test",
      "migrate": "task db:migrate",
      "seed": "task db:seed"
    }
  }
}
